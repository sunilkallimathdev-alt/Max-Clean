                                                                            <td data-title="Price">
                                                                                <input type="text" value="@resproduct.Price" readonly="readonly" class="f_size_large color_dark" style="border-radius: 5px;" tabindex="-1" id="prd_@String.Format("{0}-{1}-{2}", resvalue.ServiceID.ToString(), rescat.CategoryID.ToString(), resproduct.ProductId.ToString())" />
                                                                            </td>
                                                                            <!--quanity-->
                                                                            <td data-title="Quantity">
                                                                                <div class="clearfix quantity r_corners d_inline_middle f_size_medium color_dark m_bottom_10" style="width:103px;">
