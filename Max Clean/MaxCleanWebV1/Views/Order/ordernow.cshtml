                                                                                    <button onclick="calculateprizeup(@resvalue.ServiceID.ToString(), @rescat.CategoryID.ToString(), @resproduct.ProductId.ToString())" class="bg_tr d_block f_left" data-direction="up">+</button>
                                                                                </div>

                                                                            </td>
                                                                            <!--subtotal-->
                                                                            <td data-title="Subtotal">
                                                                                <input type="text" id="sub_@String.Format("{0}-{1}-{2}", resvalue.ServiceID.ToString(), rescat.CategoryID.ToString(), resproduct.ProductId.ToString())" value="0" readonly="readonly" class="f_size_large fw_medium scheme_color subtotalid" />

                                                                            </td>

                                                                        </tr>
                                                                        <tr></tr>
                                                                    }

