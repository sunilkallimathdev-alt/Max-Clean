                    </section>
                </div>
            </div>
        </div>
        <hr class="divider_type_3 m_bottom_15">
        <a href="#" onclick="cubprize();"><span class="button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5 " style="float:right; ">Continue</span></a>

    </div>
</div>
