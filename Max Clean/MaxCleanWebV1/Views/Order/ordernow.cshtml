                                                                        string ids = @String.Format("{0}-{1}-{2}", resvalue.ServiceID.ToString(), rescat.CategoryID.ToString(), resproduct.ProductId.ToString());
                                                                        <tr>
                                                                            <!--Product name and image-->
                                                                            <td data-title="Product Image &amp; name" class="t_md_align_c">
                                                                                <a href="#" class="d_inline_b m_left_5 color_dark" id="PN_@resproduct.ProductId">@resproduct.ProductName </a>
                                                                            </td>
                                                                            <!--product key-->
