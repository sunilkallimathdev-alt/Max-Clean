@using API.Models;
@{
    ViewBag.Title = "MyOrders";
    Layout = "~/Views/Shared/WebMaster.cshtml";
    List<CustmoerOrders_Model> orders = (List<CustmoerOrders_Model>)ViewBag.Orders;
}

<div class="page_content_offset">
    <div class="container">
        <div class="row clearfix">
            <!--left content column-->
            <section class="col-lg-12 col-md-12 col-sm-12 m_xs_bottom_30">
                <div class="center-block" id="howitworks">
                    <h2><span>My Order</span> </span></h2>

                </div>
                <!--cart table-->
                <div class="table-responsive">
                    <table class="table_type_3  full_width r_corners wrapper shadow bg_light_color_1 m_bottom_30 t_align_l">
                        <thead>
                            <tr class="f_size_large" style="font-weight:bold;">
                                <!--titles for td-->

                                <th>Order Id</th>
                                <th>Order Date</th>
                                <th>Delivered Date</th>
                                <th>Status</th>

                                <th>Total</th>
                                <th>View Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (orders != null)
                            {
                                foreach (CustmoerOrders_Model data in orders)
                                {
                                    <tr>
                                        <td>
                                            <div class="">@data.OrderID</div>
                                        </td>
                                        <td>
                                            <div class="">  @data.ordereddate</div>
                                        </td>
                                        <td>
                                            <div class=""> @data.deliverydate</div>
                                        </td>
                                        <td>
                                            <div class="">
                                                @data.order_status
                                            </div>
                                        </td>

                                        <td class="">@data.total</td>
                                        <td>
                                            <div class="">
                                                <div class=""><a href="@Url.Action("OrderDetails", "Order", new { id = data.OrderID } )"><button name="submit" type="submit" class="button_type_4">View</button></a></div>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <!--tabs-->
            </section>
            <!--right column-->

        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {

        Update_Cart();
    });
</script>