    function GetCategoryProductsbyServiceID(ServiceID) {

        //var CategoryTabs = "";
        var ID = ServiceID;
        $.ajax({
            type: "get",
            url: "/Order/GetCategoryProductsByServiceID",
            data: { 'ServiceID': ServiceID },
            async: false,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                var myObject = data;
                if (tabcount == 0) {
                    CategoryTabs += "<div id='tab-" + ID + "' aria-labelledby='ui-id-" + ID + "' class='ui-tabs-panel ui-widget-content ui-corner-bottom' role='tabpanel' aria-expanded='false' aria-hidden='true' style='display:none;'>";
                } else {
                    CategoryTabs += "<div id='tab-" + ID + "' aria-labelledby='ui-id-" + ID + "' class='ui-tabs-panel ui-widget-content ui-corner-bottom' role='tabpanel' aria-expanded='true' aria-hidden='false' style='display:block;'>";
                }
                CategoryTabs += "<div class='accordion toggle'>";

                for (var c = 0; c < myObject.ObjectResult.length; c++) {
                    if (c == 0) {
                        CategoryTabs += "<div class='accordion_item r_corners shadow wrapper m_bottom_5 active'>";
                    } else {
                        CategoryTabs += "<div class='accordion_item r_corners shadow wrapper m_bottom_5'>";
                    }
                    CategoryTabs += "<h3 class='a_title relative tr_all_hover bg_light_color_1 color_dark  '>" + myObject.ObjectResult[c].CategoryName + "<span class='minus_icon tr_all_hover'>-</span><span class='plus_icon tr_all_hover'>+</span></h3>";
                    CategoryTabs += "<div class='bg_light_color_3 a_content' >";
                    CategoryTabs += "<div class='table-responsive'>";
                    CategoryTabs += "<table class='table_type_4  full_width r_corners wraper shadow t_align_l t_xs_align_c m_bottom_30'>";
                    CategoryTabs += "<thead>";
                    CategoryTabs += "<tr class='f_size_large' style='font-weight:bold;'>";

                    CategoryTabs += "<th>Product</th>";
                    CategoryTabs += "<th>Price</th>";
                    CategoryTabs += "<th>Quantity</th>";
                    CategoryTabs += "<th>Subtotal</th>";

                    CategoryTabs += "</tr>";
                    CategoryTabs += "</thead>";
                    CategoryTabs += "<tbody>";

                    for (var p = 0; p < myObject.ObjectResult[c].ProductList.length; p++) {
                        CategoryTabs += "<tr>";

                        CategoryTabs += "<td data-title='Product Image &amp; name' class='t_md_align_c'>" + myObject.ObjectResult[c].ProductList[p].ProductName + "</td>";



                        CategoryTabs += "<td data-title='Price'>";
                        CategoryTabs += "<p class='f_size_large color_dark'>" + myObject.ObjectResult[c].ProductList[p].Price + "</p>";
                        CategoryTabs += "</td>";

                        CategoryTabs += "<td data-title='Quantity'>";
                        CategoryTabs += "<div class='clearfix quantity r_corners d_inline_middle f_size_medium color_dark m_bottom_10' style='width:103px;'>";
                        CategoryTabs += "<button class='bg_tr d_block f_left' data-direction='down'>-</button>";
                        CategoryTabs += "<input type='text'  readonly value='0' class='f_left'/>";
                        CategoryTabs += "<button class='bg_tr d_block f_left' data-direction='up'>+</button>";
                        CategoryTabs += "</div>";

                        CategoryTabs += "</td>";

                        CategoryTabs += "<td data-title='Subtotal'>";
                        CategoryTabs += "<p class='f_size_large fw_medium scheme_color'>Rs 102.00</p>";
                        CategoryTabs += "</td>";

                        CategoryTabs += "</tr>";
                    }
                    CategoryTabs += "</tbody>";
                    CategoryTabs += "</table>";
                    CategoryTabs += "</div>";
                    CategoryTabs += "</div>";
                    CategoryTabs += "</div>";
                }

                    CategoryTabs += "</div>";
                    CategoryTabs += "</div>";


                //$("#cat_tab").html(CategoryTabs);

            },
            error: function (errMsg) {
                alert(JSON.stringify(errMsg));
            }
        });



    }
