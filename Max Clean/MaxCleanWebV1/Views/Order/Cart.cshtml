        //$("#promo_div").hide();
        //$("#rewrd_div").hide();
        $('#checkbox_rwds').change(function () {
            Apply_Rewards();
        });

        $('#checkbox_promo').change(function () {
            Apply_Promocode();
        });
        $('#Check_Express_Delivery').change(function () {
            Calculate_Express_del();
        });
        Cal_GrandTotal();
    });

    function BindProducts() {

        var Cart_Products = JSON.parse(localStorage.getItem("Order_Object"));
        Products = "";
        var CartTotal = 0;
        for (var p = 0; p < Cart_Products.length; p++) {
            Products += "<tr>";

            Products += "<td data-title='SKU'>"+(p+1)+"</td>";
            Products += "<td data-title='Product Image &amp; name' class='t_md_align_c'>";
            Products += "<a href='#' class='d_inline_b m_left_5 color_dark' id='ui-id-" + Cart_Products[p].ServiceID+"'>" + Cart_Products[p].ServiceName+"</a>";
            Products += "</td>";
            Products += "<td data-title='SKU' id='CN_" + Cart_Products[p].CategoryID+"'>" + Cart_Products[p].CategoryName + "</td>";
            Products += "<td data-title='SKU' id='PN_"+ Cart_Products[p].ProductID+"'>" + Cart_Products[p].ProductName +"</td>";

            Products += "<td data-title='Price'>";
           // Products += "<p class='f_size_large color_dark' id='prd_" + Cart_Products[p].ServiceID + "-" + Cart_Products[p].CategoryID + "-" + Cart_Products[p].ProductID+"'>" + Cart_Products[p].UnitPrice +"</p>";
            Products += "<input type='number' value='" + Cart_Products[p].UnitPrice + "' readonly='readonly'  class='f_size_large r_corners color_dark' tabindex='-1' id='prd_" + Cart_Products[p].ServiceID + "-" + Cart_Products[p].CategoryID + "-" + Cart_Products[p].ProductID +"' style='width:150px;'/>";
            Products += "</td>";

            Products += "<td data-title='Quantity'>";
            Products += "<div class='clearfix quantity r_corners d_inline_middle f_size_medium color_dark m_bottom_10' style='width:103px;'>";
            Products += "<button onclick='calculateprizedown(" + Cart_Products[p].ServiceID + "," + Cart_Products[p].CategoryID + "," + Cart_Products[p].ProductID +")' class='bg_tr d_block f_left' data-direction='down'>-</button>";
            Products += "<input type='text' name='' readonly='' id='qty_" + Cart_Products[p].ServiceID + "-" + Cart_Products[p].CategoryID + "-" + Cart_Products[p].ProductID + "' value='" + Cart_Products[p].Quantity +"' class='f_left r_corners'>";
            Products += "<button onclick='calculateprizeup("+Cart_Products[p].ServiceID + "," + Cart_Products[p].CategoryID + "," + Cart_Products[p].ProductID+")' class='bg_tr d_block f_left' data-direction='up'>+</button>";
            Products += "</div>";

            Products += "</td>";

            Products += "<td data-title='Subtotal'>";
            //Products += "<p class='f_size_large color_dark' id='sub_" + Cart_Products[p].ServiceID + "-" + Cart_Products[p].CategoryID + "-" + Cart_Products[p].ProductID +"' >" + Cart_Products[p].Price +"</p>";
            Products += "<input type='text' id='sub_" + Cart_Products[p].ServiceID + "-" + Cart_Products[p].CategoryID + "-" + Cart_Products[p].ProductID + "' value='" + Cart_Products[p].Price + "' readonly='readonly' class='subtotalid f_size_large r_corners fw_medium scheme_color'style='width:150px;' />";
            Products += "</td>";
            Products += "<td data-title='Subtotal'>";
            Products += "<a href='#' onclick='Remove(" + Cart_Products[p].ServiceID + "," + Cart_Products[p].ProductID+")' class='color_dark' ><i class='fa fa-times f_size_medium m_right_5'></i>Remove</a><br>";
            Products += "</td>";
            Products += "</tr>";
            CartTotal += Cart_Products[p].Price;
        }


        Products += "<tr>";
        Products += "<td colspan='7'>";
        Products += "<p class='fw_medium f_size_large t_align_r t_xs_align_c' style='float:right;'>	Previous Balance :</p> </br>";
        Products += "<p class='fw_medium f_size_large t_align_r t_xs_align_c' style='float:right;'> Cart Total :</p></br>";
        Products += "<p class='fw_medium f_size_large t_align_r t_xs_align_c' style='float:right;'> Delivery Charge :</p>";
        Products += "</td>";

        Products += "<td colspan='1'>";
        Products += "<p class='fw_medium f_size_large color_dark' style='text-align:right;'>" + Previous_Balance + "</p>";
        Products += "<p class='fw_medium f_size_large color_dark' id='cart_total' style='text-align:right;'>" + CartTotal + "</p>";
        Products += "<p class='fw_medium f_size_large color_dark' id='Delivery_Charge' style='text-align:right;'>0</p>";
        Products += "</td>";

        Products += "</tr>";


        Products += "<tr>";
        Products += "<td colspan='6'>";
        Products += "<span style='float:right;'>";
        Products += "<input type='checkbox'  class='d_none' name='Check_Express_Delivery' id='Check_Express_Delivery'>";
        Products += "<label for='Check_Express_Delivery'>Express Delivery</label>";
        Products += "</span>";
        Products += "</td>";
        Products += "<td colspan='1'>";
        Products += "<p class='fw_medium f_size_large t_align_r t_xs_align_c' style='float:right;'>Express Delivery Charge :</p>";
        Products += "</td>";
        Products += "<td colspan='1'>";
        Products += "<p class='fw_medium f_size_large color_dark' id='Express_Delivery_Charge' style='text-align:right;'>0</p>";
        Products += "</td>";

        Products += "</tr>";

        Products += "<tr>";

        Products += "<td colspan='4'>";
       // Products += "<p class='fw_medium f_size_large  t_xs_align_c ' style='float:right;'>";

        Products += "<span id='checkbox_rewards_div'>";
        Products += "<input type='checkbox'  class='d_none' name='checkbox_rwds' id='checkbox_rwds'>";
        Products += "<label for='checkbox_rwds'>Use Rewards Points <b id='cust_rwds'>" + Cust_Rewards + "</b> &nbsp;&nbsp;</label>";
        Products += "</span>";

        Products += "<span id='checkbox_promo_div'>";
        Products += "<input type='checkbox'  class='d_none' name='checkbox_promo' id='checkbox_promo'>";
        Products += "<label for='checkbox_promo'> Promo Code</label>";
        Products += "</span>";

       // Products += "</p>";
        Products += "</td>";

        Products += "<td colspan='1'>";
        Products += "<div id='promo_div'>";
        Products += "<input type='text' placeholder='Enter Promo code' name='' id='txt_Promocode' style='text- transform:uppercase;width:150px;'  class='r_corners f_size_medium'><p style='color:blue;cursor:pointer;' onclick='Validate_Promocode();' >Apply</p>";
        Products += "</div>";
        Products += "<div id='rewrd_div'>";
        Products += "<input type='text' name='' class='r_corners f_size_medium' id='Reward_Applied' style='width:150px;'  readonly><p style='color: green'>Rewards Applied</p>";
        Products += "</div>";
        Products += "</td>";

        Products += "<td colspan='2'>";
        Products += "<p  class='fw_medium f_size_large t_align_r t_xs_align_c' style='float:right;'>Discount Applied</p>";
        Products += "</td>";

        Products += "<td colspan='1'>";
       // Products += "<form class='d_ib_offset_0 d_inline_middle half_column d_xs_block w_xs_full m_xs_bottom_5'>";
        Products += "<input type='text' readonly class='r_corners f_size_medium' style='text-align:right;' id='Discount_Applied' value='0'>";
       // Products += "</form>";
        Products += "</td>";

        Products += "</tr>";

        Products += "<tr>";
        Products += "<td colspan='7'>";
        Products += "<p class='fw_medium f_size_large t_align_r t_xs_align_c' style='float:right;'>Total:</p>";
        Products += "</td>";
        Products += "<td colspan='1'>";
        Products += "<p class='fw_medium f_size_large color_dark' style='text-align:right;' id='Grand_total'></p>";
        Products += "</td>";
        Products += "</tr>";
        $("#tbody").html(Products);
        var isexp = localStorage.getItem("Isexp");
        if (isexp == "1") {
            $('#Check_Express_Delivery').prop('checked', true);
            Calculate_Express_del();
        }
        if (CartTotal < 500) {
            $("#checkbox_promo_div").hide();
            $("#promo_div").hide();
            $('#checkbox_promo').prop('checked', false);
        }
        if (Cust_Rewards < 100 || Cart_Products.length<1) {
            $("#checkbox_rewards_div").hide();
            $("#rewrd_div").hide();
            $('#checkbox_rwds').prop('checked', false);
        }
        cart__total = CartTotal;
    }

    function show_mobilemodal() {
        $("#myModal_mobile").modal({
            backdrop: "static", //remove ability to close modal with click
            keyboard: false, //remove option to close with keyboard
            show: true //Display loader!
        });
    }
    function Verify_mobile() {
        $("#btnclose").click();
          $.post("@Url.Action("verify_mobile", "Order")", { mobile: $("#mobile").val() }, function (data) {


              var reg_cust = JSON.parse(data);
              if (reg_cust.CustomerID != 0) {
                  var myobj = JSON.parse(data);
                var objcust = new Object();
                objcust.CustomerName = myobj.CustomerName;
                objcust.MobileNumber = myobj.MobileNumber;
                objcust.Address = myobj.Address;
                objcust.EmailID = myobj.EmailID;
                objcust.Pincode = myobj.Pincode;
                localStorage.setItem("objcust", JSON.stringify(objcust));
                continue_Order();
            }
            else {
                  sendOTP_Now($("#mobile").val());
                $("#myModal").modal({
                    backdrop: "static", //remove ability to close modal with click
                    keyboard: false, //remove option to close with keyboard
                    show: true //Display loader!
                });
               // alert("Something Went Wrong. Please retry.");
            }



        });
    }

    function continue_Order() {

        var sids = $(".subtotalid");
        var idvalues = [];
        data = [];
        for (var i = 0; i < sids.length; i++) {
            if ($(sids[i]).val() != '0') {
                idvalues.push($(sids[i]).attr('id'));

            }
        }
        for (var c = 0; c < idvalues.length; c++) {

            var ID = idvalues[c].split("_")[1];
            var srcid = ID.split("-")[0];
            var catid = ID.split("-")[1];
            var prdid = ID.split("-")[2];

            var myobj = new Object();
            myobj.ServiceID = parseInt(srcid);
            myobj.ServiceName = $("#ui-id-" + srcid).html();
            myobj.CategoryID = parseInt(catid);
            myobj.CategoryName = $("#CN_" + catid).html();
            myobj.ProductID = parseInt(prdid);
            myobj.ProductName = $("#PN_" + prdid).html();
            myobj.UnitPrice = parseInt($("#prd_" + srcid + "-" + catid + "-" + prdid).val());
            myobj.Quantity = parseInt($("#qty_" + srcid + "-" + catid + "-" + prdid).val());
            myobj.Price = parseInt($("#sub_" + srcid + "-" + catid + "-" + prdid).val());
            data.push(myobj);

            //    }

            //}

            //for (var d = 0; d < data.length; d++) {
            //    Cart_Products.push(d);
            //}

        }
        var myobj = new Object();
        myobj.CustomerName = null;
        myobj.CustomerMobile = null;
        myobj.CustomerEmail = null;
        myobj.PickupAddress = null;
        myobj.PickupDate = null;
        myobj.ConfirmedBy = null;
        myobj.Pickedby = null;
        myobj.DeliveryAddress = null;
        myobj.ActualDeliveryDate = null;
        myobj.PickupTime = null;
        myobj.DeliveryTime = null;
        myobj.StoreID = null;
        myobj.orderstatusID = 2;
        myobj.PaidAmount = null;
        myobj.Remark = null;
        myobj.PaymentType = null;
        myobj.Invoice_No = null;
        myobj.Pincode = 0;
        myobj.GrandTotal = parseInt($("#Grand_total").html());
        myobj.RemainingAmount = null;
        myobj.OldBalanceApplied = Previous_Balance;
        myobj.IsOutletOrder = false;
        if ($("#checkbox_rwds").prop('checked') == true) {
            myobj.IsReward = true;
            myobj.RewardPointsApplied = $("#Discount_Applied").val();
        } else {
            myobj.IsReward = false;
            myobj.RewardPointsApplied = 0;
        }
        if ($("#checkbox_promo").prop('checked') == true) {
            myobj.IsPromocodeApplied = true;
            myobj.Promocode = $('#txt_Promocode').val();
            myobj.Promocode_Amount = $("#Discount_Applied").val();
        } else {
            myobj.IsPromocodeApplied = false;
            myobj.Promocode = null;
            myobj.Promocode_Amount = 0;
        }
        if ($("#Check_Express_Delivery").prop('checked') == true) {
            myobj.IsExpressDelivery = true;
            myobj.ExpressChargeApplied = parseInt($("#Express_Delivery_Charge").html());
        }
        else {
            myobj.IsExpressDelivery = false;
            myobj.ExpressChargeApplied = 0;
        }


        myobj.Delivery_charge = parseInt($("#Delivery_Charge").html());
        var Details = [];


        myobj.PurchaseOrderDetail = data;
        localStorage.setItem("Full_Order", JSON.stringify(myobj));
        window.location.href = '/Order/Address';
    }

    function Apply_Rewards() {
        var applied_rewards = 0;
        if ($("#checkbox_rwds").prop('checked') == true) {
            $("#promo_div").hide();
            $("#rewrd_div").show();
            $('#checkbox_promo').prop('checked', false);

            if (Cust_Rewards < 100) {
                alert("Cannot redeem Reward Points");
                $("#Reward_Applied").val(applied_rewards);
            } else {
                var cart_total = parseInt($("#cart_total").html());
                if (cart_total > 499) {
                    applied_rewards = 100;
                } else {
                    applied_rewards = 50;
                }
                $("#Reward_Applied").val(applied_rewards);
            }
            $("#Discount_Applied").val(applied_rewards);


            Cal_GrandTotal();
        } else {
           // $("#promo_div").show();
            $("#Discount_Applied").val(0);
            $("#rewrd_div").hide();
            $("#Reward_Applied").val(0);
            $('#checkbox_rwds').prop('checked', false);
            Cal_GrandTotal();
        }

    }

    function Calculate_Express_del() {
        var EXP_Del = 0
        if ($("#Check_Express_Delivery").prop('checked') == true) {
            var sids = $(".subtotalid");
            var idvalues = [];
            CartTotal = 0
            for (var i = 0; i < sids.length; i++) {
                if ($(sids[i]).val() != '0') {
                    idvalues.push($(sids[i]).attr('id'));

                }
            }
            for (var c = 0; c < idvalues.length; c++) {

                var ID = idvalues[c].split("_")[1];
                CartTotal += parseInt($("#sub_" + ID).val());
            }

            EXP_Del = (50 / 100) * CartTotal;
            localStorage.setItem("Isexp", "1");
        } else {
            localStorage.setItem("Isexp", "0");
            EXP_Del = 0;
        }
        $("#Express_Delivery_Charge").html(EXP_Del);
        Cal_GrandTotal();
    }

    function Apply_Promocode() {

        if ($("#checkbox_promo").prop('checked') == true) {
      
            $("#promo_div").show();
            $("#rewrd_div").hide();
            $("#Reward_Applied").val(0);
            $('#checkbox_rwds').prop('checked', false);
            $("#Discount_Applied").val(0);
            Cal_GrandTotal();
        } else {
            $("#promo_div").hide();
            $("#Discount_Applied").val(0);
            //$("#rewrd_div").show();
            $('#checkbox_promo').prop('checked', false);
            Cal_GrandTotal();
        }

    }

    function calculateprizedown(id1, id2, id3) {
        productid = "";
        productid += id1 + "-" + id2 + "-" + id3;
        if (parseInt($('#qty_' + productid).val()) > 0) {
            var qty = parseInt($('#qty_' + productid).val()) - 1;
            if (qty == -1 || qty == 0) {
                qty = 0;
                $('#qty_' + productid).val('0');
            }
            var unitprize = parseInt($('#prd_' + productid).val());
            var result = qty * unitprize;
            $('#sub_' + productid).val(result);

            Cal_CartTotal();


            var sids = $(".subtotalid");
            var idvalues = [];
            data = [];
            for (var i = 0; i < sids.length; i++) {
                if ($(sids[i]).val() != '0') {
                    idvalues.push($(sids[i]).attr('id'));

                }
            }
