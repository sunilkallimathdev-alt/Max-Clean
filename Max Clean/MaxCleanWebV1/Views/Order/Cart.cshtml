            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                <a href="#" onclick="continue_Order()()"><span class="button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5" style="float: right;">Confirm Order<i class="fa fa-angle-right"></i></span></a>
            </div>

        </div>
        <div class="row clearfix d_none d_xs_block">
            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 ">
