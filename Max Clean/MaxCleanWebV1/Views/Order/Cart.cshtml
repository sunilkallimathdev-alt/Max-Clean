                    </table>

                </div>
                <!--tabs-->
            </section>
            <!--right column-->

        </div>
        <div class="row clearfix d_xs_none">
            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 ">
                <a href="/order/ordernow"><span class="button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5" style="float: left;"><i class="fa fa-angle-left"></i>Continue adding</span></a>

            </div>
