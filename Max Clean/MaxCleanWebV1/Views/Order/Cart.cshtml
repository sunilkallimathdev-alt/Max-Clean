             }, 5);
     $(document).ready(function () {
            //if (Islogin != true) {
            //    alert("Please Login");
            //    window.location.href = '/MaxClean/Home';
                 //}

         BindProducts();
         $("#promo_div").hide();
         $("#rewrd_div").hide();
