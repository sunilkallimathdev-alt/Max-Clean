    function Cal_CartTotal() {

        var sids = $(".subtotalid");
        var idvalues = [];
         CartTotal = 0
        for (var i = 0; i < sids.length; i++) {
            if ($(sids[i]).val() != '0') {
                idvalues.push($(sids[i]).attr('id'));

            }
        }
        for (var c = 0; c < idvalues.length; c++) {

            var ID = idvalues[c].split("_")[1];
            CartTotal += parseInt($("#sub_" + ID).val());
        }

        $("#cart_total").html(CartTotal)
        if (CartTotal < 500) {
            $("#checkbox_promo_div").hide();
        } else {
            $("#checkbox_promo_div").show();
        }


    }

    function Cal_GrandTotal() {

        var sids = $(".subtotalid");
        var idvalues = [];
        CartTotal = 0;
        var Grand_Total = 0;
        for (var i = 0; i < sids.length; i++) {
            if ($(sids[i]).val() != '0') {
                idvalues.push($(sids[i]).attr('id'));

            }
        }
        for (var c = 0; c < idvalues.length; c++) {

            var ID = idvalues[c].split("_")[1];
            CartTotal += parseInt($("#sub_" + ID).val());
        }
        Grand_Total += CartTotal;
        Grand_Total += Previous_Balance;
        var Exp_del = parseInt($("#Express_Delivery_Charge").html());
        if (Exp_del > 0 && Exp_del != null) {
            Grand_Total += Exp_del;
        }
        Grand_Total -= $("#Discount_Applied").val();

        if (Grand_Total < 350) {
            $("#Delivery_Charge").html("50");
        } else {
            $("#Delivery_Charge").html("0");
        }



        Grand_Total += parseInt($("#Delivery_Charge").html());


        $("#Grand_total").html(Grand_Total);
       // update_local();
        Update_Cart();
    }

    function Validate_Promocode() {
        var Obj = new Object();
        Obj.Promocode_Name = $('#txt_Promocode').val();
        $.post("@Url.Action("ValidatePromocode", "Order")", { ObjPromocode: JSON.stringify(Obj) }, function (data) {
            var myobj = JSON.parse(data);
            if (myobj.StatusCode == 200) {

                var Discount_percent = myobj.ObjectResult.Discount || 0
                var Cart_total = parseInt($("#cart_total").html());
                $("#Discount_Applied").val(Math.floor((Discount_percent / 100) * Cart_total));
                Cal_GrandTotal();
            } else {
                $("#Discount_Applied").val(0);
                Cal_GrandTotal();
                alert("Invalid Promocode")
            }
        });
    }

    function sendOTP_Now(Mobile) {




            var data = {
                'Mobile': Mobile
            };

            var parameters = JSON.stringify(data);
            //disable sending message for dev purpose
            $.ajax({
                type: "POST",
                url: '/MaxClean/SendOTP',
                data: parameters,
                async: false,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    if (response.StatusCode == 200) {
                        if (response != null) {
                            if (response.ObjectResult > 1) {
                                //var OTP = prompt("Please enter OTP you just recieved on your mobile number.", "Enter OTP");
                                AssignedOTP = response.ObjectResult;
                                console.log("Successfully sent OTP to the number.");
                                //VerifysendOTP();
                                //alert("Thank you, your mobile number is now verified.");

                                //Open the OTP entry model
                                $("#myModal").modal({
                                    backdrop: "static", //remove ability to close modal with click
                                    keyboard: false, //remove option to close with keyboard
                                    show: true //Display loader!
                                });

                            } else if (response.ObjectResult == -1) {
                                alert("This number already exists. Please try another number or login using the same.");
                                return false;
                            }
                        } else {
                            alert("There was an error while sending an OTP. Please try again later.");
                        }
                    } else if (response.StatusCode == 400) {
                        alert("This number already exists. Please try another number or login using the same.");

                        return false;
                    }

                },
                error: function (e) {
                    console.log(JSON.stringify(e));
                    alert("Something went wrong. Please try again later.");
                    return false;
                }
            });

    }

