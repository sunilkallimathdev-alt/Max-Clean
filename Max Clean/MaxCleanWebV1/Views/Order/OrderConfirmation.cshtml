
@{
    ViewBag.Title = "OrderConfirmation";
    Layout = "~/Views/Shared/WebMaster.cshtml";
}

<div class="page_content_offset">
    <div class="container">
        <div class="row clearfix">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                <!--left content column-->
                <div class="center-block" id="howitworks">
                    <h2>Order Placed <span style="color:#ffd923;">Successfully</span></h2>

                </div>
                <div class="alert_box r_corners color_green success m_bottom_10" style="text-align:center;">
                    <i class="fa fa-smile-o"></i><br /><br />
                    <h2>Thank you! We have recieved your order. </h2><br />
                    <p>Your Order ID is @ViewBag.InvoiceNumber, Invoice detail sent to your email ID, The grand total is inclusive of customer rewards,express & delivery charges if any.</p>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                    <a href="/maxclean/home"><span class="button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5 shrt2 ">Continue to homepage</span></a>
                </div>

                <!--right column-->
            </div>
        </div>
    </div>
</div>

