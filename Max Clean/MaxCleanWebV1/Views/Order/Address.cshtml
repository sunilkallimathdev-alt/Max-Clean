    function validate_Email(email) {
        //var emailReg = /^([\w-\.]+@@([\w-]+\.)+[\w-]{2,4})?$/;
        //    return emailReg.test(String(email).toLowerCase());
        var pattern = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
        if (pattern.test(email))
            return true;
        else
            return false;
    }
    function validation() {
        VerifyPincode()
        var name = $("#P_Name").val();
        var mobile = $("#P_Mobile").val();
        var email = $("#P_Email").val();
        var pincode = $("#P_Pincode").val();
        var address = $("#P_Address").val();
        var date = $("#PickupDate").val();
        var ActualDeliveryDate = $("#ActualDeliveryDate").val();
        if (name == '') {
            alert("Name cannot be empty");
            return false;
        }
        else if (mobile == '' || mobile == null) {
            alert("mobilenumber cannot be empty");
            return false;
        }
        else if (mobile.length < 10 || mobile.length > 10) {
            alert("Mobile No. is not valid, Please Enter 10 Digit Mobile No.");
            return false;
        }
        else if (email == '' || email == null) {
            alert("Email-Id cannot be empty");
            return false;
        }
        else if (!validate_Email(email)) {
            alert("Email id is not valid");
            return false;
        }
        else if (pincode == '') {
            alert("Pincode cannot be empty");
            return false;
        }
        else if (pincode.length != 6) {
            alert("Pincode. is not valid, Please Enter 6 Digit Pincode");
            return false;
        }
        else if (pin_found != true) {
            return false;
        }
        else if (address == '') {
            alert("address cannot be empty");
            return false;
        }
        else if (date == '') {
            alert("Pickup date cannot be empty");
            return false;
        }
        else if (ActualDeliveryDate == '') {
            alert("Delivery Date  cannot be empty");
            return false;
        } else {
            Confirm_order();
        }
    }

    function Confirm_order() {
        if (Isexist == "0") {
