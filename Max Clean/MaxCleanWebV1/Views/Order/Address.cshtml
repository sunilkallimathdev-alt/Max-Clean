            if ((hour + 1) == 25) {
                hour = 0;
            }
            var time_string = "";
            time_string += (hour+1) + ":" + minutes;
            $("#PickUPTime").val(time_string);
        }
        localStorage.setItem("Full_Order", order);

        $("#P_Name").val(CustomerName);
        $("#P_Mobile").val(MobileNumber);
        $("#P_Email").val(EmailID);
        $("#P_Address").val(Address);
        $("#P_Pincode").val(Pincode);

        $("#D_Name").val(CustomerName);
        $("#D_Mobile").val(MobileNumber);
        $("#D_Email").val(EmailID);
        $("#D_Address").val(Address);
        $("#D_Pincode").val(Pincode);
