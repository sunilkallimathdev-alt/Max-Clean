                alert("Please enter pickup Address")
            }
            else {

                var Order = JSON.parse(localStorage.getItem("Full_Order"));
                Order.CustomerName = $("#P_Name").val();
                Order.CustomerMobile = $("#P_Mobile").val();
                Order.CustomerEmail = $("#P_Email").val();
                Order.PickupAddress = $("#P_Address").val();
                Order.PickupDate = $("#PickupDate").val();
                Order.PickupTime = $("#PickUPTime").val();
                Order.DeliveryAddress = $("#D_Address").val();
                Order.ActualDeliveryDate = $("#ActualDeliveryDate").val();
                Order.Pincode = $("#P_Pincode").val();
                Order.StoreID = 1;

                Order.Remark = $("#Remark").val();

                $.post("@Url.Action("Place_order", "Order")", { ObjOrder: JSON.stringify(Order) }, function (data) {

                    var myobj = JSON.parse(data);
                    if (myobj.StatusCode == 200) {

                        //alert("Order Placed");
                        localStorage.removeItem("Full_Order");
                        localStorage.removeItem("Order_Object");
                        //window.location.href = "/Maxclean/home";
                        var orderidvalue = myobj.Result;
                        localStorage.clear();
                        window.location.href = "/Order/OrderConfirmation/" + orderidvalue;
                        //windowlocation.href = "@*@Url.Action("OrderConfirmation", "order", new { id = "orderid" }).replace("orderid",orderidvalue)*@;
                    }
                    else {
                        alert("Something Went Wrong. Please retry.");
                    }

                });
            }
        }

    }
