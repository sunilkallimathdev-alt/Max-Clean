    function VerifyPincode() {

        var date = $("#P_Pincode").val();
        var found = false;
        var servingpincode = "";
        //  var parameters = JSON.stringify(data);
        //disable sending message for dev purpose
        $.ajax({
            type: "POST",
            url: '/MaxClean/verifyPincode',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: false,
            success: function (response) {

                var pincodelist = (response);

                if (pincodelist.StatusCode == 200) {
                    for (var p = 0; p < pincodelist.ObjectResult.length; p++) {
                        if (parseInt(date) == pincodelist.ObjectResult[p].Pincode) {

                            pin_found = true;
                        }
                        else { servingpincode += pincodelist.ObjectResult[p].Pincode + " , "; }
                    }
                }
                if (pin_found) {
                    //$('#returnmsg').html('Sorry..! We are not serving ')
                   // window.location.href = "/order/ordernow";
                    //  alert('Thanks for entering the pincode')
                    localStorage.setItem("IsValidPincode", true);
                    return true
                } else {
                    localStorage.setItem("IsValidPincode", false);
                    alert('Thank you for your interest in us, we"ll notify once we extend our service to your location. Currently we serve :' + servingpincode);
                    //$('#returnmsg').html('Thank you for your interest in us, we"ll notify once we extend our service to your location. Currently we serve :' + servingpincode);
                    return false;
                }
            },
            error: function (e) {
                console.log(JSON.stringify(e));
                alert("Something went wrong. Please try again later.");
                return false;
            }
        });
    }


