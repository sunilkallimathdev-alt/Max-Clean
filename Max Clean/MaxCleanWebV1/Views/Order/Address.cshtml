<script>
    function verify_time() {
        var dtToday = new Date();

        var current_hour = dtToday.getHours();

        var time_ = $("#PickUPTime").val();
        var hour = parseInt(time_.split(':')[0]);
        var minutes = parseInt(time_.split(':')[1]);
        if (hour > 19) {
            alert("Pickup Time cutoff is 7:30 PM");
            SetTime("PickUPTime");
            var time_ = $("#PickUPTime").val();
            var hour = parseInt(time_.split(':')[0]);
            var minutes = parseInt(time_.split(':')[1]);
            if (hour > 19 && minutes > 29) {
                SettomorrowDate("PickupDate");
                $("#PickUPTime").val("08:00");
            } else {
                if ((hour + 1) == 25) {
                    hour = 0;
                }
                var time_string = "";
                time_string += (hour + 1) + ":" + minutes;
                $("#PickUPTime").val(time_string);
            }
        } else {
            if (hour > 19 && minutes > 29) {
                SettomorrowDate("PickupDate");
                $("#PickUPTime").val("08:00");
            } else {
                if (hour > (current_hour + 1)) {

                } else {
                    if ((hour + 1) == 25) {
                        hour = 0;
                    }
                    var time_string = "";
                    time_string += (hour + 1) + ":" + minutes;
                    $("#PickUPTime").val(time_string);
                }
            }
        }
    }
    function set_deliveryDate() {

        var pickup_date = $("#PickupDate").val();
        var dtToday = new Date(pickup_date);
        var n = 4;
        var full_rde = localStorage.getItem("Full_Order");
        if (full_rde != null) {
            var exist = JSON.parse(localStorage.getItem("Full_Order"));
            if (exist != null) {
                if (exist.IsExpressDelivery == true) {
                    n = 1;
                } else {
                    n = 4;
                }
            }
        } else {
            n = 4; //number of days to add.
        }
        var requiredDate = new Date(dtToday.getFullYear(), dtToday.getMonth(), dtToday.getDate() + n);
        var month = requiredDate.getMonth() + 1;
        var day = requiredDate.getDate();
        var year = requiredDate.getFullYear();
        if (month < 10)
            month = '0' + month.toString();
        if (day < 10)
            day = '0' + day.toString();
        var hour = requiredDate.getHours();
        var min = requiredDate.getMinutes();
        var ss = requiredDate.getSeconds();
        if (hour < 10)
            hour = '0' + hour.toString();
        if (min < 10)
            min = '0' + min.toString();
        if (ss < 10)
            ss = '0' + ss.toString();
        var Today = year + '-' + month + '-' + day;
        $('[name="ActualDeliveryDate"]').val(Today);

    }
    function BlockPreviousDate(FieldID) {
        var dtToday = new Date();
        var month = dtToday.getMonth() + 1;
        var day = dtToday.getDate();
        var year = dtToday.getFullYear();
        if (month < 10)
            month = '0' + month.toString();
        if (day < 10)
            day = '0' + day.toString();
        var maxDate = year + '-' + month + '-' + day;
        $('[name="' + FieldID + '"]').attr('min', maxDate);
    }
    function SetTodaysDate(FieldID) {
        var dtToday = new Date();
        var month = dtToday.getMonth() + 1;
        var day = dtToday.getDate();
        var year = dtToday.getFullYear();
        if (month < 10)
            month = '0' + month.toString();
        if (day < 10)
            day = '0' + day.toString();
        var hour = dtToday.getHours();
        var min = dtToday.getMinutes();
        var ss = dtToday.getSeconds();
        if (hour < 10)
            hour = '0' + hour.toString();
        if (min < 10)
            min = '0' + min.toString();
        if (ss < 10)
            ss = '0' + ss.toString();
        //var Today = year + '-' + month + '-' + day + "T" + hour + ":" + min + ":" + ss;
        var Today = year + '-' + month + '-' + day;
        $('[name="' + FieldID + '"]').val(Today);
    }
    function SetDeliveryDate(FieldID) {
        var dtToday = new Date();
        var n = 4;
        var full_rde = localStorage.getItem("Full_Order");
        if (full_rde != null) {
            var exist = JSON.parse(localStorage.getItem("Full_Order"));
            if (exist != null) {
                if (exist.IsExpressDelivery == true) {
                    n = 1;
                } else {
                    n = 4;
                }
            }
        } else {
            n = 4; //number of days to add.
        }
        var requiredDate = new Date(dtToday.getFullYear(), dtToday.getMonth(), dtToday.getDate() + n);
        var month = requiredDate.getMonth() + 1;
        var day = requiredDate.getDate();
        var year = requiredDate.getFullYear();
        if (month < 10)
            month = '0' + month.toString();
        if (day < 10)
            day = '0' + day.toString();
        var hour = requiredDate.getHours();
        var min = requiredDate.getMinutes();
        var ss = requiredDate.getSeconds();
        if (hour < 10)
            hour = '0' + hour.toString();
        if (min < 10)
            min = '0' + min.toString();
        if (ss < 10)
            ss = '0' + ss.toString();
        var Today = year + '-' + month + '-' + day;
        $('[name="' + FieldID + '"]').val(Today);
    }
    function SettomorrowDate(FieldID) {
        var dtToday = new Date();
        var n = 1;

        var requiredDate = new Date(dtToday.getFullYear(), dtToday.getMonth(), dtToday.getDate() + n);
        var month = requiredDate.getMonth() + 1;
        var day = requiredDate.getDate();
        var year = requiredDate.getFullYear();
        if (month < 10)
            month = '0' + month.toString();
        if (day < 10)
            day = '0' + day.toString();
        var hour = requiredDate.getHours();
        var min = requiredDate.getMinutes();
        var ss = requiredDate.getSeconds();
        if (hour < 10)
            hour = '0' + hour.toString();
        if (min < 10)
            min = '0' + min.toString();
        if (ss < 10)
            ss = '0' + ss.toString();
        var Today = year + '-' + month + '-' + day;
        $('[name="' + FieldID + '"]').val(Today);
    }
    function SetTime(FieldID) {
        var dtToday = new Date();

        var hour = dtToday.getHours();
        var min = dtToday.getMinutes();
        var ss = dtToday.getSeconds();
        if (hour < 10)
            hour = '0' + hour.toString();
        if (min < 10)
            min = '0' + min.toString();
        if (ss < 10)
            ss = '0' + ss.toString();
        var Today = hour + ":" + min;
        //var Today = year + '-' + month + '-' + day;
        $('[name="' + FieldID + '"]').val(Today);
    }
</script>
