<script type="text/javascript">
    $(document).ready(function () {

        Update_Cart();
    });


    function Update_Cart() {

            // if ((window.location.pathname).toLowerCase() == "/order/cart")
            // update_local();
            var Cart_Pducts = [];
            var ttal = 0
            var Products_Exist = localStorage.getItem("Order_Object");
            if (Products_Exist != null)
                Cart_Pducts = JSON.parse(localStorage.getItem("Order_Object"));
            var _Products = "";

            _Products += "<div class='f_size_medium sc_header'>Recently added item(s)</div>";
            _Products += "<ul class='products_list' style='height:200px; overflow-y:scroll;' >";
            for (var p = 0; p < Cart_Pducts.length; p++) {


                _Products += "<li>";
                _Products += "<div class='clearfix'>";
                _Products += "<div class='f_left product_description'>";
                _Products += "<a href='#' class='color_dark d_block'>" + Cart_Pducts[p].CategoryName + " / " + Cart_Pducts[p].ProductName + "</a>";
                _Products += "<a href='#' class='color_dark d_block'>" + Cart_Pducts[p].ServiceName + "</a>";
                _Products += "</div>";
                _Products += "<div class='f_left f_size_medium'>";
                _Products += "<div class='clearfix'>";
                _Products += Cart_Pducts[p].Quantity + " x <b class='color_dark'>" + Cart_Pducts[p].UnitPrice + "</b>";
                _Products += "</div>";

                _Products += "</div>";
                _Products += "</div>";
                _Products += "</li>";

                ttal += Cart_Pducts[p].Price;


            }
            _Products += "</ul>";
            _Products += "<ul class='total_price bg_light_color_1 t_align_r color_dark'>";
            _Products += "<li>Total: <b class='f_size_large bold scheme_color sc_price t_align_l d_inline_b m_left_15'>" + ttal + "</b></li>";
            _Products += "</ul>";
            _Products += "<div class='sc_footer t_align_c'>";
            _Products += "<a href='/Order/Cart' role='button' class='button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5'>View Cart</a>";
            _Products += "<a href='/Order/Address' role='button' class='button_type_4 bg_scheme_color d_inline_middle r_corners tr_all_hover color_light'>Checkout</a>";
            _Products += "</div>";
            if (Cart_Pducts.length < 1) {
                _Products += "<div class='sc_footer t_align_c'>";
                _Products += "<p>No Items In Cart</p>";
                _Products += "</div>";
            }

            $("#Carts_prds").html(_Products);
            $("#cart_count").html(Cart_Pducts.length);
            $("#total_count").html(ttal);

        }



    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            alert("Please enter only Numbers.");
            return false;
        }
        return true;
    }

    function validateEmail(email) {
    //var emailReg = /^([\w-\.]+@@([\w-]+\.)+[\w-]{2,4})?$/;
    //return emailReg.test(String(email).toLowerCase());
         var pattern = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
            if (pattern.test(email))
                return true;
            else
                return false;
}

    function phone_number(inputtxt) {
        var phoneno = /^\d{10}$/;
        if ((inputtxt.value.match(phoneno))) {
            return true;
        }
        else {
            alert("message");
            return false;
        }
    }
    function SaveDetails() {


                var name = $("#cf_name").val();
                var email = $("#cf_email").val();
                var mobile = $("#cf_mobilenumber").val();
                var msg = $("#cf_message").val();

                if (name == '') {
                    alert("Name cannot be empty");
                    return;
                }
                else if (mobile == '' || mobile == null) {
                    alert("mobilenumber cannot be empty");
                    return;
                }
                else if (mobile.length < 10 || mobile.length > 10) {
                    alert("Mobile No. is not valid, Please Enter 10 Digit Mobile No.");
                    return ;
                }
                else if (!phone_number(mobile)) {
                    alert("Mobile No. is not valid");
                    return false;
                }
                else if (email == '' || email == null) {
                    alert("email cannot be empty");
                    return;
                }
                else if (!validateEmail(email)) {
                    alert("Email id is not valid");
                    return false;
                }
                else if (msg == '') {
                    alert("Message cannot be empty");
                    return;
                }
                else {

                $.ajax({
                   type: "POST",
                   url: '@Url.Action("RegisterContactUsDetails", "MaxClean")',
                    contentType: "application/json; charset=utf-8",
                    data: '{"name":"' + name + '","mobile":"' + mobile + '","email":"' + email + '","msg":"' + msg + '"}',
                   dataType: "json",
                    success: function (response) {
                        if (response.result == 'Success')
                        {
                            $("#cf_name").val("");
                            $("#cf_email").val("");
                            $("#cf_mobilenumber").val("");
                            $("#cf_message").val("");
                            alert("Successfully sent the details")


                        }
                        else
                        { alert('Failed, Please check/enter the details'); }
                    },
                   error: function() { alert('A error'); }
                    });
                }
            }
   
</script>


