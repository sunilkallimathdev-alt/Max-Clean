<section class="booking main-block center-block">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1 style="text-align:center">Don’t wait, Book Now.</h1>
            </div>
        </div>

    </div>
</section>

<!-- The Modal -->
<div id="myModalpincode" class="modals fade" role="dialog">
    <div class="modals-dialog">
        <div class="modals-content">
            <div class="modals-header">
                @*<h3 class="m_bottom_20 color_dark"> Login Successful........ </h3>*@
                <button type="button" class="close  tr_all_hover r_corners f_left bg_scheme_color color_light f_mxs_none m_mxs_bottom_15" data-dismiss="modal" aria-hidden="true">&times;</button>

            </div>
            <div id="hdetails" class="modals-body">
                <h3 class="m_bottom_20 color_dark" style="text-align:center;">Please enter your area pincode to check service availability</h3>
                <input name="Phone-number" onkeypress='isNumber(event)' type="number" id="pincode" value="">
                <button type="button" onclick="VerifyPincode()" id="btnpincode" class="button_type_4 tr_all_hover">submit</button>
            </div>
            <div class="modals-footer">
                <p style="color:firebrick" id="returnmsg"> </p>
                <button type="button" class="button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5" data-dismiss="modal">Close</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<script type="text/javascript">
    var someSessionVariable = '@Session["Users"]';

   // if (someSessionVariable != "") {
    $(document).ready(function () {
        if (someSessionVariable == "") {
            $("#myModalpincode").modal({
                backdrop: "static", //remove ability to close modal with click
                keyboard: false, //remove option to close with keyboard
                show: true //Display loader!
            });
        }
        Update_Cart();
    });
    // }
    function showpincode() {
        $("#myModalpincode").modal({
            backdrop: "static", //remove ability to close modal with click
            keyboard: false, //remove option to close with keyboard
            show: true //Display loader!
        });
    }

    function VerifyPincode() {
        if ($('#pincode').val() == "") {
            alert("Enter pincode");
        } else {
            var date = $('#pincode').val();
            var found = false;
            var servingpincode = "";
            //  var parameters = JSON.stringify(data);
            //disable sending message for dev purpose
            $.ajax({
                type: "POST",
                url: '/MaxClean/verifyPincode',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {

                    var pincodelist = (response);

                    if (pincodelist.StatusCode == 200) {
                        for (var p = 0; p < pincodelist.ObjectResult.length; p++) {
                            if (parseInt(date) == pincodelist.ObjectResult[p].Pincode) {

                                found = true;
                            }
                            else { servingpincode += pincodelist.ObjectResult[p].Pincode + " , "; }
                        }
                    }
                    if (found) {
                        //$('#returnmsg').html('Sorry..! We are not serving ')
                        window.location.href = "/order/ordernow";
                        //  alert('Thanks for entering the pincode')
                        localStorage.setItem("IsValidPincode", true);
                    } else {
                        localStorage.setItem("IsValidPincode", false);
                        $('#returnmsg').html('Thank you for your interest in us, we"ll notify once we extend our service to your location. Currently we serve :' + servingpincode);
                        return false;
                    }
                },
                error: function (e) {
                    console.log(JSON.stringify(e));
                    alert("Something went wrong. Please try again later.");
                    return false;
                }
            });
        }
    }

</script>




