@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using API.Models;
@using API.DataAccess;
@{
    ViewBag.Title = "Home";
    Layout = "~/Views/Shared/WebMaster.cshtml";
}

@{ string marqee_text = "";
    try
    {
        using (maxcleanEntities context = new maxcleanEntities())
        {
            var marqeetext = context.t_marque.FirstOrDefault(x => x.is_active == true);
            if (marqeetext != null)
            {
                marqee_text = marqeetext.title;
            }
        }
    }
    catch (Exception e)
    {
        throw e;
    }
}
<marquee style="background-color:#fbe203; font-weight:bold;">@marqee_text</marquee>
<!--slider-->
<section class="revolution_slider">
    <div class="r_slider">
        <ul>
            @{
                var BannersList = (List<API.Models.Banner_Model>)ViewBag.Banners;
                foreach (var bnr in BannersList)
                {
                    if (@bnr.Banner_Image != null)
                    {
                        <li class="f_left" data-transition="cube" data-slotamount="7" data-custom-thumb="@bnr.Banner_Image">
                            <img src="@bnr.Banner_Image" alt="" data-bgrepeat="no-repeat" data-bgfit="cover" data-bgposition="center center">
                            <div class="caption sfb stb color_light slider_title tt_uppercase t_align_c" data-x="center" data-y="270" data-speed="1600" data-easing="ease" data-start="2500" style="padding-top:10px;">@*<b class="">When stain gets tough, <br />the tough gets cleaned.</b>*@</div>
                            <div class="caption sfb stb color_light" data-x="center" data-y="420" data-speed="1400" data-start="2900">

                                @if (Session["Users"] == null)
                                {<a href="#" onclick="showpincode();" role="button" class="zoom button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5">Order Now</a>

                                }
                                else
                                {
                                    <a href="/order/ordernow" role="button" class="zoom button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5">Order Now</a>
                                }
                            </div>
                        </li>
                    }
                }
            }

        </ul>
    </div>
</section>
