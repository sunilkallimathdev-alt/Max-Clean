
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/MainMaster.cshtml";
}


<marquee style="background-color:#fbe203; font-weight:bold;">When stain gets tough, the tough gets cleaned.</marquee>
<!--slider-->
<section class="revolution_slider">
    <div class="r_slider">
        <ul>
            <li class="f_left" data-transition="cube" data-slotamount="7" data-custom-thumb="/images/sld2.jpg">
                <img src="/images/sld2.jpg" alt="" data-bgrepeat="no-repeat" data-bgfit="cover" data-bgposition="center center">
                <div class="caption sfb stb color_light slider_title tt_uppercase t_align_c" data-x="center" data-y="270" data-speed="1600" data-easing="ease" data-start="2500" style="padding-top:10px;"><b class="">When stain gets tough, <br />the tough gets cleaned.</b></div>
                <div class="caption sfb stb color_light" data-x="center" data-y="420" data-speed="1400" data-start="2900">
                    <a href="/order/ordernow" role="button" class="zoom button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5">Order Now</a>
                </div>
            </li>
            <li class="f_left" data-transition="cube" data-slotamount="7" data-custom-thumb="/images/sld3.jpg">
                <img src="/images/sld3.jpg" alt="" data-bgrepeat="no-repeat" data-bgfit="cover" data-bgposition="center center">
                <div class="caption sfb stb color_light slider_title tt_uppercase t_align_c" data-x="center" data-y="270" data-speed="1600" data-easing="ease" data-start="2500"><b class="">When your linen gets in right hand,<br /> the linen gets longer life.</b></div>
                <div class="caption sfb stb color_light" data-x="center" data-y="420" data-speed="1400" data-start="2900">
                    <a href="/order/ordernow" role="button" class="zoom button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5">Order Now</a>
                </div>
            </li>
            <li class="f_left" data-transition="cube" data-slotamount="7" data-custom-thumb="/images/sld5.jpg">
                <img src="/images/sld5.jpg" alt="" data-bgrepeat="no-repeat" data-bgfit="cover" data-bgposition="center center">
                <div class="caption sfb stb color_light slider_title tt_uppercase t_align_c" data-x="center" data-y="270" data-speed="1600" data-easing="ease" data-start="2500"><b class="">If you care for your guest,<br /> we care for your laundry.</b></div>
                <div class="caption sfb stb color_light " data-x="center" data-y="420" data-speed="1400" data-start="2900">
                    <a href="/order/ordernow" role="button" class="zoom button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5 ">Order Now</a>
                </div>
            </li>
        </ul>
    </div>
</section>
<!--content-->
<div class="page_content_offset" style="padding-bottom:10px;">
    <div class="container">
        <div class="center-block">
            <h2>How it <span>works</span></h2>
        </div>
        <div class="row clearfix info_blocks_container">
            <div class="col-lg-3 col-md-3 col-sm-3 m_bottom_45 animate_ftr animate_vertical_finished">
                <figure class="info_block_type_2 t_align_c">
                    <div class="icon_wrap_1 r_corners bg_light_color_1 m_bottom_15 t_align_c vc_child scheme_color d_inline_b tr_all_hover"><img class="d_inline_middle " src="images/Order.png" alt=""></div>
                    <h4 class="fw_medium color_dark m_bottom_15">You Order</h4>
                    <p class="m_bottom_10">Book your collection time online.</p>

                </figure>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-3 m_bottom_45 animate_ftr animate_vertical_finished">
                <figure class="info_block_type_2 t_align_c">
                    <div class="icon_wrap_1 r_corners bg_light_color_1 m_bottom_15 t_align_c vc_child scheme_color d_inline_b tr_all_hover"><img class="d_inline_middle " src="images/Collect.png" alt=""></div>
                    <h4 class="fw_medium color_dark m_bottom_15">We Collect</h4>
                    <p class="m_bottom_10">Upon collection just have your clothes ready - we&#39;ll bring a bag.</p>

                </figure>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-3 m_bottom_45 animate_ftr animate_vertical_finished">
                <figure class="info_block_type_2 t_align_c">
                    <div class="icon_wrap_1 r_corners bg_light_color_1 m_bottom_15 t_align_c vc_child scheme_color d_inline_b tr_all_hover"><img class="d_inline_middle " src="images/Clean.png" alt=""></div>
                    <h4 class="fw_medium color_dark m_bottom_15">We Clean</h4>
                    <p class="m_bottom_10">Using specialist Laundry cleaning experts we guarantee you&#39;ll be satisfied.</p>
                </figure>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-3 m_bottom_45 animate_ftr animate_vertical_finished">
                <figure class="info_block_type_2 t_align_c">
                    <div class="icon_wrap_1 r_corners bg_light_color_1 m_bottom_15 t_align_c vc_child scheme_color d_inline_b tr_all_hover"><img class="d_inline_middle " src="images/Deliver.png" alt=""></div>
                    <h4 class="fw_medium color_dark m_bottom_15">We Deliver</h4>
                    <p class="m_bottom_10">Select your delivery time and we&#39;ll deliver to your door - too easy!</p>
                </figure>
            </div>
        </div>
    </div>
</div>

<section class="booking main-block center-block">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1 style="text-align:center;">Don’t wait, Book Now.</h1>

            </div>
        </div>

    </div>
</section>

