@using API.Models;
@using API.DataAccess;
@{
    ViewBag.Title = "Myrewards";
    Layout = "~/Views/Shared/WebMaster.cshtml";
    Customer_Model currentUser = (Customer_Model)Session["Users"];
    double used = 0;
    double available = 0;
    using(maxcleanEntities context = new maxcleanEntities())
    {
        var cust_rew = context.t_reward.FirstOrDefault(x => x.customer_id == currentUser.CustomerID);
        if (cust_rew != null)
        {
            used = cust_rew.customer_usedrewards??0;
            available = cust_rew.customer_rewardpoints??0;
        }
    }
}

