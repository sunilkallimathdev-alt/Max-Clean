                }
                else if (conpassword != password) {
                    alert("password and confirm password should match");
                    return false;
                }
                else {
                    $.post("@Url.Action("updateuserprofile", "Profile")", { ObjCustomer: JSON.stringify(myobj) }, function (data) {
