             myobj.MobileNumber = $("#u_mobileNumber").val();
             myobj.Address = $("#u_address").val();
             myobj.AltMobileNumber = $("#u_alterNativeNumber").val();
             myobj.Password = $("#u_passWord").val();
             myobj.Pincode = $("#u_pincode").val();
             myobj.CustomerID = "@user.CustomerID";
                myobj.IsActive = true;
             myobj.cus
                if (name == '') {
                    alert("Name cannot be empty");
                    return false;
                }
                else if (mobile == '' || mobile == null) {
                    alert("mobilenumber cannot be empty");
                    return false;
                }
                else if (mobile.length < 10 || mobile.length > 10) {
                    alert("Mobile No. is not valid, Please Enter 10 Digit Mobile No.");
                    return false;
                }
                else if (altmobilenumber != "" && (altmobilenumber.length < 10 || mobile.length > 10)) {
