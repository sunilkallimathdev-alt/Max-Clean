    <script type="text/javascript">
        function Update_Cart() {

            // if ((window.location.pathname).toLowerCase() == "/order/cart")
            // update_local();
            var Cart_Pducts = [];
            var ttal = 0
            var Products_Exist = localStorage.getItem("Order_Object");
            if (Products_Exist != null)
                Cart_Pducts = JSON.parse(localStorage.getItem("Order_Object"));
            var _Products = "";

            _Products += "<div class='f_size_medium sc_header'>Recently added item(s)</div>";
            _Products += "<ul class='products_list' style='height:200px; overflow-y:scroll;' >";
            for (var p = 0; p < Cart_Pducts.length; p++) {


                _Products += "<li>";
                _Products += "<div class='clearfix'>";
                _Products += "<div class='f_left product_description'>";
                _Products += "<a href='#' class='color_dark d_block'>" + Cart_Pducts[p].CategoryName + " / " + Cart_Pducts[p].ProductName + "</a>";
                _Products += "<a href='#' class='color_dark d_block'>" + Cart_Pducts[p].ServiceName + "</a>";
                _Products += "</div>";
                _Products += "<div class='f_left f_size_medium'>";
                _Products += "<div class='clearfix'>";
                _Products += Cart_Pducts[p].Quantity + " x <b class='color_dark'>" + Cart_Pducts[p].UnitPrice + "</b>";
                _Products += "</div>";

                _Products += "</div>";
                _Products += "</div>";
                _Products += "</li>";

                ttal += Cart_Pducts[p].Price;


            }
            _Products += "</ul>";
            _Products += "<ul class='total_price bg_light_color_1 t_align_r color_dark'>";
            _Products += "<li>Total: <b class='f_size_large bold scheme_color sc_price t_align_l d_inline_b m_left_15'>" + ttal + "</b></li>";
            _Products += "</ul>";
            _Products += "<div class='sc_footer t_align_c'>";
            _Products += "<a href='/Order/Cart' role='button' class='button_type_4 d_inline_middle bg_light_color_2 r_corners color_dark t_align_c tr_all_hover m_mxs_bottom_5'>View Cart</a>";
            _Products += "<a href='/Order/Address' role='button' class='button_type_4 bg_scheme_color d_inline_middle r_corners tr_all_hover color_light'>Checkout</a>";
            _Products += "</div>";
            if (Cart_Pducts.length < 1) {
                _Products += "<div class='sc_footer t_align_c'>";
                _Products += "<p>No Items In Cart</p>";
                _Products += "</div>";
            }

            $("#Carts_prds").html(_Products);
            $("#cart_count").html(Cart_Pducts.length);
            $("#total_count").html(ttal);

        }
    </script>
