                            $('#regemail').prop("disabled", false);
                            $('#regmobilenumber').prop("disabled", false);
                            $('#regpassword').prop("disabled", false);
                            return false;
                        }

                    },
                    error: function (e) {
                        console.log(JSON.stringify(e));
                        alert("Something went wrong. Please try again later.");
                        return false;
                    }
                });
            }
        }

