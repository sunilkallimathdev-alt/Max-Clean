        function sendOTPNow(Mobile) {
            var isfound = Verify_Pincode($('#w_pincode').val());
            if (JSON.parse(localStorage.getItem("IsValidPincode"))) {
                $('#altmobilenumber').prop("disabled", true);
                $('#regAddress').prop("disabled", true);
