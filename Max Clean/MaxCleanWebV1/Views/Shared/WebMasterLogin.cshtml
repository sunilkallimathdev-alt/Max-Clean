            });

            $('btnlogin').click();
        });
    </script>

    <script type="text/javascript">
        function isNumber(evt) {
            evt = (evt) ? evt : window.event;
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                evt.preventDefault();
                alert("Please enter only Numbers.");
                return false;
            }
            return true;
        }

        function validateEmail(email) {
            var emailReg = /^([\w-\.]+\u0040([\w-]+\.)+[\w-]{2,4})?$/
            return emailReg.test(String(email).toLowerCase());
        }

        $(document).ready(function () {

            $("#btngetlogin").click(function () {
                var username = $("#username").val();
                var password = $("#password").val();

                if (username == '' ) {
                    alert("Username cannot be empty");

                    return false;
                }
                else if (password == '') {
                    alert("Password cannot be empty");
                    return false;
                }
                else {

                $.ajax({
                   type: "POST",
                   url: '@Url.Action("LoginDetails", "MaxClean")',
                   contentType: "application/json; charset=utf-8",
                    data: '{"userName":"' + username + '","password":"' + password + '"}',
                   dataType: "json",
                   success: function (response) {
                       var Res = response;
                       if (Res.StatusCode == 200)
                           window.location.href = "/Order/ordernow";
                        else
                        { alert('Login Failed, Please check the user name and password'); }
                    },
                   error: function() { alert('A error'); }
                    });
                }
            });


            $("#btnRegister").click(function () {

                var name = $("#regname").val();
                var mobile = $("#regmobilenumber").val();
                var email = $("#regemail").val();
                // var username = $("#regusername").val();
                var password = $("#regpassword").val();
                var address = $("#regAddress").val();
                var altmobilenumber = $("#altmobilenumber").val();
                var myobj = new Object();
                myobj.CustomerName = $("#regname").val();
                myobj.EmailID = $("#regemail").val();
