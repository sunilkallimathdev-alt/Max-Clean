
@{
    ViewBag.Title = "ContactUs";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formcontactus">
            <div class="card card-info" id="carddiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">ADD @ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Contact Name<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="ContactName" maxlength="30" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>EmailID<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="EmailID" maxlength="30" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>S
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Mobile No<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="MobileNo" maxlength="10" onkeypress="return IsNumeric(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Subject<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="Subject" maxlength="150" onkeypress="return IsAlphabets(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Query<span style="color:red">*</span></label>
                                <textarea input class="form-control" type="text" name="Query" maxlength="100" onkeypress="return IsAlphabets(event)"></textarea>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Status<span style="color:red">*</span></label>
                                <select class="form-control" name="IsActive">
                                    <option value="true">Active</option>
                                    <option value="false">InActive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" id="btnadd">Add @ViewBag.Title</button>
                    <button type="button" class="btn btn-warning" id="btnupdate">Edit @ViewBag.Title</button>
                    <button type="button" class="btn btn-danger" onclick="ClearFields()" id="btnreset">Cancel</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped" style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>


        var tableId = "tbl";

        $('#formcontactus').validate({
            rules: {
                ContactName: {
                    required: true,
                },
                EmailID: {
                    email: true,
                    required: false,
                },
                MobileNo: {
                    digits: true,
                    minlength: 10,
                    maxlength: 15,
                    required: true,
                },
                Subject: {
                                  
                    maxlength: 150,
                    required: true,
                },
                Query: {
                    
                    required: true,
                },

            }
        });

         var form = $("#formcontactus");
        form.validate();

        $(document).ready(function () {
            BindTableData();
            $('#btnupdate').hide();
            $("#btnadd").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.ContactName = $('[name="ContactName"]').val();
                    myobj.EmailID = $('[name="EmailID"]').val();
                    myobj.MobileNo = $('[name="MobileNo"]').val();
                    myobj.Subject = $('[name="Subject"]').val();
                    myobj.Query = $('[name="Query"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    setTimeout(function () {
                        $.post("@Url.Action("AddContactUs", "Contact_Us")", { ObjContactUs: JSON.stringify(myobj) }, function (data) {
                            var Res = JSON.parse(data);
                            if (Res.StatusCode == 200) {
                                BindTableData();
                                SuccessAlert("@ViewBag.Title", "Added Successfully.");
                                ClearFields();
                            }
                            else
                                WarningAlert("@ViewBag.Title", Res.Message);
                        })
                    },2000);
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            });

            $("#btnupdate").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.ContactUsId = $('[name="HDID"]').val();
                    myobj.ContactName = $('[name="ContactName"]').val();
                    myobj.EmailID = $('[name="EmailID"]').val();
                    myobj.MobileNo = $('[name="MobileNo"]').val();
                    myobj.Subject = $('[name="Subject"]').val();
                    myobj.Query = $('[name="Query"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    setTimeout(function () {
                        $.post("@Url.Action("UpdateContactUs", "Contact_Us")", { ObjContactUs: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {
                            SuccessAlert("@ViewBag.Title", "Updated Successfully.");
                            BindTableData();
                            ClearFields();
                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message );
                    })
                    }, 2000);
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            })
        });

        function GetData(ContactUsID) {

            $.get("@Url.Action("GetContactUs", "Contact_Us")", { ContactUsID: ContactUsID }, function (data) {
                ClearFields();
                var myobj = JSON.parse(data);
                if (myobj.ObjectResult != null) {
                    $('[name="HDID"]').val(myobj.ObjectResult.ContactUsID);
                    $('[name="ContactName"]').val(myobj.ObjectResult.ContactName);
                    $('[name="EmailID"]').val(myobj.ObjectResult.EmailID);
                    $('[name="Subject"]').val(myobj.ObjectResult.Subject);
                    $('[name="MobileNo"]').val(myobj.ObjectResult.MobileNo);
                    $('[name="Query"]').val(myobj.ObjectResult.Query);
                    if (myobj.ObjectResult.IsActive)
                        $('[name="IsActive"]').val('true');
                    else
                        $('[name="IsActive"]').val('false');
                    OpenCard();
                    $('#btnupdate').show();
                    $('#btnadd').hide();

                }
                else {
                    DangerAlert(" ", "Failed to get data.");
                }
            });
        }

        function DeleteData(ContactUsID) {
            var alert = confirm("Are you sure want to Delete");
            if (alert) {
                $.post("@Url.Action("DeleteContactUs", "Contact_Us")", { ContactUsID: ContactUsID }, function (data) {
                    var myobj = JSON.parse(data);
                    if (myobj.StatusCode == 200) {
                        SuccessAlert("@ViewBag.Title", "Deleted Successfully.");
                        BindTableData();
                    }
                    else
                        WarningAlert("@ViewBag.Title", myobj.Message);
                });
            }
        }
        function ClearFields() {
            $('[name="HDID"]').val(null);
            $('[name="ContactName"]').val(null);
            $('[name="EmailID"]').val(null);
            $('[name="MobileNo"]').val(null);
            $('[name="Subject"]').val(null);
            $('[name="Query"]').val(null);
            $('[name="IsActive"]').val('true');
            $('#btnupdate').hide();
            $('#btnadd').show();
        }

        function BindTableData() {

            $.get("@Url.Action("GetContactUsList", "Contact_Us")", function (data) {
                var myObject = JSON.parse(data);
            var TableDate = [];
            for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(myObject[i].ContactName);
                //row.push("<img src='" + myObject[i].CategoryIcon + "' style='height:100px;width:100px' alt='" + myObject[i].CategoryName + " Icon' />");
                //row.push("<img src='" + myObject[i].CategoryBanner + "' style='height:100px;width:100px' alt='" + myObject[i].CategoryName + " Banner' />");
                row.push(myObject[i].EmailID);
                row.push(myObject[i].MobileNo);
                row.push(myObject[i].Subject);
                row.push(myObject[i].Query);
                if (myObject[i].IsActive)
                    row.push("<span class='badge bg-success float-right'>Active</span>");
                else
                    row.push("<span class='badge bg-danger float-right'>InActive</span>");

                row.push('<button type="button" class="btn btn-info btn-sm" onclick="GetData(' + myObject[i].ContactUsID + ')">Edit</button>');
                row.push('<button type="button" class="btn btn-danger btn-sm" onclick="DeleteData(' + myObject[i].ContactUsID + ')">Delete</button>');
                TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "ContactName" },
                    { title: "EmailID" },
                    { title: "MobileNo" },
                    { title: "Subject" },
                    { title: "Query" },
                    { title: "IsActive " },
                    { title: " " },
                    { title: " " }


                ]
            });
                var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
         });
        }

    </script>

</section>
