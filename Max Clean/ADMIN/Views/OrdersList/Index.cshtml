                            DataToSave[i][3] = oldquant + quant;
                            TableData[i][4] = oldquant + quant;

                            var oldperct = JSON.parse(DataToSave[i][4]);
                            var percent = JSON.parse($("[name=Extrapercent]").val());
                            DataToSave[i][4] = oldperct + percent;
                            TableData[i][5] = oldperct + percent;

                            var oldextraprc = JSON.parse(DataToSave[i][5]);
                            var extprc = JSON.parse($("[name=ExtraPrice]").val());
                            DataToSave[i][5] = oldextraprc + extprc;
                            TableData[i][6] = oldextraprc + extprc;


                            TableData[i][7] = (JSON.parse(TableData[i][3]) * JSON.parse(TableData[i][4])) + JSON.parse(TableData[i][6]);

                            break;
                        }
                    }
                    if (!Dublicate) {
                        var Trow = [];
                        Trow.push($("[name=ServiceID] option:selected").text());
                        Trow.push($("[name=CategoryID] option:selected").text());
                        Trow.push($("[name=ProductID] option:selected").text());
                        Trow.push($("[name=PricePerKG]").val());
                        Trow.push($("[name=RequestedQuantity]").val());
                        Trow.push($("[name=Extrapercent]").val());
                        Trow.push($("[name=ExtraPrice]").val());
                        Trow.push(($("[name=PricePerKG]").val() * $("[name=RequestedQuantity]").val()) + parseFloat($("[name=ExtraPrice]").val()));
                        Trow.push("<button type='button' class='btn btn-danger btn-sm' onclick='RemoveFromCart(" + $("[name=ProductID]").val() + "," + $("[name=ServiceID]").val() + ")'>Delete</button>");

                        TableData.push(Trow);
                        var Srow = [];
                        Srow.push($("[name=ServiceID]").val());
                        Srow.push($("[name=ProductID]").val());
                        Srow.push($("[name=PricePerKG]").val());
                        Srow.push($("[name=RequestedQuantity]").val());
                        Srow.push($("[name=Extrapercent]").val());
                        Srow.push($("[name=ExtraPrice]").val());
                        DataToSave.push(Srow);

                        BindTableData();
                        SuccessAlert($("[name=ProductID] option:selected").text(), "Added to cart.");
                        $("[name=CategoryID]").val(null);
                        $("[name=ProductID]").val(null);
                        $("[name=PricePerKG]").val(null);
                        $("[name=RequestedQuantity]").val(null);
                        $("[name=Extrapercent]").val(0);
                        $("[name=ExtraPrice]").val(0);
                        CalculateGrandTotal();

                    }
                    else {
                        SuccessAlert($("[name=ProductID] option:selected").text(), "Details Updated in cart.");
                        BindTableData();
                        CalculateGrandTotal();
                    }
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            });

