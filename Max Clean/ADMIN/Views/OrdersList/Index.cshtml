        function Searchcustomer() {
            var myObject = new Object();
            myObject.MobileNumber = $('[name="MobileNumber"]').val();
            var mobile = $('[name="MobileNumber"]').val();

            if (myObject.MobileNumber != "" && myObject.MobileNumber.length==10) {
                $.get("@Url.Action("GetCustomerID", "OrdersList")", { objcst: JSON.stringify(myObject) }, function (data) {

                    var myObject = JSON.parse(data);
                    $('[name="CustomerID"]').val(myObject.CustomerID);
                    $('[name="CustomerName"]').val(myObject.CustomerName);
                    $('[name="MobileNumber"]').val(myObject.MobileNumber);
                    $('[name="Email"]').val(myObject.EmailID);
                    $('[name="PickUPAddress"]').val(myObject.Address);
                    $('[name="DeliveryAddress"]').val(myObject.Address);
                    if (myObject.CustomerRewardPoints > 100) {
                        $("#redem").show();
                        $("#rewardlable").show();
                        $("#rewardpts").html(myObject.CustomerRewardPoints);
                    }
                    else {
                        $("#redem").hide();
                        $("#rewardlable").hide();
                    }
                    if (myObject.CustomerID == 0) {
                        alert("No Records Found in Customer Details");
                        $('[name="MobileNumber"]').val(mobile);
                    }

                });
            } else {
                alert("Please Enter valid Mobile No");
            }
        }

        @*function GetOrderCycle() {
