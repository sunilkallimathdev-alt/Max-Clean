                var isoutlet = $('[name="StoresID"]').val();

                BindorderTableData(isoutlet);
            });

            $('#btnupdate').hide();

            $('#redeem').change(function () {

                if (DataToSave.length > 0) {
                    if (JSON.parse($("#rewardpts").html()) < JSON.parse($("#lblgrandtotal").html())) {
                        if ($(this).is(":checked")) {

                            var rwds = JSON.parse($("#rewardpts").html());
                            Rewards = JSON.parse($("#rewardpts").html());
                            var grndt = JSON.parse($("#lblgrandtotal").html());

                            $("#lblgrandtotal").html(grndt - rwds);
                            $("#rewardpts").html(0);
                            balance();
                        } else {
                            var grndt = JSON.parse($("#lblgrandtotal").html());
                            $("#lblgrandtotal").html(grndt + Rewards);
                            $("#rewardpts").html(Rewards);
                            balance();
                        }
                    } else {
                        alert("Cannot Redeem Reward Points");
                        $('#redeem').prop('checked', false);
                    }
                } else {
                    alert("Please Place An Order");
                    $('#redeem').prop('checked', false);
                }
            });


            $('#ExpressDelivery').change(function () {

                if ($(this).is(":checked")) {

                    var grndt = Math.floor(JSON.parse($("#lblgrandtotal").html()));
                    ExpressCharge = 0;
                    ExpressCharge = Math.floor(JSON.parse($("#lblgrandtotal").html())) * 0.5;

                    $("#lblgrandtotal").html(Math.floor((ExpressCharge * 2) + ExpressCharge));

                    balance();
                } else {
                    var grndt = JSON.parse($("#lblgrandtotal").html());
                    $("#lblgrandtotal").html(Math.floor(grndt - ExpressCharge));

                    balance();
                }
            });
        });



        function ClearFields() {
            $('[name="HDID"]').val(null);
