          function GetOrderCycle() {
               $.ajax({
                type: "get",
                url: "/OrderCycle/GetAllOrderCycleList",
                async: false,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    var myObject = data;
                    for (var i = 0; i < myObject.length; i++) {
                        var myobj = new Object();
                        myobj.OrderCycleID = myObject[i].OrderCycleID;
                        myobj.OrderCycleStage = myObject[i].OrderCycleStage;
                        OrderCycle.push(myobj);
                    }
                },
                error: function (errMsg) {
                    alert(JSON.stringify(errMsg));
                }
            });
          }

        function UpdateStatus(OrderID) {

            if (isAddEnabled == true) {
                var check = confirm("Are You Sure You Want to Update Status ?")
                if (check) {
                    var Obj = new Object();
                    Obj.OrderID = OrderID;
                    Obj.orderstatusID = $("#_" + OrderID).val();

                    $.post("@Url.Action("UpdateStatus", "OrdersList")", { obj: JSON.stringify(Obj) }, function (data) {
                        var myobj = JSON.parse(data);
                        if (myobj.StatusCode == 200) {
                            SuccessAlert("Order Status Updated Successfully with ORDERID: " + myobj.Result, " ")

                            BindorderTableData($('[name="IsOutlet"]').val());
                        }
                        else {
                            DangerAlert("Status Cannot Be Updated.");
                        }
                    });
                }
            } else {
                DangerAlert("No Access To Update Status");
            }
       }

    function BindorderTableData(isoutlet) {



        $.get("@Url.Action("GetOrdersList", "OrdersList")", { ID: isoutlet }, function (data) {

            var IDs = [];
            var myObject = JSON.parse(data);
            var TableDate = [];
            var dropdownoption ="";
            for (var i = 0; i < myObject.ObjectResult.length; i++) {
                var row = [];
                row.push(myObject.ObjectResult[i].OrderID);
                row.push(myObject.ObjectResult[i].CustomerName);
                row.push(myObject.ObjectResult[i].CustomerMobile);
                row.push(myObject.ObjectResult[i].StoreName);
                row.push(SplitDateTime(myObject.ObjectResult[i].ExpectingDeliveryDate).replace("/", "-").replace("/", "-"));
                row.push(myObject.ObjectResult[i].GrandTotal);
                row.push(myObject.ObjectResult[i].RemainingAmount);
                if (myObject.ObjectResult[i].IsExpressDelivery == true) {
                    row.push("<span class='badge bg-danger float-right'>Express</span>");
                } else {
                    row.push("<span class='badge bg-info float-right'>Normal</span>");
                }

                if (myObject.ObjectResult[i].orderstatusID == 11) {
                    row.push(myObject.ObjectResult[i].OrderStatus);
                } else {
                    dropdownoption += "<select class='form-control' id='_" + myObject.ObjectResult[i].OrderID + "' onchange='UpdateStatus(" + myObject.ObjectResult[i].OrderID + ")' >";
                    for (var j = 0; j < OrderCycle.length; j++) {
                        if (OrderCycle[j].OrderCycleID == myObject.ObjectResult[i].orderstatusID)
                            dropdownoption += "<option value='" + OrderCycle[j].OrderCycleID + "' selected>" + OrderCycle[j].OrderCycleStage + "</option>";
                        else
                            dropdownoption += "<option value='" + OrderCycle[j].OrderCycleID + "'>" + OrderCycle[j].OrderCycleStage + "</option>";
                    }
                    dropdownoption += "</select>";
                    row.push(dropdownoption);
                }
                dropdownoption = "";
                //var myobj = new Object();
                //myobj.ID = myObject.ObjectResult[i].OrderID;
                //myobj.Value = myObject.ObjectResult[i].orderstatusID;
                //IDs.push(myobj);

                row.push('<button  onclick="SaveID(' + myObject.ObjectResult[i].OrderID + ');" class="btn btn-info btn-sm">Edit Details</button>');
                row.push('<a href="/Invoice/Index/' + myObject.ObjectResult[i].OrderID +'" target="blank" class="btn btn-success btn-sm">Invoice</a>');

        TableDate.push(row);
    }
    $('#' + tableId2).DataTable({
