                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group row">
                                    <div class="col-md-8">
                                        <label>Mobile Number<span style="color:red">*</span></label>
                                        <input class="form-control" autocomplete="off" type="text" name="MobileNumber" maxlength="10" onkeypress="return IsNumeric(event)">
                                        <small style="color:blue">Search By Mobile Number</small>
                                    </div>
                                    <div class="col-md-4">
                                        <label> <span style="color:red"></span></label>
                                        <button type="button" class="btn btn-info edit" onclick="Searchcustomer();" id="btnsearch" style="margin-top:30px;">Search</button>
                                    </div>
                                </div>
                            </div>
                            <div class="callout callout-info">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Store<span style="color:red">*</span></label>
                                            <select class="form-control" name="StoreID">

                                                @{
                                                    try
                                                    {
                                                        var user = JsonConvert.DeserializeObject<API.Models.AdminUser_Model>(Session["logindetails"].ToString());

                                                        if (user.StoreID != null)
                                                        {
                                                            foreach (var str in StoreList)
                                                            {
                                                                if (user.StoreID == @str.StoreID)
                                                                {
                                                                    <option value="@str.StoreID">@str.StoreName</option>
                                                                    break;
                                                                }
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <option value="">---Select---</option>
                                                            foreach (var str in StoreList)
                                                            {
                                                                <option value="@str.StoreID">@str.StoreName</option>
                                                            }
                                                        }
                                                    }
                                                    catch (Exception ex)
                                                    {
                                                        throw ex;
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>PickUP Address<span style="color:red"></span></label>
                                            <textarea class="form-control" type="text" name="PickUPAddress" maxlength="700" onkeypress="return NotanHTML(event)"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>PickUP Date<span style="color:red">*</span></label>
                                            <input class="form-control" type="datetime-local" id="PickUPDate" name="PickUPDate">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Delivery Address<span style="color:red"></span></label>
                                            <textarea class="form-control" type="text" name="DeliveryAddress" maxlength="700" onkeypress="return NotanHTML(event)"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Delivery Date<span style="color:red">*</span></label>
                                            <input class="form-control" type="date" name="DeliveryDate">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Confirmed By<span style="color:red">*</span></label>
                                            <select class="form-control" name="ConfirmedBy">

                                                @{
                                                    var users = JsonConvert.DeserializeObject<API.Models.AdminUser_Model>(Session["logindetails"].ToString());


                                                    foreach (var str in Adminuserslist)
                                                    {
                                                        if (users.UserID == @str.UserID)
                                                        {
                                                            <option value="@str.UserID">@str.UserName</option>
                                                            break;
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Order Status<span style="color:red">*</span></label>
                                            <select class="form-control" name="StatusID">
                                                <option value="">---Select---</option>
                                               
                                                @{
                                                    foreach (var ord in Orderstatuslist)
                                                    {
                                                        if (ord.OrderCycleID == 1 || ord.OrderCycleID == 5) {
                                                        <option value="@ord.OrderCycleID">@ord.OrderCycleStage</option>
                                                                }
                                                            
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                    <section id="section3" class="content">
