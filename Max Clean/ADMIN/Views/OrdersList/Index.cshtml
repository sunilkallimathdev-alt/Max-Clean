                    function calculateextraprice() {
                        var price = $("[name=PricePerKG]").val();
                        var Quant = $("[name=RequestedQuantity]").val();
                        //var Total = price * Quant;
                        var Extrapercent = $("[name=Extrapercent]").val();

                        $("[name=ExtraPrice]").val(Math.floor((Extrapercent / 100) * price));
                    }
                    function CalculateGrandTotal() {
                        var GrandTotal = 0;
                        for (var i = 0; i < DataToSave.length; i++) {
                            GrandTotal += (DataToSave[i][2] * DataToSave[i][3]) - parseFloat(Rewards) + parseFloat(DataToSave[i][5]);
                        }
                        $("#lblgrandtotal").html(Math.floor(GrandTotal));
                           balance();
                     }

                    function balance() {
                        if (parseFloat($("#lblgrandtotal").html()) < $("[name=AmountPaid]").val()) {
                         alert("Advance Amount Is Greater Than Grand Total");
                         $("[name=AmountPaid]").val(null);
                         $("#lblBalanceAmount").html(Math.floor(parseFloat($("#lblgrandtotal").html())));
                        }
                        else {
                            $("#lblBalanceAmount").html(Math.floor(parseFloat($("#lblgrandtotal").html()) - $("[name=AmountPaid]").val()));
                                }
                    }

                    function RemoveFromCart(ProductID, ServiceID) {

                        for (var i = 0; i < DataToSave.length; i++) {
                            if (DataToSave[i][0] == ServiceID, DataToSave[i][1] == ProductID) {
                                 DataToSave.splice(i, 1);
                                 TableData.splice(i, 1);
                                 BindTableData();
                                 SuccessAlert(" ", "Deleted from cart.");
                                 CalculateGrandTotal();

                                 }
                        }
                    }

