<section class="content">
    <div class="container-fluid">
        <div class="card card-info" id="cardv">
            <div class="card-header" data-widget="collapse" style="cursor:pointer">
                <h3 class="card-title">Place An Order</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool"><i class="fa fa-plus"></i></button>
                </div>
            </div>
            <div class="card-body">
                <div class="card-body">
                    <form id="placeorderform">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>Customer Name<span style="color:red">*</span></label>
                                    <input class="form-control" autocomplete="off" type="text" name="CustomerName" maxlength="100" onkeypress="return NotanHTML(event)">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
