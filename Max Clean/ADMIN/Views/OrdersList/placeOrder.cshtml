     function Cal_Balance_after_paid() {
         var GrandTotal = JSON.parse($("[name=GrandTotal]").val());
         var AmountPaid = JSON.parse($("[name=AdvanceAmount]").val());

         if (AmountPaid > GrandTotal) {
             alert("Advance Amount Is Greater Than Grand Total");
             $("[name=AdvanceAmount]").val(0);
             $("[name=BalanceAmount]").val(GrandTotal);
         } else {

             $("[name=BalanceAmount]").val(GrandTotal - AmountPaid);
         }
         $("[name=GrandTotal]").val(GrandTotal);
     }

     function ExpressDeliveryDate() {
         var dtToday = new Date($('[name="PickUPDate"]').val());

         var n = 1; //number of days to add.
         var requiredDate = new Date(dtToday.getFullYear(), dtToday.getMonth(), dtToday.getDate() + n);
         var month = requiredDate.getMonth() + 1;
         var day = requiredDate.getDate();
         var year = requiredDate.getFullYear();
         if (month < 10)
             month = '0' + month.toString();
         if (day < 10)
             day = '0' + day.toString();
         var hour = requiredDate.getHours();
         var min = requiredDate.getMinutes();
         var ss = requiredDate.getSeconds();
         if (hour < 10)
             hour = '0' + hour.toString();
         if (min < 10)
             min = '0' + min.toString();
         if (ss < 10)
             ss = '0' + ss.toString();
         var Today = year + '-' + month + '-' + day;
         $('[name="DeliveryDate"]').val(Today);
     }

