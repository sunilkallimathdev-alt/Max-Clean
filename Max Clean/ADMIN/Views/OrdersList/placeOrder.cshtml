    function RemoveFromCart(ProductID, ServiceID) {
        if (ServiceID == "3")
        {
            alert("Please ReEnter the weight and quantity details of Laundry/KG");
        }
        for (var i = 0; i < DataToSave.length; i++) {
            if (DataToSave[i][0] == ServiceID, DataToSave[i][1] == ProductID) {
                DataToSave.splice(i, 1);
                TableData.splice(i, 1);
                BindTableData();
                SuccessAlert(" ", "Deleted from cart.");
                CalculateGrandTotal_Balance();

            }
        }
