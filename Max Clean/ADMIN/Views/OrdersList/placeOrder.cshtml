        $("#btnplaceorder").on("click", function () {
            var alerts = false;
            if (formcustomer.valid()) {
                if (DataToSave.length == 0 && $("[name=StatusID]").val() == 1) {
                    alerts = confirm("Want to place Order With Empty Cart ? ");
                } else if (DataToSave.length == 0 && $("[name=StatusID]").val() == 5) {
                    alerts = false;
                }
                else {
                    alerts = true;
                }
                if (alerts) {

                    if ($('[name="PickUPDate"]').val() >= $('[name="DeliveryDate"]').val()) {

                        if ($('[name="DeliveryDate"]').val() == "") {
                            alert("Enter Delivery Date");
                        }
                        alert("delivery date should be greater than pickup date");
                        $('[name="DeliveryDate"]').focus();

                    }
                    else {
                        if (formplaceorder.valid()) {
                            var myobj = new Object();
                            myobj.CustomerName = $("[name=CustomerName]").val();
                            myobj.CustomerMobile = $("[name=MobileNumber]").val();
                            myobj.CustomerEmail = $("[name=Email]").val();
                            myobj.PickupAddress = $("[name=PickUPAddress]").val();
                            myobj.PickupDate = $("[name=PickUPDate]").val();
                            myobj.ConfirmedBy = $("[name=ConfirmedBy]").val();
                            myobj.Pickedby = $("[name=PickedBy]").val();
                            myobj.DeliveryAddress = $("[name=DeliveryAddress]").val();
                            myobj.ActualDeliveryDate = $("[name=DeliveryDate]").val();
                            myobj.PickupTime = $("[name=PickUPTime]").val();
                            myobj.DeliveryTime = $("[name=DeliveryTime]").val();
                            myobj.StoreID = $("[name=StoreID]").val();
                            myobj.orderstatusID = $("[name=StatusID]").val();
                            myobj.PaidAmount = $('[name="AdvanceAmount"]').val();
                            myobj.Remark = $("[name=Remark]").val();
                            myobj.PaymentType = $("[name=PaymentType]").val();
                            myobj.Invoice_No == $("[name=Invoice_No]").val();

                            myobj.GrandTotal = $('[name="GrandTotal"]').val()
                            myobj.RemainingAmount = $('[name="BalanceAmount"]').val();
                            myobj.OldBalanceApplied = $('[name="OldBalance"]').val();
                            myobj.IsOutletOrder = true;
                            myobj.RewardPointsApplied = $("[name=RewardPointsApplied]").val();
                            if ($("#redeem").prop('checked') == true) {
                                myobj.IsReward = true;
                            } else {
                                myobj.IsReward = false;
                            }
                            if ($("#ExpressDelivery").prop('checked') == true) {
                                myobj.IsExpressDelivery = true;

                            } else {
                                myobj.IsExpressDelivery = false;

                            }
                            myobj.ExpressChargeApplied = $('[name="ExpressChargeApplied"]').val();

                            if (JSON.parse($('[name="Promocode_amount"]').val()) > 0) {
                                myobj.IsPromocodeApplied = true;
                                myobj.Promocode = $('[name="Promocode"]').val();
                                myobj.Promocode_Amount = JSON.parse($('[name="Promocode_amount"]').val());
                            }
                            else {

                                myobj.IsPromocodeApplied = false;
                                myobj.Promocode = null;
                                myobj.Promocode_Amount = 0;
                            }

                            myobj.Delivery_charge = JSON.parse($('[name="Delivery_Charges"]').val());


                            var Details = [];

                            DataToSave.forEach(function (index) {
                                var detail = new Object();
                                detail.ServiceID = index[0];
                                detail.ProductID = index[1];
                                detail.Quantity = index[2];
                                detail.ExtraPercent = index[4];
                                detail.ExtraPrice = index[5];
                                detail.Price = index[6];
                                Details.push(detail);
                            });
                            myobj.PurchaseOrderDetail = Details;


                            $.post("@Url.Action("AddPurchaseOrder","OrdersList")", { ObjPO: JSON.stringify(myobj) }, function (data) {

                                var myobj = JSON.parse(data);
                                if (myobj.StatusCode == 200) {
