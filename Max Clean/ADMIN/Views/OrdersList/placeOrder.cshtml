    function IsRewardApplied() {
        if ($("#redeem").is(':checked')) {

            DangerAlert("Rewards are redeemed , Cannot use Promocode");
            $('[name="Promocode"]').val(null);
        }
    }
    function applyPromocode() {
        if ($('[name="Promocode"]').val() != "") {

            //if ($("#redeem").is(':checked') || DataToSave.length < 1 || parseInt($('[name="CartTotal"]').val()) < 500) {
            if ($("#redeem").is(':checked') || DataToSave.length < 1) {
                if (DataToSave.length < 1) {
                    DangerAlert("Please Add Products To Cart");
                }
                else if ($("#redeem").is(':checked')) {
                    DangerAlert("Rewards are redeemed , Cannot use Promocode");
                }
                //else {
                //    DangerAlert("Cart Total LessThan 500 , Cannot use Promocode");
                //}
                $('[name="Promocode"]').val(null);
            } else {

                var Obj = new Object();
                Obj.Promocode_Name = $('[name="Promocode"]').val();

                $.post("@Url.Action("ValidatePromocode", "Promocode")", { ObjPromocode: JSON.stringify(Obj) }, function (data) {
                    var myobj = JSON.parse(data);
                    if (myobj.StatusCode == 200) {
                        SuccessAlert("Promocode Applied Successfully")
                        var CartTotal = parseInt($('[name="CartTotal"]').val());
                        var ExpressChargeApplied = parseInt($('[name="ExpressChargeApplied"]').val());
                        var Discount = myobj.ObjectResult.Discount || 0;
                        $("#Promocode_Discount").val(Discount);
                        $('[name="Promocode_amount"]').val(parseInt((Discount / 100) * (CartTotal + ExpressChargeApplied)));
                        var Promocode_amount = parseInt($('[name="Promocode_amount"]').val());
                        if (Promocode_amount > 0) {
                            $("#redeem").hide();
                            $("#rewarddiv").hide();
                            $('#redem').hide();
                           // $("#rewardpts").val(0);
                        }
                        else {
                            $("#rewarddiv").show();
                            $("#rewardpts").val(myObject.CustomerRewardPoints);
                            $("#redeem").show();
                            $('#redem').show();
                        }
                        CalculateGrandTotal_Balance();
                    }
                    else {
                        $('[name="Promocode_amount"]').val(0);

                        DangerAlert("Invalid Promocode");
                    }
                });
            }
        } else {
            DangerAlert("Enter Promocode");
        }
    }

    function ch(ServiceID, ProductID) {

        var price = JSON.parse($('#PRC_' + ServiceID + '_' + ProductID).html());
        var Extrapercent = JSON.parse($('#EPER_' + ServiceID + '_' + ProductID).val());
        var quant = JSON.parse($('#QTY_' + ServiceID + '_' + ProductID).val());

        $('#EPRC_' + ServiceID + '_' + ProductID).html(Math.floor((Extrapercent / 100) * price));
        var extraprice = Math.floor((Extrapercent / 100) * price);

        for (var i = 0; i < DataToSave.length; i++) {
            if (DataToSave[i][0] == ServiceID, DataToSave[i][1] == ProductID) {
                DataToSave[i][2] = quant;
                DataToSave[i][4] = Extrapercent;
                DataToSave[i][5] = extraprice;
                DataToSave[i][6] = (quant * price) + extraprice;

                TableData[i][3] = "<span id='PRC_" + ServiceID + "_" + ProductID + "' >" + price + " </span>";
                TableData[i][4] = "<input id='QTY_" + ServiceID + "_" + ProductID + "' type='number' onblur='Calculate(" + ServiceID + "," + ProductID + ")' value='" + quant + "'  min='0'   maxlength='50' class='form-control' onkeypress='return IsNumeric(event)'  />";
                TableData[i][5] = "<input id='EPER_" + ServiceID + "_" + ProductID + "' type='number' onblur='ch(" + ServiceID + "," + ProductID + ")' value='" + Extrapercent + "' min='0'  maxlength='50' class='form-control' onkeypress='return IsNumeric(event)'  />";
                TableData[i][6] = "<span id='EPRC_" + ServiceID + "_" + ProductID + "' >" + extraprice + " </span>";
                TableData[i][7] = "<span id='TTP_" + ServiceID + "_" + ProductID + "' >" + ((quant * price) + extraprice) + " </span>";
            }
        }

        $('#EPRC_' + ServiceID + '_' + ProductID).html(Math.floor((Extrapercent / 100) * price));
        // $("[name=ExtraPrice]").html((Extrapercent / 100) * price);
        Calculate(ServiceID, ProductID);
    }
    function Calculate(serviceid, productid) {
        GrandTotalPrice = 0;
        var Enter_quant = $('#QTY_' + serviceid + "_" + productid).val();

        if (Enter_quant == "")
            Enter_quant = 0;
        else
            Enter_quant = JSON.parse($('#QTY_' + serviceid + "_" + productid).val());

        var UnitPrice = JSON.parse($('#PRC_' + serviceid + "_" + productid).html());
        var ExtraPrices = JSON.parse($('#EPRC_' + serviceid + '_' + productid).html());
        var Extrapercent = JSON.parse($('#EPER_' + serviceid + '_' + productid).val());

        $('#TTP_' + serviceid + "_" + productid).html((Enter_quant * UnitPrice) + ExtraPrices);

        for (var i = 0; i < DataToSave.length; i++) {
            if (DataToSave[i][0] == serviceid, DataToSave[i][1] == productid) {
                DataToSave[i][2] = Enter_quant;
                DataToSave[i][4] = Extrapercent;
                DataToSave[i][5] = ExtraPrices;
                DataToSave[i][6] = (Enter_quant * UnitPrice) + ExtraPrices;

                TableData[i][3] = "<span id='PRC_" + serviceid + "_" + productid + "' >" + UnitPrice + " </span>";
                TableData[i][4] = "<input id='QTY_" + serviceid + "_" + productid + "' type='number' onblur='Calculate(" + serviceid + "," + productid + ")' value='" + Enter_quant + "'  min='0'   maxlength='50' class='form-control' onkeypress='return IsNumeric(event)'  />";
                TableData[i][5] = "<input id='EPER_" + serviceid + "_" + productid + "' type='number' onblur='ch(" + serviceid + "," + productid + ")' value='" + Extrapercent + "' min='0'  maxlength='50' class='form-control' onkeypress='return IsNumeric(event)'  />";
                TableData[i][6] = "<span id='EPRC_" + serviceid + "_" + productid + "' >" + ExtraPrices + " </span>";
                TableData[i][7] = "<span id='TTP_" + serviceid + "_" + productid + "' >" + ((Enter_quant * UnitPrice) + ExtraPrices) + " </span>";
            }

        }
        CalculateGrandTotal_Balance();
    }

