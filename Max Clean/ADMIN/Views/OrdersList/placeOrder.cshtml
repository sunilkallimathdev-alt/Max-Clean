<style>
    body {
        font-family: Arial, Helvetica, sans-serif;
    }

    /* The Modal (background) */
    .modal {
        display: none; /* Hidden by default */
        position: fixed; /* Stay in place */
        z-index: 1; /* Sit on top */
        padding-top: 100px; /* Location of the box */
        left: 0;
        top: 0;
        width: 1700px; /* Full width */
        height: 100%; /* Full height */
        overflow: auto; /* Enable scroll if needed */
        background-color: rgb(0,0,0); /* Fallback color */
        background-color: rgba(0,0,0,0.4); /* Black w/ opacity */
    }

    /* Modal Content */
    .modal-content {
        background-color: #fefefe;
        margin: auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
    }

    /* The Close Button */
    .close {
        color: #aaaaaa;
        float: right;
        font-size: 20px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: #000;
            text-decoration: none;
            cursor: pointer;
        }
</style>

<script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
<script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
<script src="~/CustomFiles/js/Common_js.js"></script>
<script>
    // Get the modal
    var modal = document.getElementById('bulkstatus');

    // Get the button that opens the modal
    var btn = document.getElementById("bulkstat");

    // Get the <span> element that closes the modal
    var span = document.getElementsByClassName("close")[0];

    // When the user clicks the button, open the modal
    btn.onclick = function () {
        modal.style.display = "block";
        $("#tostatusdiv").hide();
        $("#btnsub").hide();
    }

    // When the user clicks on <span> (x), close the modal
    span.onclick = function () {
        modal.style.display = "none";
        var StoreID = $('[name="StoresID"]').val();
        $('.check_all').prop("checked", false);
        $("#Nontagged").html("");
        $("[name=FromStatus]").val(null);

        BindorderTableData(StoreID);
    }

    // When the user clicks anywhere outside of the modal, close it
    window.onclick = function (event) {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }

    function GetData() {
        var FromOrderStatus = $("[name=FromStatus]").val();

        if (FromOrderStatus == "") {
            DangerAlert(" ", "Select From Status");
            $("[name=FromStatus]").focus();
        } else {


            $.get("@Url.Action("GetOrderBYstatus", "OrdersList")", { StatusID: FromOrderStatus }, function (data) {

                var myobj = JSON.parse(data);
                var str = "";
                str += "<div class='col-md-2'>"
                str += "<div class='form-group'>"
                str += "<label><input  name='check_all' type='checkbox' /><strong> Check All</strong></label>"
                str += "</div>"
                str += "</div>"
                if (myobj != null) {
                    for (var i = 0; i < myobj.length; i++) {
                        str += "<div class='col-md-2'>"
                        str += "<div class='form-group'>"
                        str += "<label><input class='blkstat' id='" + myobj[i].OrderID + "' type='checkbox' />OrderID  " + myobj[i].OrderID + " / " + myobj[i].CustomerName + "/" + SplitDateTime(myobj[i].OrderDate).replace("/", "-").replace("/", "-") + "  </label>"
                        str += "</div>"
                        str += "</div>"
                    }
                    $("#btnsub").html("<button type='button' class='btn btn-success' onclick='ChangeStatus();' style='height:40px;margin-top:30px;'>Change Status</button>");
                    $("#Nontagged").html(str);
                    $("#tostatusdiv").show();
                    $("#btnsub").show();
                }
                else {
                    DangerAlert(" ", "Failed to get data.");
                }
