    function ChangeStatus(){
                var myobj = new Object();
                myobj.Orders = [];
                myobj.Order_Status = $("[name=ToStatus]").val();

                $("input:checkbox").each(function () {
                    var $this = $(this);

                    if ($this.is(":checked")) {
                        var obj = new Object();
                        obj.OrderID = $this.attr("id");
                        myobj.Orders.push(obj);
                    }
                });

                if ($("[name=ToStatus]").val() == "") {
                    WarningAlert("", "Please Select Status");
                    $("[name=ToStatus]").focus();
                } else {
                    $.post("@Url.Action("ChangeStatus", "OrdersList")", { objlist: JSON.stringify(myobj) }, function (data) {

                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {

                            GetData();
                            SuccessAlert("@ViewBag.Title", " Successfully.");
                            $("[name=ToStatus]").val(null);

                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message);

                    })
                }
    }
