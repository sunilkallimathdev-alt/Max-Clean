                                    var url = window.location.origin + "/Invoice/Index/" + myobj.Result;
                                    window.open(url, '_blank');

                                }
                                else {
                                    DangerAlert("Something Went Wrong. Please retry.");
                                }

                            });
                        }
                        else {
                            DangerAlert(" ", "Recheck the fields.");
                        }

                    }


                } else {
                    alert("Cannot Place An Empty Order With Status Goods Received At Store");
                }
            } else {
                DangerAlert(" ", "Recheck the fields.");
                $("[name=MobileNumber]").focus();
            }
        });

