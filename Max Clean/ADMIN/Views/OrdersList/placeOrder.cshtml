     function Calculate_Subtotal_TotalPrice(ServiceID, ProductID) {



         var Quantity = ($("#Q_" + ServiceID + "_" + ProductID).val() != "") ? $("#Q_" + ServiceID + "_" + ProductID).val() : 0;
         if (Quantity == '' || Quantity == 0) {

            // $("#Q_" + ServiceID + "_" + ProductID).focus();
             DangerAlert("Enter Quantity");
             $("#E_" + ServiceID + "_" + ProductID).val(null);
             $("#S_" + ServiceID + "_" + ProductID).val(null);
             $("#EP_" + ServiceID + "_" + ProductID).val(null);
             $("#TP_" + ServiceID + "_" + ProductID).val(null);
         } else {
             var UnitPrice = JSON.parse($("#P_" + ServiceID + "_" + ProductID).html());
             var SubTotal = Quantity * UnitPrice;
             var ExtraPercent = ($("#E_" + ServiceID + "_" + ProductID).val() != "") ? $("#E_" + ServiceID + "_" + ProductID).val() : 0;
             var ExtraPrice = Math.floor((ExtraPercent / 100) * UnitPrice);
             var TotalPrice = SubTotal + ExtraPrice;

             if (Quantity < 0 || ExtraPercent < 0) {
                 DangerAlert("Enter Value is less than 0");
                 if (Quantity < 0)
                     $("#Q_" + ServiceID + "_" + ProductID).val(0);
                 if (ExtraPercent < 0)
                     $("#E_" + ServiceID + "_" + ProductID).val(0);
             } else {
                 $("#S_" + ServiceID + "_" + ProductID).val(SubTotal);
                 $("#EP_" + ServiceID + "_" + ProductID).val(ExtraPrice);
                 $("#TP_" + ServiceID + "_" + ProductID).val(TotalPrice);

                 if (ExtraPercent == 0) {
                     $("#E_" + ServiceID + "_" + ProductID).val(0);
                 }
             }
         }
     }

     function CalculateGrandTotal_Balance() {

         var OldBalance = JSON.parse($("[name=OldBalance]").val());
         var GrandTotal = 0;
         var AmountPaid = JSON.parse($("[name=AdvanceAmount]").val());

         for (var i = 0; i < DataToSave.length; i++) {
             GrandTotal += JSON.parse(DataToSave[i][6]);
         }

         // Laundry Per Kg
         var TotalWeight_Price = parseFloat($("[name=TotalWeightPrice]").val());
         //if (isNaN(TotalWeight_Price)) {
             GrandTotal = Math.floor(GrandTotal + TotalWeight_Price);
         //}

         $("[name=CartTotal]").val(GrandTotal);

         if (GrandTotal < 1) {
             var RewardPoints = JSON.parse($("#rewardpts").val());
             $("#rewardpts").val(JSON.parse($("[name=RewardPointsApplied]").val()) + RewardPoints);
             $("[name=RewardPointsApplied]").val(0);
             $('#redeem').prop('checked', false);
         }

         if ($("#ExpressDelivery").prop('checked') == true)  {
             $('[name="ExpressChargeApplied"]').val((50 / 100) * GrandTotal);
             ExpressCharge = JSON.parse($('[name="ExpressChargeApplied"]').val());
             GrandTotal = Math.floor(GrandTotal + ExpressCharge);

         }


         GrandTotal += OldBalance;


         if ($("#redeem").prop('checked') == true) {
             if (GrandTotal > 499) {
                 var RewardPoints = JSON.parse($("#rewardpts").val());
                 $("#rewardpts").val((JSON.parse($("[name=RewardPointsApplied]").val())+ RewardPoints) - 100);
                 $("[name=RewardPointsApplied]").val(100);
             } else {
                 var RewardPoints = JSON.parse($("#rewardpts").val());
                 $("#rewardpts").val((JSON.parse($("[name=RewardPointsApplied]").val()) + RewardPoints) - 50);
                 $("[name=RewardPointsApplied]").val(50);
             }
             var Rewards = JSON.parse($("[name=RewardPointsApplied]").val());
         } else {
             var Rewards = 0;
         }
         GrandTotal -= Rewards;

         if (parseInt($("[name=CartTotal]").val()) < 500) {
             //$("#Promocode_Discount").val(0)
         }
         var discount = parseInt($("#Promocode_Discount").val());

         if (discount > 0) {
             var CartTotal = parseInt($("[name=CartTotal]").val());
             var ExpressChargeApplied = parseInt($("[name=ExpressChargeApplied]").val());
             $('[name="Promocode_amount"]').val(Math.floor((discount / 100) * (CartTotal + ExpressChargeApplied)));
         } else {
             var CartTotal = parseInt($("[name=CartTotal]").val());
             var ExpressChargeApplied = parseInt($("[name=ExpressChargeApplied]").val());
             $('[name="Promocode_amount"]').val(Math.floor((discount / 100) * (CartTotal + ExpressChargeApplied)));
         }


         GrandTotal -= parseInt($('[name="Promocode_amount"]').val()||0);

         if (GrandTotal<350) {
             $('[name="Delivery_Charges"]').val(50);
             $("#delivery_checkbox").prop('checked', true);

         }
         else {
             $("#delivery_checkbox").prop('checked', false);
             $('[name="Delivery_Charges"]').val(0);
         }
             GrandTotal += JSON.parse($("[name=Delivery_Charges]").val());


         if (AmountPaid > GrandTotal) {
             alert("Advance Amount Is Greater Than Grand Total");
             $("[name=AdvanceAmount]").val(0);
             $("[name=BalanceAmount]").val(GrandTotal);
         } else {

             $("[name=BalanceAmount]").val(GrandTotal - AmountPaid);
         }

         $("[name=GrandTotal]").val(GrandTotal);
     }

