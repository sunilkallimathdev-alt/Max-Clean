</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <div class="wrapper">
            @{
                ViewBag.Title = "Receive Vendor Product";
            }
            <!-- Main content -->
            <div class="invoice p-3 mb-3">
                <!-- title row -->
                <div class="row">
                    <div class="col-12">
                        <h4>
                            <i class="fa fa-coffee"></i> Coffee Brew
                            <small class="float-right" type="datetime-local" id="Today"></small>
                        </h4>
                    </div>
                    <!-- /.col -->
                </div>
                <!-- info row -->
                <div class="row invoice-info">
                    <div class="col-sm-4 invoice-col">
                        From
                        <address id="Fromadd">

                        </address>
                    </div>
                    <!-- /.col -->
                    <div class="col-sm-4 invoice-col">
                        To
                        <address id="Toadd">

                        </address>
                    </div>
                    <!-- /.col -->
                    <div class="col-sm-4 invoice-col" id="OrderId">


                        <b>Order ID:</b> <span id="orderid"></span><br>
                        <b>Delivery Date:</b> <span id="ActualDeliveryDate"></span><br>

                    </div>
                    <!-- /.col -->
                </div>
                <!-- /.row -->
                <!-- Table row -->
                <div class="row">
                    <div class="col-12 table-responsive">
                        <table class="table table-striped" id="tbl" style="width:100%;"></table>
                    </div>
                    <!-- /.col -->
                </div>
                <!-- /.row -->
                <div class="row">
                    <!-- accepted payments column -->
                    <div class="col-6">
                        @*<p class="lead">Payment Methods:</p>
                            <img src="../../dist/img/credit/visa.png" alt="Visa">
                            <img src="../../dist/img/credit/mastercard.png" alt="Mastercard">
                            <img src="../../dist/img/credit/american-express.png" alt="American Express">
                            <img src="../../dist/img/credit/paypal2.png" alt="Paypal">
                            <p class="text-muted well well-sm no-shadow" style="margin-top: 10px;">
                                Etsy doostang zoodles disqus groupon greplin oooj voxy zoodles, weebly ning heekya handango imeem
                                plugg
                                dopplr jibjab, movity jajah plickers sifteo edmodo ifttt zimbra.
                            </p>*@
                    </div>
                    <!-- /.col -->
                    <div class="col-6">
                     
                        <div class="table-responsive">
                            <table class="table">
                                <tr>
                                    <th style="width:50%">Grand Total :</th>
                                    <td id="GrandTotal"></td>
                                </tr>
                              
                                <tr>
                                    <th>Paid Amount :</th>
                                    <td id="Paid"></td>
                                </tr>
                                <tr>
                                    <th>Balance Amount :</th>
                                    <td id="Balance"></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <!-- /.col -->
                </div>
                <!-- /.row -->
                <!-- this row will not appear when printing -->
                <div class="row no-print">
                    <div class="col-12">
                        @*<a href="invoice-print.html" target="_blank" class="btn btn-default"><i class="fa fa-print"></i> Print</a>*@
                        @*<button type="button" class="btn btn-success float-right">
                            <i class="fa fa-credit-card"></i> Submit
                            Payment
                        </button>*@
                        <button type="button" class="btn btn-primary float-right" onClick="window.print();" style="margin-right: 5px;">
                            <i class="fa fa-download"></i> Generate PDF
                        </button>
                    </div>
                </div>
            </div>
            <!-- /.invoice -->
        </div>
        <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
        <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
        <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
        <script src="~/CustomFiles/js/Common_js.js"></script>
        <script>
     

        var tableId = "tbl";

            $(document).ready(function () {

                var dtToday = new Date();
                var month = dtToday.getMonth() + 1;
                var day = dtToday.getDate();
                var year = dtToday.getFullYear();
                if (month < 10)
                    month = '0' + month.toString();
                if (day < 10)
                    day = '0' + day.toString();
                var Today = month + '-' + day + '-' + year;
               
                $("#Today").html(Today);
            setTimeout(function () {
                $('#carddiv').removeClass('collapsed-card');
            }, 500);

            var ID = JSON.parse(localStorage.getItem("VPOID"));
            localStorage.removeItem("VPOID");
            GetRequestOrders(2);

        });

        function GetRequestOrders(PurchaseOrderByID) {
            $.get("@Url.Action("GetRequestedOrdersById", "ReceiveVendorProduct")", { ID: PurchaseOrderByID }, function (data) {


                var myObject = JSON.parse(data);

                var fromadd = "";

                fromadd +="< strong >'"+ myObject.ObjectResult.VendorName+"'</strong > <br>";
                fromadd +='Mobile No. : ' + myObject.ObjectResult.VendorMobileNO+'< br > ';
                fromadd +='Email: ' + myObject.ObjectResult.VendorEmail+'<br>';
                fromadd += myObject.ObjectResult.VendorAddress+'< br > ';
                fromadd += myObject.ObjectResult.VendorCity + '< br > ';
                $("#Fromadd").html(fromadd);

                var Toadd = [];

                Toadd.push('< strong >' + myObject.ObjectResult.StoreName + '</strong > <br>');
                Toadd.push('Mobile No. : ' + myObject.ObjectResult.StoreMobileNo + '< br > ');
                Toadd.push('Email: ' + myObject.ObjectResult.StoreEmail + '<br>');
                Toadd.push('' + myObject.ObjectResult.StoreAddress + '< br > ');
                Toadd.push('' + myObject.ObjectResult.StoreCity + '< br > ');
                $("#Toadd").html(Toadd);

                $("#orderid").html(myObject.ObjectResult.VendorPurchaseOrderID);

                $("#GrandTotal").html(myObject.ObjectResult.GrandTotal);
                $("#Paid").html(myObject.ObjectResult.PaidAmount);
                $("#Balance").html(myObject.ObjectResult.RemainingAmount);
                
                $("#ActualDeliveryDate").html(SplitDateTime(myObject.ObjectResult.ActualDeliveryDate).replace("/", "-").replace("/", "-"));

                var TableDate = [];

                for (var i = 0; i < myObject.ObjectResult.PurchaseOrderDetail.length; i++) {
                    var row = [];
                    row.push(i+1);
                row.push(myObject.ObjectResult.PurchaseOrderDetail[i].CategoryName);
                row.push(myObject.ObjectResult.PurchaseOrderDetail[i].ProductName);
                row.push(myObject.ObjectResult.PurchaseOrderDetail[i].PricePerKG);
                row.push(myObject.ObjectResult.PurchaseOrderDetail[i].ReceivedQuantity);
                row.push(myObject.ObjectResult.PurchaseOrderDetail[i].PricePerKG * myObject.ObjectResult.PurchaseOrderDetail[i].ReceivedQuantity);

                TableDate.push(row);
                }
             
                $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
           
                bInfo: false,
                paging: false,
                ordering: false,
                searching: false,
                columns: [
                    { title: "Sl No." },
                    { title: "Category" },
                    { title: "Product Name" },
                    { title: "Price / KG" },
                    { title: "Qty" },
                    { title: "Sub Total" },

                    ]
                });
           });
        }





        </script>
        <footer class="main-footer">
            <strong>Copyright &copy;2018 All rights reserved.</strong> Designed and Developed By <a href="http://mindmapstechnologies.com" target="_blank"><img src="http://cubspreschool.myprelaunch.in/images/mmt_fevicon.png" style="height: 15px"> MindMaps Technologies</a>.

            <div class="float-right d-none d-sm-inline-block">

            </div>
        </footer>
    </div>

    <div id="loader-wrapper">
        <div id="loader"></div>
        <div class="loader-section section-left"></div>
        <div class="loader-section section-right"></div>
    </div>

    <!-- jQuery -->
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>

    <!-- DataTables -->
    <script src="~/CustomFiles/plugins/datatables/jquery.dataTables.js"></script>
    <script src="~/CustomFiles/plugins/datatables/dataTables.bootstrap4.js"></script>
    <script src="~/CustomFiles/js/datatables/cdn.datatables.net/buttons/1.2.2/js/dataTables.buttons.min.js"></script>
    <script src="~/CustomFiles/js/datatables/cdn.datatables.net/buttons/1.2.2/js/buttons.flash.min.js"></script>
    <script src="~/CustomFiles/js/datatables/cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js"></script>
    <script src="~/CustomFiles/js/datatables/cdn.rawgit.com/bpampuch/pdfmake/0.1.18/build/pdfmake.min.js"></script>
    <script src="~/CustomFiles/js/datatables/cdn.rawgit.com/bpampuch/pdfmake/0.1.18/build/vfs_fonts.js"></script>
    <script src="~/CustomFiles/js/datatables/cdn.datatables.net/buttons/1.2.2/js/buttons.html5.min.js"></script>
    <script src="~/CustomFiles/js/datatables/cdn.datatables.net/buttons/1.2.2/js/buttons.print.min.js"></script>

    <!-- Bootstrap 4 -->
    <script src="~/CustomFiles/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Select2 -->
    <script src="~/CustomFiles/plugins/select2/select2.full.min.js"></script>
    <!-- date-range-picker -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.10.2/moment.min.js"></script>
    <script src="~/CustomFiles/plugins/daterangepicker/daterangepicker.js"></script>
    <!-- bootstrap color picker -->
    <script src="~/CustomFiles/plugins/colorpicker/bootstrap-colorpicker.min.js"></script>
    <!-- bootstrap time picker -->
    <script src="~/CustomFiles/plugins/timepicker/bootstrap-timepicker.min.js"></script>
    <!-- SlimScroll 1.3.0 -->
    <script src="~/CustomFiles/plugins/slimScroll/jquery.slimscroll.min.js"></script>
    <!-- iCheck 1.0.1 -->
    <script src="~/CustomFiles/plugins/iCheck/icheck.min.js"></script>
    <!-- FastClick -->
    <script src="~/CustomFiles/plugins/fastclick/fastclick.js"></script>
    <!-- AdminLTE App -->
    <script src="~/CustomFiles/dist/js/adminlte.min.js"></script>
    <!-- AdminLTE for demo purposes -->
    <script src="~/CustomFiles/dist/js/demo.js"></script>
    <!--Toastr Min-->
    <script src="~/CustomFiles/dist/js/toastr.min.js"></script>
    <link href="~/CustomFiles/dist/css/loader.css" rel="stylesheet" />
    <script>
        //setTimeout(function () { $('body').css('zoom', '80%')}, 2000);
        $('#loader-wrapper').css('display', 'none');
        $(document).ajaxStart(function () {
            $('#loader-wrapper').css('display', 'block');
        }).ajaxStop(function () {
            $('#loader-wrapper').css('display', 'none');
        });

        $(function () {
            //Initialize Select2 Elements
            $('.select2').select2();
            CloseCard();
        });
        function OpenCard() {
            $('#carddiv').removeClass('collapsed-card');
            $('html, body').animate({ scrollTop: 0 }, 'fast');
        }
        function CloseCard() {
            $('#carddiv').addClass('collapsed-card');
        }
        function SuccessAlert(Title, Message) {
            toastr.success(Message, Title)
        }
        function WarningAlert(Title, Message) {
            toastr.warning(Message, Title)
        }
        function DangerAlert(Title, Message) {
            toastr.error(Message, Title)
        }

    </script>
</body>
</html>


