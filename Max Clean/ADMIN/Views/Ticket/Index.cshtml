
@{
    ViewBag.Title = "Ticket";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formticket">
            <div class="card card-info" id="carddiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">ADD @ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>TicketSubject Name<span style="color:red">*</span></label>
                                <select name="TicketSubjectID" class="form-control">
                                    <option value="">---Select--- </option>
                                    @{
                                        var TicketSubjectList = (List<API.Models.TicketSubject_Model>)ViewBag.Ticket;
                                        foreach (var cat in TicketSubjectList)
                                        {
                                            <option value="@cat.TicketSubjectID">@cat.SubjectName </option>
                                        }
                                    }
                                </select>
                            </div>

                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Query <span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="Query" maxlength="100" onkeypress="return IsAlphabets(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Status<span style="color:red">*</span></label>
                                <select class="form-control" name="IsActive">
                                    <option value="false">Open</option>
                                    <option value="">InProgress</option>
                                    <option value="true">Closed</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" id="btnadd">Add @ViewBag.Title</button>
                    <button type="button" class="btn btn-warning" id="btnupdate">Update @ViewBag.Title</button>
                    <button type="button" class="btn btn-danger" onclick="ClearFields()" id="btnreset">Cancel</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped" style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>

        var tableId = "tbl";

        $('#formticket').validate({
            rules: {
                TicketSubjectID: {
                    required: true,
                },
                OrderID: {
                    required: true,
                },
                Query: {
                    required: true,
                },
            }
        });

        var form = $("#formticket");
        form.validate();

       $(document).ready(function () {
            BindTableData();
            $('#btnupdate').hide();
            $("#btnadd").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.TicketSubjectID = $('[name="TicketSubjectID"]').val();
                    myobj.OrderID = $('[name="OrderID"]').val();
                    myobj.Query = $('[name="Query"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    $.post("@Url.Action("AddTicket", "Ticket")", { ObjTicket: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {
                            SuccessAlert("@ViewBag.Title", "Added Successfully.");
                            ClearFields();
                            BindTableData();
                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message);
                    });
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }

        });

            $("#btnupdate").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.TicketID = $('[name="HDID"]').val();
                    myobj.TicketSubjectID = $('[name="TicketSubjectID"]').val();
                    myobj.OrderID = $('[name="OrderID"]').val();
                    myobj.Query = $('[name="Query"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    $.post("@Url.Action("UpdateTicket", "Ticket")", { ObjTicket: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {
                            SuccessAlert("@ViewBag.Title", "Updated Successfully.");
                            BindTableData();
                            $('#btnupdate').hide();
                            ClearFields();
                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message);
                    });
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            });
    });
        function GetData(TicketID) {
            $.get("@Url.Action("GetTicket", "Ticket")", { TicketID: TicketID }, function (data) {
                ClearFields();
                var myobj = JSON.parse(data);
                if (myobj.ObjectResult != null) {
                    $('[name="HDID"]').val(myobj.ObjectResult.TicketID);
                    $('[name="TicketSubjectID"]').val(myobj.ObjectResult.TicketSubjectID);
                    $('[name="OrderID"]').val(myobj.ObjectResult.OrderID);
                    $('[name="Query"]').val(myobj.ObjectResult.Query);
                           if (myobj.ObjectResult.IsActive)
                        $('[name="IsActive"]').val("true");
                    else
                        $('[name="IsActive"]').val("false");
                    $("#btnadd").hide();
                    $('#btnupdate').show();
                    OpenCard();
                }
            });
    }

        function DeleteData(TicketID) {
            var alert = confirm("Are you sure want to Delete");
            if (alert) {
                $.post("@Url.Action("DeleteTicket", "Ticket")", { TicketID: TicketID }, function (data) {
                    var myobj = JSON.parse(data);
                    if (myobj.StatusCode == 200)
                        SuccessAlert("@ViewBag.Title", "Deleted Successfully.");
                    else
                        WarningAlert("@ViewBag.Title", myobj.Message);
                    BindTableData();
                });
            }
    }
    function ClearFields() {
        $('[name="HDID"]').val(null);
        $('[name="TicketSubjectID"]').val(null);
        $('[name="OrderID"]').val(null);
        $('[name="Query"]').val(null);
        $('[name="IsActive"]').val('true');
        $("#btnadd").show();
        $('#btnupdate').hide();
        }


        function BindTableData() {

            $.get("@Url.Action("GetTicketList", "Ticket")", function (data) {
                var myObject = JSON.parse(data);
            var TableDate = [];
            for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(myObject[i].SubjectName);
                //row.push(myObject[i].OrderID);
                row.push(myObject[i].Query);
                if (myObject[i].IsActive == true) {
                    row.push("<span class='badge bg-success float-right'>Closed</span>");
                }
                else if (myObject[i].IsActive == false) {
                    row.push("<span class='badge bg-danger float-right'>Open</span>");
                }
                else if (myObject[i].IsActive == null) {
                    row.push("<span class='badge bg-warning-gradient float-right'>InProgress</span>");
                }
                row.push('<button type="button" class="btn btn-info btn-sm" onclick="GetData(' + myObject[i].TicketID + ')">Edit</button>');
                row.push('<button type="button" class="btn btn-danger btn-sm" onclick="DeleteData(' + myObject[i].TicketID + ')">Delete</button>');
                TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "TicketSubjetName" },
                    { title: "Query " },
                    { title: "Status " },
                    { title: " " },
                    { title: " " },




                ]
            });
                var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
         });
        }

    </script>
</section>








