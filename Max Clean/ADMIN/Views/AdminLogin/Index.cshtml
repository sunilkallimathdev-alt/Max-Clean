
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Login | Company</title>
    <link rel="icon" href="~/CustomFiles/maxclean-logo.png">
    <!-- Tell the browser to be responsive to screen width -->
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <!-- Theme style -->
    <!-- iCheck -->
    <link href="~/CustomFiles/dist/css/adminlte.css" rel="stylesheet" />
    <a href="~/CustomFiles/dist/css/adminlte.css.map">
        <link href="~/CustomFiles/dist/css/loader.css" rel="stylesheet" />
        <link href="~/CustomFiles/dist/css/toastr.min.css" rel="stylesheet" />
        <!-- Google Font: Source Sans Pro -->
        <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">
        <style>
            #buttons {
                padding: 5px;
            }

            .error {
                color: red !important;
            }
        </style>
</head>
<body class="hold-transition login-page">
    <form id="login">
        <div class="login-box">
            <div class="login-logo">
                <a><img height="100" width="200"  src="~/CustomFiles/maxclean-logo.png" /></a>
            </div>
            <!-- /.login-logo -->
            <div class="card">
                <div class="card-body login-card-body">

                    <p class="login-box-msg">Sign in for Back Office Management</p>

                    <div class="form-group has-feedback row">
                        <span class="fa fa-envelope form-control-feedback col-sm-1"></span>
                        <input type="text" name="UserName" placeholder="User Name" autofocus="autofocus"  onkeypress="keyPressListener(event)" class="form-control col-sm-11">
                    </div>
                    <div class="form-group has-feedback row">
                        <span class="fa fa-lock form-control-feedback col-sm-1"></span>
                        <input type="password" name="Password" placeholder="Password"  onkeypress="keyPressListener(event)" class="form-control col-sm-11" maxlength="15">

                    </div>
                    <div class="row">
                        <!-- /.col -->
                        <div class="col-md-6">
                            @*<button type="button" id="btnsubmit1" class="btn btn-info btn-block btn-flat">Forgot Password</button>*@
                        </div>
                        <div class="col-md-6">
                            <button type="button" id="btnsubmit" class="btn btn-success btn-block btn-flat">Sign In</button>
                        </div>
                        <!-- /.col -->
                    </div>
                    <!-- /.social-auth-links -->
                </div>
                <!-- /.login-card-body -->
            </div>
        </div>
    </form>
    <!-- /.login-box -->
    <!-- jQuery -->
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script src="~/CustomFiles/dist/js/toastr.min.js"></script>
    <script>
        function SuccessAlert(Title, Message) {
            toastr.success(Message, Title)
        }
        function WarningAlert(Title, Message) {
            toastr.warning(Message, Title)
        }
        function DangerAlert(Title, Message) {
            toastr.error(Message, Title)
        }

        $('#login').validate({
            rules: {
                UserName: {
                    required: true,
                },
                Password: {
                    required: true,
                },
            }
        });

        var form = $("#login");
        form.validate();

        $(document).ready(function () {

            $("#btnsubmit").click(function () {
                if (form.valid()) {
                    document.getElementById("btnsubmit").disabled = true;
                    var myobj = new Object();
                    myobj.UserName = $('[name="UserName"]').val();
                    myobj.Password = $('[name="Password"]').val();
                    $.post("@Url.Action("AddLogin", "AdminLogin")", { objAdmin: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {
                            //SuccessAlert("@ViewBag.Title", "Login Successfully.");
                            window.location.href = "/Dashboard/Welcome";
                            var obj = Res.ObjectResult.objroles
                            localStorage.setItem('PageDetails', JSON.stringify(obj));
                            localStorage.setItem('RoleID', Res.ObjectResult.objadmin.RoleID);
                        }
                        else {
                            WarningAlert("@ViewBag.Title", "Login Failed");
                            document.getElementById("btnsubmit").disabled = false;
                        }
                    });
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            });

            $("#btnsubmit1").click(function () {
                if ($('[name="UserName"]').val().trim() != "") {
                    var obj = new Object();
                     obj.EmailID = $('[name="UserName"]').val();
                     $.post("@Url.Action("GetForgotPassword", "adminlogin")", { EmailID: JSON.stringify(obj) }, function (data) {
                        var myobj = JSON.parse(data);
                        if (myobj.ObjectResult == true) {
                            SuccessAlert("Login Credentials Sent to your registered email."," ");
                        }
                        else {
                            WarningAlert("We did not find you as a valid user."," ");
                        }
                    });
                }
                else {
                    DangerAlert(" Please Enter valid Email or Mobile No.", "");
                }
            });


           
        });
        function keyPressListener(e) {
            if (e.keyCode == 13) {
                $("#btnsubmit").click();
            }
        }
    </script>
</body>
</html>
