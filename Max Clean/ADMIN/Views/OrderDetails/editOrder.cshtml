function Calculate_Subtotal_TotalPrice(ServiceID, ProductID) {



    var Quantity = ($("#QTY_" + ServiceID + "_" + ProductID).val() != "") ? $("#QTY_" + ServiceID + "_" + ProductID).val() : 0;


    if (Quantity == '' || Quantity == 0) {

        //$("#Q_" + ServiceID + "_" + ProductID).focus();
        DangerAlert("Enter Quantity");
        $("#EPER_" + ServiceID + "_" + ProductID).val(null);
        $("#SBT_" + ServiceID + "_" + ProductID).val(null);
        $("#EPRC_" + ServiceID + "_" + ProductID).val(null);
        $("#TTP_" + ServiceID + "_" + ProductID).val(null);
    } else {
        var UnitPrice = JSON.parse($("#P_" + ServiceID + "_" + ProductID).html());
        var SubTotal = Quantity * UnitPrice;
        var ExtraPercent = ($("#EPER_" + ServiceID + "_" + ProductID).val() != "") ? $("#EPER_" + ServiceID + "_" + ProductID).val() : 0;
        var ExtraPrice = Math.floor((ExtraPercent / 100) * UnitPrice);
        var TotalPrice = SubTotal + ExtraPrice;

        if (Quantity < 0 || ExtraPercent < 0) {
            DangerAlert("Enter value is less than 0");
            if (Quantity < 0)
                $("#QTY_" + ServiceID + "_" + ProductID).val(0);
            if (ExtraPercent < 0)
                $("#EPER_" + ServiceID + "_" + ProductID).val(0);
        } else {
            $("#SBT_" + ServiceID + "_" + ProductID).val(SubTotal);
            $("#EPRC_" + ServiceID + "_" + ProductID).val(ExtraPrice);
            $("#TTP_" + ServiceID + "_" + ProductID).val(TotalPrice);

            if (ExtraPercent == 0) {
                $("#EPER_" + ServiceID + "_" + ProductID).val(0);
            }
        }
    }
}

function CalculateGrandTotal_Balance() {
    ExpressCharge = 0;
    var OldBalance = JSON.parse($("[name=OldBalance]").val());
    var GrandTotal = 0;
    var AmountPaid = JSON.parse($("[name=Paid_Amount]").val());

    for (var i = 0; i < DataToSave.length; i++) {
        GrandTotal += JSON.parse(DataToSave[i][6]);
    }


    if ($("#DeliveryType").html() == "Express Delivery") {
        $('#ExpressDeliveryCharge').val((50 / 100) * GrandTotal);
        ExpressCharge = JSON.parse($('#ExpressDeliveryCharge').val());
        GrandTotal = Math.floor(GrandTotal + ExpressCharge);
        //GrandTotalPrice = (GrandTotalPrice+ 40);
    }
    GrandTotal += OldBalance;

    var Rewards = JSON.parse($("#Reward").val());

    GrandTotal -= Rewards;

    var Promocode_Amount = JSON.parse($("#Promocode_Amount").val());

    GrandTotal -= Promocode_Amount;
    var Delivery_charge = JSON.parse($("#Delivery_charge").val());
    GrandTotal -= Delivery_charge;


    if (AmountPaid > GrandTotal) {
        alert("Advance Amount Is Greater Than Grand Total");
        $("[name=Paid_Amount]").val(0);
        $("[name=BalanceAmount]").val(GrandTotal);
    } else {

        $("[name=BalanceAmount]").val(GrandTotal - AmountPaid);
    }
    $("[name=GrandTotal]").val(GrandTotal);
}

