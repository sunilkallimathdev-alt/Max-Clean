function Calculate(serviceid, productid) {
    GrandTotalPrice = 0;
    var Enter_quant = $('#Q_' + serviceid + "_" + productid).val();

    if (Enter_quant == "")
        Enter_quant = 0;
    else
        Enter_quant = JSON.parse($('#Q_' + serviceid + "_" + productid).val());

    var UnitPrice = JSON.parse($('#P_' + serviceid + "_" + productid).html());
    var ExtraPrices = JSON.parse($('#ER_' + serviceid + '_' + productid).html());
    $('#TP_' + serviceid + "_" + productid).html((Enter_quant * UnitPrice) + ExtraPrices);

    for (var i = 0; i < IDs.length; i++) {
        var price = $('#TP_' + IDs[i].ServiceID + '_' + IDs[i].ProductID).html();
        if (price == "")
            price = 0;
        else
            price = JSON.parse($('#TP_' + IDs[i].ServiceID + '_' + IDs[i].ProductID).html());

        var Extraprice = $('#ER_' + IDs[i].ServiceID + '_' + IDs[i].ProductID).html();
        if (Extraprice == "")
            Extraprice = 0;
        else
            Extraprice = JSON.parse($('#ER_' + IDs[i].ServiceID + '_' + IDs[i].ProductID).html());

        // GrandTotalPrice = (GrandTotalPrice + price + Extraprice);
        GrandTotalPrice = (GrandTotalPrice + price);

    }
    if ($("#DeliveryType").html() == "Express Delivery") {
        $('#ExpressDeliveryCharge').val((50 / 100) * GrandTotalPrice);
        ExpressCharge = JSON.parse($('#ExpressDeliveryCharge').val());
        GrandTotalPrice = Math.floor(GrandTotalPrice + ExpressCharge);
        //GrandTotalPrice = (GrandTotalPrice+ 40);
    }
    else {
        GrandTotalPrice = Math.floor(GrandTotalPrice - ExpressCharge);
    }

    GrandTotalPrice = GrandTotalPrice + JSON.parse($('#OldBalance').val());

    $("#GrandTotal").val(GrandTotalPrice - JSON.parse($("#Reward").val()));
    $("#BalanceAmount").val(Math.floor(GrandTotalPrice - JSON.parse($("#Paid_Amount").val())));

}
