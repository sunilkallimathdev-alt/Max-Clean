        $("#txtrequestorderid").html(myObject.ObjectResult.OrderID);
        $("#txtstorename").html(myObject.ObjectResult.StoreName);
        $("#CustomerName").html(myObject.ObjectResult.CustomerName);
        $("#Updatedby").html(myObject.ObjectResult.Admin_name);
        $("#CustomerMobile").html("<a href='tel:" + myObject.ObjectResult.CustomerMobile + "' style='color: black;'>" + myObject.ObjectResult.CustomerMobile + "</a>");

        $("#txtstoremobileno").html("<a href='tel:" + myObject.ObjectResult.StoreMobileNo + "' style='color: black;'>" + myObject.ObjectResult.StoreMobileNo + "</a>");
        $("#ConfirmedBy").html(myObject.ObjectResult.ConfirmedUser);
        $("#txtorderdate").html(SplitDateTime(myObject.ObjectResult.OrderDate) + "    --  " + SplitTime(myObject.ObjectResult.OrderDate).replace("/", "-").replace("/", "-"));
        $("#Remark").html(myObject.ObjectResult.Remark);
        $("#PickupDate").html(SplitDateTime(myObject.ObjectResult.PickupDate) + "    --  " + myObject.ObjectResult.PickupTime);
        $("#DeliveryDate").html(SplitDateTime(myObject.ObjectResult.ActualDeliveryDate) + "    --  " + myObject.ObjectResult.DeliveryTime);
        $("#OrderStatus").html(myObject.ObjectResult.OrderStatus);
        $("#OrderStatusId").val(myObject.ObjectResult.orderstatusID);
        $("#statusid").val(myObject.ObjectResult.orderstatusID);

        $("#Updateddate").html(SplitDateTime(myObject.ObjectResult.UpdateDate) + "    --  " + SplitTime(myObject.ObjectResult.UpdateDate).replace("/", "-").replace("/", "-"));
            $("#TagNumber").html(myObject.ObjectResult.TagNumber);

        if (myObject.ObjectResult.IsExpressDelivery == true) {
            $("#DeliveryType").html("Express Delivery");
        } else {
            $("#DeliveryType").html("Normal Delivery");
        }

        $("#ExpressDeliveryCharge").val(myObject.ObjectResult.ExpressChargeApplied);
        $("#OldBalance").val(myObject.ObjectResult.OldBalanceApplied);
        if (myObject.ObjectResult.RewardPointsApplied != null)
            $("#Reward").val(myObject.ObjectResult.RewardPointsApplied);
        else
            $("#Reward").val(0);
        $("#PaymentType").html(myObject.ObjectResult.PaymentType)
        if (myObject.ObjectResult.PaymentType == "Card") {
            $("#invoice_div").show();
            $("#Invoice_No").html(myObject.ObjectResult.Invoice_No)
        } else {
            $("#invoice_div").hide();
        }
        $("#Invoice_No").html(myObject.ObjectResult.Invoice_No);
        $("#PickupAddress").html(myObject.ObjectResult.PickupAddress);
        $("#DeliveryAddress").html(myObject.ObjectResult.DeliveryAddress);
        if (myObject.ObjectResult.PaymentStatus == "partial") {
            $("#PaymentStatus").html("Partial");
        }
        else if (myObject.ObjectResult.PaymentStatus == "pending") {
            $("#PaymentStatus").html("Pending");
        }
        else if (myObject.ObjectResult.PaymentStatus == "complete") {
            $("#PaymentStatus").html("Completed");
        }
        if (myObject.ObjectResult.RemainingAmount > 0) {
            $("#pay").show();
        } else {
            $("#pay").hide();
            $("#btnupdate_dlv").hide();
            $("#btnupdate_disc").hide();
        }

        $("#Promocode").val(myObject.ObjectResult.Promocode);
        $("#Promocode_Discount").val(myObject.ObjectResult.Promocode_Discount);
        $("#Promocode_Amount").val(myObject.ObjectResult.Promocode_Amount);
        $("#Delivery_charge").val(myObject.ObjectResult.Delivery_charge);


        if (myObject.ObjectResult.orderstatusID > 2) {

            $("#additems").hide();
            $("#add").hide();
            $('#btnplaceorder').hide();
            $('#PickedbyId').hide();

        } else {
            $("#additems").show();
            $('#btnplaceorder').show();
            $('#PickedbyId').show();
            $("#DeliveredById").hide();

        }

        if (myObject.ObjectResult.orderstatusID < 3) {
            $("#btnNotification").show();
        } else if (myObject.ObjectResult.orderstatusID > 6 && myObject.ObjectResult.orderstatusID < 9) {
            $("#btnNotification").show();
        } else {
            $("#btnNotification").hide();
        }

        if (myObject.ObjectResult.PickedbyID != null) {
            $("#Pickedby").html(myObject.ObjectResult.Pickedby);
            $("#PickedbyId").hide();
        }
        if (myObject.ObjectResult.Delivery_charge > 0) {
            $("#btnupdate_dlv").show();
        } else {
            $("#btnupdate_dlv").hide();
        }
        if (myObject.ObjectResult.orderstatusID > 10) {
            $("#pay").hide();
            $("#btnupdate_dlv").hide();
            $("#btnupdate_disc").hide();
        }
        if (myObject.ObjectResult.DeliveredbyID != null) {
            $("#DeliveredById").hide();
