    function GetRequestOrders(PurchaseOrderByID) {


        $.get("@Url.Action("GetOrdersById", "OrderDetails")", { ID: PurchaseOrderByID }, function (data) {

        TableData = [];
        DataToSave = [];
        IDs = [];
        var myObject = JSON.parse(data);
        $("#GrandTotal").val(myObject.ObjectResult.GrandTotal);
        $("#AdvanceAmount").val(myObject.ObjectResult.Advance_Amount);
        $("#Paid_Amount").val(myObject.ObjectResult.PaidAmount);
        $("#BalanceAmount").val(myObject.ObjectResult.RemainingAmount);
