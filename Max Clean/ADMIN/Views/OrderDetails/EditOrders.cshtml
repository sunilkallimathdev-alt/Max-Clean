                                                                    var DeliveryBoysList = (List
                                                                    <API.Models.DeliveryBoy_Model>
                                                                        )ViewBag.DeliveryBoyList;
                                                                    foreach (var DLB in DeliveryBoysList)
                                                                    {
                                                                        <option value="@DLB.DeliveryBoyID">@DLB.DeliveryBoyName </option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-2">
