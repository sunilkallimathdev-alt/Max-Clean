                var StoreList = (List<API.Models.Store_Model>)ViewBag.StoreList;
                var CategoryList = (List<API.Models.Category_Model>)ViewBag.CategoryList;
                var DeliveryBoys = (List<API.Models.DeliveryBoy_Model>)ViewBag.DeliveryBoys;
                List<API.Models.AdminUser_Model> Adminuserslist = (List<API.Models.AdminUser_Model>)ViewBag.Adminuserlist;
                var ServiceList = (List<API.Models.Service_Model>)ViewBag.ServiceList;
            }
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <button onclick="window.history.back();" class="btn btn-danger btn-sm">Go Back</button>
