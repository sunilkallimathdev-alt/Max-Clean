                                                                    foreach (var DLB in DeliveryBoyList)
                                                                    {
                                                                        <option value="@DLB.DeliveryBoyID">@DLB.DeliveryBoyName </option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-danger edit" id="btnadd">Update OrderDetails</button>
                                        </div>

                                    </div>


                                    <div class="card col-md-12">
                                        <div class="card-header">
                                            <h3 class="card-title">@ViewBag.Title List</h3>
                                        </div>
