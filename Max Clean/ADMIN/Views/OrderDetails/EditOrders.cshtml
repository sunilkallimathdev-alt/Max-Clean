                                                            <label id="Reward"></label>

                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="form-group">
                                                        <h5>Payment Type</h5>
                                                        <div class="callout callout-info" style="background-color:#117a8b21">
                                                            <label id="PaymentType"></label>

                                                        </div>
                                                    </div>
                                                </div>
