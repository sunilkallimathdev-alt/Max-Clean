                                                </div>
                                                <div class="col-md-2">
                                                    <div class="form-group">
                                                        <h5>Order Status </h5>
                                                        <div class="callout callout-info" style="background-color:#117a8b21">
                                                            <label id="OrderStatus"></label>
                                                            @*<select id="OrderStatusId" class="form-control">
                                                                    <option value="">---Select--- </option>
                                                                    @{
                                                                    var OrderStatusList = (List
                                                                    <API.Models.orderCycle_Model>
                                                                        )ViewBag.OrderStatusList;
                                                                        foreach (var cat in OrderStatusList)
                                                                        {
                                                                        <option value="@cat.OrderCycleID">@cat.OrderCycleStage </option>
                                                                        }
                                                                        }
                                                                </select>*@
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-2">
                                                    <div class="form-group">
                                                        <h5>Remark </h5>
                                                        <div class="callout callout-info" style="background-color:#117a8b21">
                                                            <label id="Remark"></label>

                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-2">
                                                    <div class="form-group">
                                                        <h5>Delivered By </h5>
