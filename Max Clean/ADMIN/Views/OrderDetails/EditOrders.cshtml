                                        </div>
                                        <div class="card-body" id="add">


                                            <form id="formvendor">
                                                <div class="row">
                                                    <div class="col-md-12">
                                                        <div class="callout callout-success">
                                                            <div class="row">
                                                                <div class="col-md-2">
                                                                    <div class="form-group">
                                                                        <label>Service<span style="color:red">*</span></label>
                                                                        <select class="form-control" name="ServiceID">
                                                                            <option value="">---Select---</option>
                                                                            @{
                                                                                foreach (var src in ServiceList)
                                                                                {
                                                                                    <option value="@src.ServiceID">@src.ServiceName</option>
                                                                                }
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <div class="form-group">
                                                                        <label>Category Name<span style="color:red">*</span></label>
                                                                        <select class="form-control" name="CategoryID">
                                                                            <option value="">---Select---</option>

                                                                        </select>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <div class="form-group">
                                                                        <label>Product Name<span style="color:red">*</span></label>
                                                                        <select class="form-control" name="ProductID">
                                                                            <option value="">---Select---</option>
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-1">
                                                                    <div class="form-group">
                                                                        <label>Price <span style="color:red"></span></label>
                                                                        <input class="form-control" type="text" name="PricePerKG" readonly onkeypress="return IsNumeric(event)">
                                                                        @*<label name="PricePerKG" class="form-control"></label>*@
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <div class="form-group">
                                                                        <label> Quantities<span style="color:red">*</span></label>
                                                                        <input class="form-control" type="text" name="RequestedQuantity" maxlength="50" onkeypress="return IsNumeric(event)">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-1">
                                                                    <div class="form-group">
                                                                        <label> Extra %<span style="color:red"></span></label>
                                                                        <input class="form-control" type="text" name="Extrapercent" maxlength="10" onkeyup="calculateextraprice()" onkeypress="return IsNumericDecimal(event)">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <div class="form-group">
                                                                        <label> Extra Price<span style="color:red"></span></label>
                                                                        <input class="form-control" type="text" name="ExtraPrice" maxlength="50" readonly onkeypress="return IsNumeric(event)">
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="card-footer">
                                                                <button type="button" class="btn btn-success edit" id="btncartadd">Add to cart</button>
                                                                <button type="button" class="btn btn-danger edit" onclick="Clearall();" id="btnreset">Cancel</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </form>


                                        </div>
                                        <!-- /.card-header -->
                                        <div class="card-body">
                                            <div id="buttons"></div>
                                            <table id="tbl" class="table table-bordered table-striped" style="width:100%"></table>
                                            <button type="button" class="btn btn-success edit" id="btnplaceorder" style="float:right">Place Order</button>

                                        </div>
                                        <!-- /.card-body -->
                                    </div>

                                </div>
                            </div>
                            <span id="hdd"></span>
                            <div class="card-footer">

                                <div class="row col-md-12">
                                    <div class="col-md-3">
                                        <h4 style="float:left">Grand Total: <label id="lblgrandtotal">0.00</label></h4>&nbsp; &nbsp;&nbsp;
                                    </div>
                                    <div class="col-md-3">
                                        <h4 style="float:left">&nbsp;&nbsp;  Paid Amount: <label id="AmountPaid">0.00</label></h4>
                                    </div>
                                    <div class="col-md-2">
                                        <h4 style="float:left">&nbsp;&nbsp;  Balance Amount: <label id="lblBalanceAmount">0.00</label></h4>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="row" id="pay">
                                            <input class="form-control col-md-4" type="text" id="AmtPaid" maxlength="50" onkeyup="calbalance()" onkeypress="return IsNumeric(event)">
                                            &nbsp; &nbsp;<button type="button" class="btn btn-info col-md-4 edit" id="btnPay" style="float:right">Pay Balance</button>
                                        </div>
                                    </div>
                                </div>
                                <input id="statusid" type="hidden" />
                            </div>
                        </div>
                    </form>


                </div>
                <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
