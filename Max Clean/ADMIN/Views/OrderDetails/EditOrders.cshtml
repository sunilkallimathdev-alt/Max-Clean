                                    for (var i = 0; i < DataToSave.length; i++) {
                                        if (DataToSave[i][0] == $("[name=ServiceID]").val() && DataToSave[i][1] == $("[name=ProductID]").val()) {
                                            Dublicate = true
                                            break;
                                        }
                                    }
                                    if (!Dublicate) {
                                        var Trow = [];
                                        Trow.push($("[name=ServiceID] option:selected").text());
                                        Trow.push($("[name=CategoryID] option:selected").text());
                                        Trow.push($("[name=ProductID] option:selected").text());

