
@{
    ViewBag.Title = "Unit";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formunit">
            <div class="card card-info" id="carddiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">ADD @ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Unit Name<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="UnitName" maxlength="100" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                                <div class="form-group">
                                    <label>Unit Scale<span style="color:red">*</span></label>
                                    <input class="form-control" type="text" name="UnitScale" maxlength="20" onkeypress="return IsNumeric(event)">
                                </div>
                            </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Status<span style="color:red">*</span></label>
                                <select class="form-control" name="IsActive">
                                    <option value="true">Active</option>
                                    <option value="false">InActive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" id="btnadd">Add @ViewBag.Title</button>
                    <button type="button" class="btn btn-warning" id="btnupdate">Update @ViewBag.Title</button>
                    <button type="button" class="btn btn-danger" onclick="ClearFields()" id="btnreset">Cancel</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped" style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>
        var tableId = "tbl";

        $('#formunit').validate({
            rules: {
                UnitName: {
                    required: true,
                },
                UnitScale: {
                    number:true,
                    required: true,
                },
                IsActive: {
                    required:true,
                }

            }
        });

        var form = $("#formunit");
        form.validate();
       $(document).ready(function () {
            BindTableData();
            $('#btnupdate').hide();
            $("#btnadd").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.UnitName = $('[name="UnitName"]').val();
                    myobj.UnitScale = $('[name="UnitScale"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    $.post("@Url.Action("AddUnit", "Unit")", { ObjUnit: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {
                            SuccessAlert("@ViewBag.Title", "Added Successfully.");
                            ClearFields();
                            BindTableData();
                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message);
                    });
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }

            });

            $("#btnupdate").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.UnitID = $('[name="HDID"]').val();
                    myobj.UnitName = $('[name="UnitName"]').val();
                    myobj.UnitScale = $('[name="UnitScale"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();
                    $.post("@Url.Action("UpdateUnit", "Unit")", { ObjUnit: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode== 200) {
                            SuccessAlert("@ViewBag.Title", "Updated Successfully.");
                            ClearFields();
                            BindTableData();
                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message);
                    });
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            });
        });
        function GetData(UnitID) {
            $.get("@Url.Action("GetUnit", "Unit")", { UnitID: UnitID }, function (data) {
                var myobj = JSON.parse(data);
                if (myobj.ObjectResult != null) {
                    $('[name="HDID"]').val(myobj.ObjectResult.UnitID);
                    $('[name="UnitName"]').val(myobj.ObjectResult.UnitName);
                    $('[name="UnitScale"]').val(myobj.ObjectResult.UnitScale);
                    if (myobj.ObjectResult.IsActive)
                        $('[name="IsActive"]').val('true');
                    else
                        $('[name="IsActive"]').val('false');
                    OpenCard();
                    $("#btnadd").hide();
                    $('#btnupdate').show();
                }
            });
        }
        function DeleteData(UnitID) {
            var alert = confirm("Are you sure want to Delete");
            if (alert) {
                $.post("@Url.Action("DeleteUnit", "Unit")", { UnitID: UnitID }, function (data) {
                    var Res = JSON.parse(data);
                    if (Res.StatusCode == 200) {
                        SuccessAlert("@ViewBag.Title", "Deleted Successfully.");
                        BindTableData();
                    }
                    else
                        WarningAlert("@ViewBag.Title", Res.Message);
                });
            }

        }
        function ClearFields() {
            $('[name="HDID"]').val(null);
            $('[name="UnitName"]').val(null);
            $('[name="UnitScale"]').val(null);
            $('[name="IsActive"]').val(null);
            $("#btnadd").show();
            $('#btnupdate').hide();

        }
           function BindTableData() {

            $.get("@Url.Action("GetUnitList", "Unit")", function (data) {
                var myObject = JSON.parse(data);
            var TableDate = [];
            for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(myObject[i].UnitName);
                row.push(myObject[i].UnitScale);
                if (myObject[i].IsActive)
                    row.push("<span class='badge bg-success float-right'>Active</span>");
                else
                    row.push("<span class='badge bg-danger float-right'>InActive</span>");
                row.push('<button type="button" class="btn btn-info btn-sm" onclick="GetData(' + myObject[i].UnitID + ')">Edit</button>');
                row.push('<button type="button" class="btn btn-danger btn-sm" onclick="DeleteData(' + myObject[i].UnitID + ')">Delete</button>');
                TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "Unit Name" },
                    { title: "Unit Scale" },
                    { title: "Status " },
                    { title: " " },
                    { title: " " },
                ]
            });
                var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
         });
        }

    </script>
</section>


