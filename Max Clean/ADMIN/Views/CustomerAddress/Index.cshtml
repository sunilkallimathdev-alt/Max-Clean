
@{
    ViewBag.Title = "CustomerAddress";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Home">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formcustomeraddress">
            <div class="card card-info" id="carddiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">ADD @ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Customer Name<span style="color:red">*</span></label>
                                <select name="CustomerID" class="form-control">
                                    <option value="">---Select--- </option>
                                    @{

                                        var CustomerList = (List<API.Models.Customer_Model>)ViewBag.Customer;
                                        foreach (var cat in CustomerList)
                                        {
                                               <option value="@cat.CustomerID">@cat.CustomerName </option>
                                        }
                                     }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Address Type</label>
                                <select class="form-control" name="AddressType">
                                    <option value="">---Select--- </option>
                                    <option value="Home">Home</option>
                                    <option value="Office">Office</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Address</label>
                                <input class="form-control" type="text" name="Address" maxlength="50" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>City<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="City" maxlength="20" onkeypress=" return IsAlphabets(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>State<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="State" maxlength="20" onkeypress="return IsAlphabets(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Country<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="Country" maxlength="20" onkeypress="return IsAlphabets(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>PinCode<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="Pincode" maxlength="6" onkeypress="return IsNumeric(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Latitude <a href="http://www.mapcoordinates.net/en" target="_blank"><span>Get Latitude and Logitude.</span></a></label>
                                <input class="form-control" type="text" name="Latitude" maxlength="20" onkeypress="return IsNumericDecimal(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Longitude</label>
                                <input class="form-control" type="text" name="Longitude" maxlength="20" onkeypress="return IsNumericDecimal(event)">
                            </div>
                        </div>

                         <div class="col-md-3">
                            <div class="form-group">
                                <label>Status<span style="color:red">*</span></label>
                                <select class="form-control" name="IsActive">
                                    <option value="true">Active</option>
                                    <option value="false">InActive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" id="btnadd">Add @ViewBag.Title</button>
                    <button type="button" class="btn btn-warning" id="btnupdate">Update @ViewBag.Title</button>
                    <button type="button" class="btn btn-danger" id="btnreset" onclick="ClearFields()">Cancel</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped " style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <div>
        <script>


        var tableId = "tbl";

            $('#formcustomeraddress').validate({
            rules: {
                CustomerID: {
                    required: true,
                },
                AddressType: {
                    required: true,
                },
                Address: {
                    required: false,
                },
                City: {
                    required: true,
                },
                State: {
                    required: true,
                },
                Country: {
                    required: true,
                },
                Pincode: {
                    digits: true,
                    required: true,
                },
                Latitude: {
                    required: false,
                },
                Longitude: {
                    required: false,
                },

            }
        });

        var form = $("#formcustomeraddress");
        form.validate();

        $(document).ready(function () {
            BindTableData();
            $('#btnupdate').hide();
            $("#btnadd").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.CustomerID = $('[name="CustomerID"]').val();
                    myobj.AddressType = $('[name="AddressType"]').val();
                    myobj.Address = $('[name="Address"]').val();
                    myobj.City = $('[name="City"]').val();
                    myobj.State = $('[name="State"]').val();
                    myobj.Country = $('[name="Country"]').val();
                    myobj.Pincode = $('[name="Pincode"]').val();
                    myobj.Latitude = $('[name="Latitude"]').val();
                    myobj.Longitude = $('[name="Longitude"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    setTimeout(function () {
                        $.post("@Url.Action("AddCustomerAddress", "CustomerAddress")", { ObjCustomerAddress: JSON.stringify(myobj) }, function (data) {
                            var Res = JSON.parse(data);
                            if (Res.StatusCode == 200) {
                                BindTableData();
                                SuccessAlert("@ViewBag.Title", "Added Successfully.");
                                ClearFields();
                            }
                            else
                                WarningAlert("@ViewBag.Title", Res.Message);
                        })
                    },2000);
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            });

            $("#btnupdate").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.CUstomerAddressID = $('[name="HDID"]').val();
                    myobj.CustomerID = $('[name="CustomerID"]').val();
                    myobj.AddressType = $('[name="AddressType"]').val();
                    myobj.Address = $('[name="Address"]').val();    
                    myobj.City = $('[name="City"]').val();
                    myobj.State = $('[name="State"]').val();
                    myobj.Country = $('[name="Country"]').val();
                    myobj.Pincode = $('[name="Pincode"]').val();
                    myobj.Latitude = $('[name="Latitude"]').val();
                    myobj.Longitude = $('[name="Longitude"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    setTimeout(function () {
                        $.post("@Url.Action("UpdateCustomerAddress", "CustomerAddress")", { ObjCustomerAddress: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {
                            SuccessAlert("@ViewBag.Title", "Updated Successfully.");
                            BindTableData();
                            ClearFields();
                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message );
                    })
                    }, 2000);
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            })
        });

        function GetData(CUstomerAddressID) {

            $.get("@Url.Action("GetCustomerAddress", "CustomerAddress")", { CUstomerAddressID: CUstomerAddressID }, function (data) {
                ClearFields();
                var myobj = JSON.parse(data);
                if (myobj.ObjectResult != null) {
                    $('[name="HDID"]').val(myobj.ObjectResult.CUstomerAddressID);
                    $('[name="CustomerID"]').val(myobj.ObjectResult.CustomerID);
                    $('[name="CustomerName"]').val(myobj.ObjectResult.CustomerName);
                    $('[name="Address"]').val(myobj.ObjectResult.Address);
                    $('[name="AddressType"]').val(myobj.ObjectResult.AddressType);
                    $('[name="City"]').val(myobj.ObjectResult.City);
                    $('[name="State"]').val(myobj.ObjectResult.State);
                    $('[name="Country"]').val(myobj.ObjectResult.Country);
                    $('[name="Pincode"]').val(myobj.ObjectResult.Pincode);
                    $('[name="Latitude"]').val(myobj.ObjectResult.Latitude);
                    $('[name="Longitude"]').val(myobj.ObjectResult.Longitude);
                    if (myobj.ObjectResult.IsActive)
                        $('[name="IsActive"]').val('true');
                    else
                        $('[name="IsActive"]').val('false');
                    OpenCard();
                    $('#btnupdate').show();
                    $('#btnadd').hide();

                }
                else {
                    DangerAlert(" ", "Failed to get data.");
                }
            });
        }

        function DeleteData(CUstomerAddressID) {
            var alert = confirm("Are you sure want to Delete");
            if (alert) {
                $.post("@Url.Action("DeleteCustomerAddress", "CustomerAddress")", { CUstomerAddressID: CUstomerAddressID }, function (data) {
                    var myobj = JSON.parse(data);
                    if (myobj.StatusCode == 200) {
                        SuccessAlert("@ViewBag.Title", "Deleted Successfully.");
                        BindTableData();
                    }
                    else
                        WarningAlert("@ViewBag.Title", myobj.Message);
                });
            }
        }
        function ClearFields() {
            $('[name="HDID"]').val(null);
            $('[name="CustomerName"]').val(null);
            $('[name="AddressType"]').val(null);
            $('[name="Address"]').val(null);
            $('[name="City"]').val(null);
            $('[name="State"]').val(null);
            $('[name="Country"]').val(null);
            $('[name="Pincode"]').val(null);
            $('[name="Latitude"]').val(null);
            $('[name="Longitude"]').val(null);


            $('[name="IsActive"]').val('true');
            $('#btnupdate').hide();
            $('#btnadd').show();
        }

        function BindTableData() {
            $.get("@Url.Action("GetCustomerAddressList", "CustomerAddress")", function (data) {
                var myObject = JSON.parse(data);
                var TableDate = [];
                for (var i = 0; i < myObject.length; i++) {
                    var row = [];
                    row.push(myObject[i].CustomerName);
                    row.push(myObject[i].Address);
                    row.push(myObject[i].Country);
                    row.push(myObject[i].Pincode);
                    if (myObject[i].IsActive)
                        row.push("<span class='badge bg-success float-right'>Active</span>");
                    else
                        row.push("<span class='badge bg-danger float-right'>InActive</span>");
                    row.push('<button type="button" class="btn btn-info btn-sm" onclick="GetData(' + myObject[i].CUstomerAddressID + ')">Edit</button>');
                    row.push('<button type="button" class="btn btn-danger btn-sm" onclick="DeleteData(' + myObject[i].CUstomerAddressID + ')">Delete</button>');
                    TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "CustomerName" },
                    { title: "Address" },
                    { title: "Country" },
                    { title: "Pincode" },
                    { title: "IsActive " },
                    { title: " " },
                    { title: " " },
                ]
            });
                var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
         });
        }

        </script>
    </div>

</section>
