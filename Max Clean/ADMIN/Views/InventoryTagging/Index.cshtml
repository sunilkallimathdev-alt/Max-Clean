@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using API.Models;
@using ADMIN.API_Repository;
@using API.DataAccess;
@{
    ViewBag.Title = "Tagging";
}


<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Dashboard/Welcome">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formcustomer">
            <div class="card card-info" id="carddiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">@ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">

                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Tag Number : <span style="color:red"></span></label>
                                @{
                                    try
                                    {
                                        using (maxcleanEntities Context = new maxcleanEntities())
                                        {
                                            var Count = Context.t_taggs.Select(a => a.tag_id).Count() + 1;

                                            <label id="tagnum">TAG @Count</label>
                                        }
                                    }
                                    catch (Exception ex) { throw ex; }
                                }
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="callout callout-success">
                                <div class="row" id="Nontagged">


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" id="btnadd">Tagg</button>
                   
                    <button type="button" class="btn btn-danger" onclick="ClearFields()" id="btnreset">Cancel</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped" style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>


        var tableId = "tbl";

        $('#formcustomer').validate({
            rules: {
                Name: {
                    required: true,
                },

            }
        });

        var form = $("#formcustomer");
        form.validate();

        $(document).ready(function () {
            BindTableData();
            GetData();
           
            $("#btnadd").click(function () {
                var myobj = new Object();
                myobj.Orders = [];
                myobj.TagNumber = $("#tagnum").html();
                
                $("input:checkbox").each(function () {
                    var $this = $(this);

                    if ($this.is(":checked")) {
                        var obj = new Object();
                        obj.OrdID = $this.attr("id");
                        myobj.Orders.push(obj);
                    }
                });
                
                $.post("@Url.Action("AddTag", "InventoryTagging")", { objTag: JSON.stringify(myobj) }, function (data) {

                             var Res = JSON.parse(data);
                                 if (Res.StatusCode == 200) {
                                     BindTableData();
                                     GetData();
                                 SuccessAlert("@ViewBag.Title", " Successfully.");
                                 location.reload();
                                ClearFields();
                                }
                                else
                                 WarningAlert("@ViewBag.Title", Res.Message);

                })
            });


        });



    function GetData() {

        $.get("@Url.Action("GetNonTagged", "InventoryTagging")",function (data) {

            var myobj = JSON.parse(data);
            var str = "";
            if (myobj != null) {
                for (var i = 0; i < myobj.length; i++) {
                    str +="<div class='col-md-3'>"
                    str +="<div class='form-group'>"
                    str += "<label><input id='" + myobj[i].OrderID + "' type='checkbox' />OrderID  " + myobj[i].OrderID + " / " + myobj[i].CustomerName + "/" + SplitDateTime(myobj[i].OrderDate).replace("/", "-").replace("/", "-") +"  </label>"
                    str +="</div>"
                    str +="</div>"
                }
                $("#Nontagged").html(str);
            }
            else {
                DangerAlert(" ", "Failed to get data.");
            }
        });
    }



function ClearFields() {

    $('input[type="checkbox"]:checked').prop('checked', false);
}

function BindTableData() {


$.get("@Url.Action("GetTags", "InventoryTagging")", function (data) {
            
            var myObject = JSON.parse(data);
            var TableDate = [];
            for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(i + 1);
                row.push(myObject[i].TagNumber);
                //row.push(myObject[i].TaggedDate);
                row.push(SplitDateTime(myObject[i].TaggedDate).replace("/", "-").replace("/", "-"));
                var str = "";
                for (var j = 0; j < myObject[i].Orders.length; j++) {
                    str += myObject[i].Orders[j].OrdID + ",";
                }
                row.push(str);
                TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "Sl no" },
                    { title: "Tag Number" },

                    { title: "Taged Date" },
                    { title: "Orders" },


                ]
            });
            hideshowbuttons();
            var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
            $('.buttons-html5').addClass('btn btn-default btn-sm');
        });
    }

    </script>

</section>


