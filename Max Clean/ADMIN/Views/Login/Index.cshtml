<script>
    //setTimeout(function () { $('body').css('zoom', '80%')}, 2000);
    $('#loader-wrapper').css('display', 'none');
    $(document).ajaxStart(function () {
        $('#loader-wrapper').css('display', 'block');
    }).ajaxStop(function () {
        $('#loader-wrapper').css('display', 'none');
    });

    $(function () {
        //Initialize Select2 Elements
        $('.select2').select2();
        CloseCard();
    });
    function OpenCard() {
        $('#carddiv').removeClass('collapsed-card');
        $('html, body').animate({ scrollTop: 0 }, 'fast');
    }
    function CloseCard() {
        $('#carddiv').addClass('collapsed-card');
    }
    function SuccessAlert(Title, Message) {
        toastr.success(Message, Title)
    }
    function WarningAlert(Title, Message) {
        toastr.warning(Message, Title)
    }
    function DangerAlert(Title, Message) {
        toastr.error(Message, Title)
    }

</script>

<script>
            $(function () {
                $('input').iCheck({
                    checkboxClass: 'icheckbox_square-blue',
                    radioClass: 'iradio_square-blue',
                    increaseArea: '20%' // optional
                })
            })

            $(document).ready(function () {

            });

            function keyPressListener(e) {
                if (e.keyCode == 13) {
                    SignIn();
                }
            }

            function SignIn() {
                document.getElementById("btnsubmit").disabled = true;
                var UserName = $('#Username').val();
                var Password = $('#Password').val();
                if (UserName != "" && Password != "") {
                    var myobject = new Object();
                    myobject.UserName = UserName;
                    myobject.EmailId = UserName;
                    myobject.Password = Password;

                    $.post("@Url.Action("Login", "Login")", { objlogin: myobject }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res != null) {
                            sessionStorage.setItem('LoginID', JSON.stringify(Res.UserID));
                            sessionStorage.setItem('RoleID', JSON.stringify(Res.RoleID));
                            document.cookie = "LoginID=" + JSON.stringify(Res.UserID) + "";
                            document.cookie = "RoleID=" + JSON.stringify(Res.RoleID) + "";
                            window.location.href = "/category/index";
                        }
                        else {
                            alert('Invalid Username or Password');
                            document.getElementById("btnsubmit").disabled = false;
                        }
                    })


                }
            }
                //else {
                //    alert("Please Enter Username and Password");
                //    document.getElementById("btnsubmit").disabled = false;
                //}


</script>
