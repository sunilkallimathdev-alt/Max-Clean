        function BindTableData() {

                  var myobj = new Object();
            myobj.FromDate = $('[name="FromDate"]').val();
            myobj.StoreID = $("#storeID").val();
            myobj.ToDate = $('[name="ToDate"]').val();
            myobj.OrderStatusID = $('[name=StatusID]').val();
            myobj.Reports = 1;

        $.get("@Url.Action("GetOrders", "Reports")", { Obj: JSON.stringify(myobj) }, function (data) {
                var myObject = JSON.parse(data);
            var TableDate = [];
            for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(myObject[i].Store_code + "-" + myObject[i].OrderID);
                row.push(myObject[i].CustomerName);
                row.push(myObject[i].StoreName);
                row.push(SplitDateTime(myObject[i].ExpectingDeliveryDate) + "    --  " + myObject[i].DeliveryTime);
                row.push(myObject[i].GrandTotal);




                //row.push(myObject.Result[i].GrandTotal);
                //row.push(myObject.Result[i].PaidAmount);
                //row.push(myObject.Result[i].RemainingAmount);


                //row.push('<button type="button" class="btn btn-info btn-sm" onclick="SaveID(' + myObject.Result[i].OrderID + ')">View Details</button>');
                //row.push('<button type="button" class="btn btn-danger btn-sm" onclick="DeleteData(' + myObject[i].CategoryId + ')">Delete</button>');
                TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "Order ID" },
                    { title: "Customer Name" },
                    { title: "StoreName" },
                    { title: "Delivery Date" },
                    { title: "Total Price" },

                ]
            });
