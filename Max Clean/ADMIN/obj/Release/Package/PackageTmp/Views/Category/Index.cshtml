        function BindTableData() {

            $("#" + tableId).DataTable({
            "processing": true, // for show progress bar
            "serverSide": true, // for process server side
            "filter": true, // this is for disable filter (search box)
            "orderMulti": false, // for disable multiple column at once
            "srolly": true,
            "destroy": true,
            "responsive": true,
            "ajax": {
                "url": "/Category/LoadData",
                "type": "POST",
                "datatype": "json",
                "filter": true,
                "scroll": "true",
                "searching": true,
            },
            "columns": [
                { "data": "CategoryName", "name": "CategoryName", "autoWidth": true },
                { "data": "DisplayOrder", "name": "DisplayOrder", "autoWidth": true },
                 {
                     "render": function (data, type, full, meta) {
                         if (full.IsActive)
                             return '<span class="badge bg-success float-right">Active</span>';
                         else
                             return '<span class="badge bg-danger float-right">InActive</span>';
                    }
                },
                {
                    "render": function (data, type, full, meta) {
                        if (isAddEnabled)
                            return '<button type="button" class="btn btn-info btn-sm edit" onclick="GetData(' + full.CategoryId + ')">Edit</button>';
                        return '';
                    }
                },
            ],
            "aoColumnDefs": [
                {
                    bSortable: false,
                    aTargets: [-1, -2]
                },
                {
                    searchable: true,
                    aTargets: [1]
                }
            ]

        });
        }

    </script>

</section>

