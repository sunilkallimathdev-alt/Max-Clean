
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using API.Models;
@using ADMIN.API_Repository;

@{
    ViewBag.Title = "Petty Cash Utilization";
}



<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Dashboard/Welcome">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
@{ var StoreList = (List<API.Models.Store_Model>)ViewBag.StoreList; }
<section class="content">
    <div class="container-fluid">
        <form id="PettyCash">
            <div class="card card-info">
                <div class="card-header">
                    <h3 class="card-title"> @ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-5">

                            <div class="form-group">
                                <label>Store Name<span style="color:red">*</span></label>
                                <select class="form-control" name="StoreID" id="StoreID" onchange="BindTableDatas()">

                                    @{
                                        try
                                        {
                                            var user = JsonConvert.DeserializeObject<API.Models.AdminUser_Model>(Session["logindetails"].ToString());

                                            if (user.StoreID != null)
                                            {
                                                foreach (var str in StoreList)
                                                {
                                                    if (user.StoreID == @str.StoreID)
                                                    {
                                                        <option value="@str.StoreID">@str.StoreName</option>
                                                        break;
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <option value="0">---Select---</option>
                                                foreach (var str in StoreList)
                                                {
                                                    <option value="@str.StoreID">@str.StoreName</option>
                                                }
                                            }
                                        }
                                        catch (Exception ex)
                                        {
                                            throw ex;
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-5 " style="padding-top:32px">
                            <label style="font-size:18px" id="lblBalanceText"> Balance : </label> <label class="lbl" id="lbl1" style="font-size:18px"> </label>
                        </div>
                    </div>
                </div>
              
            </div>
        </form>
    </div>
    <div id="hidegrid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">@ViewBag.Title </h3>
            </div>
            <!-- /.card-header -->
            <div class="card-body">
                <div id="buttons"></div>
                <table id="tbl" class="table table-bordered table-striped" style="width:100%"></table>
            </div>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>

        var tableId = "tbl";


        $(document).ready(function () {
            BindTableDatas();

            $("#hidegrid").hide();

            $('#StoreID').change(function () {

                if ($('#StoreID').val() != '0') {
                    $("#hidegrid").show();
                }
                else {
                    $("#hidegrid").hide();
                }
            });

        });
       

        $("#StoreID").click(function () {

        });


          

        function BindTableDatas() {
           var myobj = new Object();
           myobj.Store_Id = $("#StoreID").val();
          //  var Store_Id = $("#StoreID").val();
            var intstoreid = parseInt(myobj.Store_Id);
            $.post("@Url.Action("GetPCashUtilizationList", "PCashUtilization")", { Store_Id: JSON.stringify(myobj) }, function (data) {
                var myObject = JSON.parse(data);
                var stid = parseInt($("#StoreID").val());

                if ($.isNumeric(stid) == false) {

                    $('#lbl1').text("");
                    $('#lblBalanceText').text("");
                } else {
                    if ($.isNumeric(intstoreid)) {
                        if (myObject.length != 0) {

                            if ((myObject[0].BalanceAmount) <= 1000) {
                                $('#lblBalanceText').text("Balance : ");
                                $('#lbl1').css({ "color": "red" });
                                $('#lbl1').text(myObject[0].BalanceAmount);

                            } else {
                                $('#lblBalanceText').text("Balance : ");
                                $('#lbl1').css({ "color": "MediumSeaGreen" });
                                $('#lbl1').text(myObject[0].BalanceAmount);
                            }

                        } else {
                            $('#lbl1').text("");
                            $('#lblBalanceText').text("");

                        }

                    } else {
                        $('#lbl1').text("");
                        $('#lblBalanceText').text("");
                    }
                }
                //added
                var TableDate = [];
                for (var i = 0; i < myObject.length; i++) {
                    var row = [];
                    row.push( myObject[i].Pdate);
                    row.push( myObject[i].Reason );
                    row.push(myObject[i].CreditedAmount);
                    row.push(myObject[i].DebitedAmount );                  
                    row.push(myObject[i].BalanceAmount );

                    TableDate.push(row);
                }
                $('#' + tableId).DataTable({
                    destroy: true,
                    data: TableDate,
                    scrollX: true,
                    responsive: true,
                    order: [[0, "desc"]],
                    columns: [
                      
                        { title: "Date" },
                        { title: "Note" },
                        { title: "Credit"},
                        { title: "Debit"},
                        { title: "Balance"},
                    ],
                    "aoColumnDefs": [

                        { className: 'text-right', targets: [2,3,4] },
                        { className: 'text-center', targets: [0] },
                        { width: "10%", targets: [0, 2, 3, 4] }, { width: "60%", targets: [1] },
                        { bSortable: false, "aTargets": [ 1, 2, 3,4] }, 
                    ]
                });
                hideshowbuttons();
                var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                    buttons: [
                        'copyHtml5',
                        'excelHtml5',
                        'csvHtml5',
                        'pdfHtml5'

                    ]
                }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
            });
        }


    </script>
</section>

