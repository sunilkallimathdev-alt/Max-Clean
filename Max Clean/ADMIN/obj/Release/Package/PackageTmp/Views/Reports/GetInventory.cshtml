@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using API.Models;
@{
    ViewBag.Title = "Inventory";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Dashboard/Welcome">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formgetinventoy">
            <div class="card card-info" id="cardiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">@ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>From Date<span style="color:red">*</span></label>
                                <input class="form-control" type="date" name="FromDate" onkeypress="return Date(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>To Date<span style="color:red">*</span></label>
                                <input class="form-control" type="date" name="ToDate" onkeypress="return Date(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Store Name<span style="color:red">*</span></label>
                                <select class="form-control" name="StoreID">
                                    @{
                                        var StoreList = (List<API.Models.Store_Model>)ViewBag.StoreList;

                                        try
                                        {
                                            var user = JsonConvert.DeserializeObject<API.Models.AdminUser_Model>(Session["logindetails"].ToString());

                                            if (user.StoreID != null)
                                            {
                                                foreach (var str in StoreList)
                                                {
                                                    if (user.StoreID == @str.StoreID)
                                                    {
                                                        <option value="@str.StoreID">@str.StoreName</option>
                                                        break;
                                                    }
                                                }
                                            }
                                            else
                                            {
                                                <option value="">---Display All---</option>
                                                foreach (var str in StoreList)
                                                {
                                                    <option value="@str.StoreID">@str.StoreName</option>
                                                }
                                            }
                                        }
                                        catch (Exception ex)
                                        {
                                            throw ex;
                                        }
                                    }



                                </select>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" onclick="BindTableData();" id="btnupdate">Submit</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped " style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>

        var tableId = "tbl";

        $('#formgetinventoy').validate({
            rules: {
                //FromDate: {
                //    required: false,
                //},
                //ToDate: {
                //    required: false,
                //},
                StoreName: {
                    required: false,
                },


            }
        });

        var form = $("#formgetinventoy");
        form.validate();


        $(document).ready(function () {
            BindTableData();

        });

     function BindTableData() {


                var StoreID = $('[name="StoreID"]').val();

         if (StoreID == "") {
             StoreID = 0;

                }


         var myobj = new Object();
         myobj.StoreID = StoreID;
                  myobj.FromDate = $('[name="FromDate"]').val();
            myobj.ToDate = $('[name="ToDate"]').val();
            myobj.OrderStatusID = 8;
            myobj.Reports = 1;

        $.get("@Url.Action("GetOrders", "Reports")", { Obj: JSON.stringify(myobj) }, function (data) {
                var myObject = JSON.parse(data);
            var TableDate = [];
            for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(myObject.Result[i].Store_code + "-" + myObject.Result[i].OrderID);
                row.push(SplitDateTime(myObject[i].OrderDate));
                row.push(myObject[i].CustomerName + " / " + myObject[i].CustomerMobile);
                row.push(SplitDateTime(myObject[i].ExpectingDeliveryDate) + "    --  " + myObject[i].DeliveryTime);
                row.push(myObject[i].GrandTotal);
                row.push('<button type="button" class="btn btn-info btn-sm" onclick="SaveID(' + myObject[i].OrderID + ')">View Details</button>');
                TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "Order ID" },
                    { title: "Order Date" },
                    { title: "Customer Name" },
                    { title: "Delivery Date" },
                    { title: "Total Price" },
                    { title: "" },
                ]
            });
            var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
        });
    }
        function SaveID(ID) {                                       //orderdetails loni function edi gurthupettuko
            var POID = ID;
            localStorage.setItem("POID", ID);


            window.location.href = "/OrderDetails/Index";
        }
    </script>

</section>

