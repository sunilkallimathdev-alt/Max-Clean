        function ClearFields() {
            $('[name="HDID"]').val(null);
            $('[name="CustomerName"]').val(null);
            $('[name="StoreName"]').val(null);
            $('[name="DeliveryTime"]').val(null);

        }
        function SaveID(ID) {
            var POID = ID;
            localStorage.setItem("POID", ID);


            window.location.href = "/OrderDetails/Index";
        }
        function BindTableData() {
            var myobj = new Object();
            myobj.StoreID = $("#storeID").val();
            myobj.FromDate = $('[name="FromDate"]').val();
            myobj.ToDate = $('[name="ToDate"]').val();




            $.get("@Url.Action("GetAllOrders", "AllOrders")", { Obj: JSON.stringify(myobj) }, function (data) {
                var myObject = JSON.parse(data);
                var TableDate = [];
                for (var i = 0; i < myObject.Result.length; i++) {
                    var row = [];
                    row.push(myObject.Result[i].Store_code + "-" + myObject.Result[i].OrderID);
                    row.push(myObject.Result[i].CustomerName);
                    row.push(myObject.Result[i].StoreName);
                    // row.push(SplitDateTime(myObject.Result[i].ActualDeliveryDate) + "    --  " + SplitTime(myObject.Result[i].ActualDeliveryDate).replace("/", "-").replace("/", "-"));
                    row.push(SplitDateTime(myObject.Result[i].ActualDeliveryDate));
                    row.push(myObject.Result[i].PaymentType);
                    row.push(myObject.Result[i].Invoice_No);

                    // $("#DeliveryTime").html(SplitDateTime(myObject.ObjectResult.ActualDeliveryDate) + "    --  " + SplitTime(myObject.ObjectResult.ActualDeliveryDate).replace("/", "-").replace("/", "-"));

                    row.push('<button type="button" class="btn btn-info btn-sm" onclick="SaveID(' + myObject.Result[i].OrderID + ')">View Details</button>');
                    //row.push('<button type="button" class="btn btn-danger btn-sm" onclick="DeleteData(' + myObject[i].CategoryId + ')">Delete</button>');
                    TableDate.push(row);
                }
                $('#' + tableId).DataTable({
                    destroy: true,
                    data: TableDate,
                    scrollX: true,
                    order: [[0, "desc"]],
                    columns: [
                        { title: "Order ID" },
                        { title: "Customer Name" },
                        { title: "Store Name" },
                        { title: "Delivery Date" },
                        { title: "Payment Type" },
                        { title: "Invoice No." },
                        //{ title: "Status " },
                        //{ title: " " },
                        { title: " " },
                    ]
                });
                var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                    buttons: [
                        'copyHtml5',
                        'excelHtml5',
                        'csvHtml5',
                        'pdfHtml5'

                    ]
                }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
            });
        }

