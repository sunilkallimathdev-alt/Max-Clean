@{
    ViewBag.Title = "Delivery Boy";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Dashboard/Welcome">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formcustomer">
            <div class="card card-info" id="carddiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">ADD @ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Name<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="Name" maxlength="100" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>EmailID<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="EmailID" maxlength="100" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Mobile Number<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="MobileNumber" maxlength="10" onkeypress="return IsNumeric(event)">
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Password<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="Password" maxlength="10" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="CategoryIcon">Image<span style="color:red">*</span></label>
                                <input class="form-control" type="file" accept="image/*" name="Image">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Address<span style="color:red">*</span></label>
                                <textarea class="form-control" type="text" name="Address" maxlength="700" onkeypress="return NotanHTML(event)"></textarea>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>License Number<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="LicenseNumber" maxlength="20" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Vehicle Number<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="VehicleNumber" maxlength="20" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        
                        <div class=" col-md-3">
                            <div class="form-group" id="DeliveryBoyImage">

                            </div>
                        </div>


                        <div class="col-md-3">
                            <div class="form">
                                <label>Languages Known</label>
                                <div>
                                    <label><input type="checkbox" class="chk" id="Kannada"> Kannada</label>
                                </div>
                                <div>
                                    <label><input type="checkbox" class="chk" id="Hindi"> Hindi</label>
                                </div>
                                <div>
                                    <label><input type="checkbox" class="chk" id="English"> English</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Status<span style="color:red">*</span></label>
                                <select class="form-control" name="IsActive">
                                    <option value="true">Active</option>
                                    <option value="false">InActive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" id="btnadd">Add @ViewBag.Title</button>
                    <button type="button" class="btn btn-warning" id="btnupdate">Update @ViewBag.Title</button>
                    <button type="button" class="btn btn-danger" onclick="ClearFields()" id="btnreset">Cancel</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped" style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>


        var tableId = "tbl";

        $('#formcustomer').validate({
            rules: {
                Name: {
                    required: true,
                },
                EmailID: {
                    email: true,
                    required: true,
                },
                MobileNumber: {
                    digits: true,
                    minlength: 10,
                    maxlength: 15,
                    required: true,
                },
                LicenseNumber: {

                    maxlength: 50,
                    required: true,
                },
                VehicleNumber: {

                    maxlength: 50,
                    required: true,
                },
                Password: {
                    required: true,
                },
                Image: {
                    extension: "jpg,jpeg,png",
                    filesize: 2097152,
                    required: {
                        depends: function () {
                            return $('[name="HDID"]').val() == null;
                        }
                    }
                },
                Address: {
                    required: true,
                },

            }
        });

        var form = $("#formcustomer");
        form.validate();

        $(document).ready(function () {
            BindTableData();
            $('#btnupdate').hide();
            $("#btnadd").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.DeliveryBoyName = $('[name="Name"]').val();
                    myobj.DeliveryBoyEmailID = $('[name="EmailID"]').val();
                    myobj.DeliveryBoyMobileNumber = $('[name="MobileNumber"]').val();
                    myobj.Address = $('[name="Address"]').val();
                    myobj.Licence_No = $('[name="LicenseNumber"]').val();
                    myobj.Vehicle_No = $('[name="VehicleNumber"]').val();
                    myobj.Password = $('[name="Password"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();
                    myobj.is_login = 1;
                    if ($('[name="Image"]').val() != "") {
                        readFile($('[name="Image"]')[0].files[0], function (e) {
                            myobj.Image = e.target.result;
                        });
                    }
                    var languages = '';
                    if ($('#Kannada').is(':checked')) {
                        languages += "Kannada" + ",";
                    }
                    if ($('#Hindi').is(':checked')) {
                        languages += "Hindi" + ",";
                    }
                    if ($('#English').is(':checked')) {
                        languages += "English";
                    }

                    //**//
                    var lastChar = languages[languages.length - 1];
                    if (lastChar == ",") {
                        languages = languages.slice(0, -1)
                    }
                    else {
                        languages = languages;
                    }



                    //**//

                    myobj.Languages = languages;
                    setTimeout(function () {
                        /**/
                        $.post("@Url.Action("AddDeliveryBoy", "DeliveryBoy")", { ObjDeliveryBoy: JSON.stringify(myobj) }, function (data) {
            /**/
            var Res = JSON.parse(data);
            if (Res.StatusCode == 200) {
                BindTableData();
                /**/
                SuccessAlert("@ViewBag.Title", "Added Successfully.");
        /**/
        ClearFields();
    }
    else
        /**/
        WarningAlert("@ViewBag.Title", Res.Message);
    /**/
})
}, 2000);
}
else {
DangerAlert(" ", "Recheck the fields.");
}
});

$("#btnupdate").click(function () {
if (form.valid()) {
var myobj = new Object();
myobj.DeliveryBoyID = $('[name="HDID"]').val();
myobj.DeliveryBoyName = $('[name="Name"]').val();
myobj.DeliveryBoyEmailID = $('[name="EmailID"]').val();
myobj.DeliveryBoyMobileNumber = $('[name="MobileNumber"]').val();
myobj.Address = $('[name="Address"]').val();
myobj.Licence_No = $('[name="LicenseNumber"]').val();
myobj.Vehicle_No = $('[name="VehicleNumber"]').val();
myobj.Password = $('[name="Password"]').val();
myobj.IsActive = $('[name="IsActive"]').val();
if ($('[name="Image"]').val() != "") {
readFile($('[name="Image"]')[0].files[0], function (e) {
    myobj.Image = e.target.result;
});
}
var languages = '';
if ($('#Kannada').is(':checked')) {
languages += "Kannada" + ",";
}
    if ($('#Hindi').is(':checked')) {
        languages += "Hindi" + ",";
}
if ($('#English').is(':checked')) {
languages += "English";
    }
    //**//
   
    var lastChar = languages[languages.length - 1];
    if (lastChar == ",") {
        languages = languages.slice(0, -1)
    }
    else {
        languages = languages;
    }

    //**//
myobj.Languages = languages;

setTimeout(function () {
/**/
$.post("@Url.Action("UpdateDeliveryBoy", "DeliveryBoy")", { ObjDeliveryBoy: JSON.stringify(myobj) }, function (data) {
            /**/
            var Res = JSON.parse(data);
            if (Res.StatusCode == 200) {
                /**/
                SuccessAlert("@ViewBag.Title", "Updated Successfully.");
        /**/
        BindTableData();
        ClearFields();
    }
    else
        /**/
        WarningAlert("@ViewBag.Title", Res.Message);
    /**/
})
}, 2000);
}
else {
DangerAlert(" ", "Recheck the fields.");
}
})
});

function GetData(DeliveryBoyID) {

/**/
$.get("@Url.Action("GetDeliveryBoy", "DeliveryBoy")", { DeliveryBoyID: DeliveryBoyID }, function (data) {
            /**/
            ClearFields();
            var myobj = JSON.parse(data);
            if (myobj.ObjectResult != null) {
                $('[name="HDID"]').val(myobj.ObjectResult.DeliveryBoyID);
                $('[name="Name"]').val(myobj.ObjectResult.DeliveryBoyName);
                $('[name="MobileNumber"]').val(myobj.ObjectResult.DeliveryBoyMobileNumber);
                $('[name="LicenseNumber"]').val(myobj.ObjectResult.Licence_No);
                $('[name="VehicleNumber"]').val(myobj.ObjectResult.Vehicle_No);

                $('#DeliveryBoyImage').html("<img src='" + myobj.ObjectResult.Image + "' alt= '" + myobj.ObjectResult.DeliveryBoyName + "'  style='height:100px;width:100px'/>");

                $('[name="Address"]').val(myobj.ObjectResult.Address);
                $('[name="EmailID"]').val(myobj.ObjectResult.DeliveryBoyEmailID);
                $('[name="Password"]').val(myobj.ObjectResult.Password);
                if (myobj.ObjectResult.IsActive)
                    $('[name="IsActive"]').val('true');
                else
                    $('[name="IsActive"]').val('false');
                var languages = new Array();
                if (myobj.ObjectResult.Languages != null) {
                    languages = myobj.ObjectResult.Languages.split(",");

                    for (var i = 0; i < languages.length; i++) {
                        if (languages[i]!="")
                        $("#" + languages[i]).prop("checked", true);
                    }
                }
                OpenCard();
                $('#btnupdate').show();
                $('#btnadd').hide();

            }
            else {
                DangerAlert(" ", "Failed to get data.");
            }
        });
    }

    function DeleteData(DeliveryBoyID) {
        var alert = confirm("Are you sure want to Delete");
        if (alert) {
            /**/
            $.post("@Url.Action("DeleteDeliveryBoy", "DeliveryBoy")", { DeliveryBoyID: DeliveryBoyID }, function (data) {
            /**/
            var myobj = JSON.parse(data);
            if (myobj.StatusCode == 200) {
                /**/
                SuccessAlert("@ViewBag.Title", "Deleted Successfully.");
        /**/
        BindTableData();
    }
    else
        /**/
        WarningAlert("@ViewBag.Title", myobj.Message);
    /**/
});
}
}
function ClearFields() {
$('[name="HDID"]').val(null);
$('[name="Name"]').val(null);
$('[name="EmailID"]').val(null);
$('[name="MobileNo"]').val(null);
$('[name="MobileNumber"]').val(null);
$('[name="AltMobileNumber"]').val(null);
$('[name="Address"]').val(null);
$('[name="Password"]').val(null);
$('[name="LicenseNumber"]').val(null);
        $('[name="VehicleNumber"]').val(null);
    $('[name="Image"]').val(null);

    $('#DeliveryBoyImage').html("");




$('.error').html("");
$('[name="IsActive"]').val('true');
$('#btnupdate').hide();
        $('#btnadd').show();
        $(".chk").prop("checked", false);
}

function BindTableData() {

/**/
$.get("@Url.Action("GetAllDeliveryBoyList", "DeliveryBoy")", function (data) {
            /**/
            var myObject = JSON.parse(data);
            var TableDate = [];
            for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(myObject[i].DeliveryBoyName);
                row.push("<a href=mailto:" + myObject[i].DeliveryBoyEmailID + ">" + myObject[i].DeliveryBoyEmailID + "</a>");
                row.push("<a href=tel:" + myObject[i].DeliveryBoyMobileNumber + ">" + myObject[i].DeliveryBoyMobileNumber + "</a>");
                row.push(myObject[i].Languages);
                row.push(myObject[i].Total_Pickup);
                row.push(myObject[i].Open_Pickup);
                row.push(myObject[i].Total_Delivery);
                row.push(myObject[i].Open_Delivery);
                if (myObject[i].IsActive)
                    row.push("<span class='badge bg-success float-right'>Active</span>");
                else
                    row.push("<span class='badge bg-danger float-right'>InActive</span>");

                row.push('<button type="button" class="btn btn-info btn-sm edit" onclick="GetData(' + myObject[i].DeliveryBoyID + ')">Edit</button>');
               //row.push('<button type="button" class="btn btn-danger btn-sm delete" onclick="DeleteData(' + myObject[i].DeliveryBoyID + ')">Delete</button>');
                TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "Name" },
                    { title: "EmailID" },
                    { title: "Mobile Number" },
                    { title: "Languages Known" },
                    { title: "Total Pickup" },
                    { title: "Open Pickup" },
                    { title: "Total Delivery" },
                    { title: "Open Delivery" },
                    { title: "IsActive " },
                    //{ title: " " },
                    { title: " " }


                ]
            });
            hideshowbuttons();
            var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
            $('.buttons-html5').addClass('btn btn-default btn-sm');
        });
    }

    </script>

</section>