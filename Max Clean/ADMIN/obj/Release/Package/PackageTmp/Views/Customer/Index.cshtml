
@{
    ViewBag.Title = "Customer";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Dashboard/Welcome">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formcustomer">
            <div class="card card-info" id="carddiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">ADD @ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Customer Name<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="CustomerName" maxlength="100" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>EmailID<span style="color:red"></span></label>
                                <input class="form-control" type="text" name="EmailID" maxlength="100" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Mobile Number<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="MobileNumber" maxlength="10" onkeypress="return IsNumeric(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>AltMobile Number</label>
                                <input class="form-control" type="text" name="AltMobileNumber" maxlength="10" onkeypress="return IsNumeric(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Password<span style="color:red">*</span></label>
                                <input class="form-control" type="password" name="Password" maxlength="10" onkeypress="return IsNumericorAlphabets(event)">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Address<span style="color:red">*</span></label>
                                <textarea class="form-control" type="text" name="Address" maxlength="700" onkeypress="return NotanHTML(event)"></textarea>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Status<span style="color:red">*</span></label>
                                <select class="form-control" name="IsActive">
                                    <option value="true">Active</option>
                                    <option value="false">InActive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" id="btnadd">Add @ViewBag.Title</button>
                    <button type="button" class="btn btn-warning" id="btnupdate">Update @ViewBag.Title</button>
                    <button type="button" class="btn btn-danger" onclick="ClearFields()" id="btnreset">Cancel</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped" style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>


        var tableId = "tbl";

        $('#formcustomer').validate({
            rules: {
                CustomerName: {
                    required: true,
                },
                EmailID: { 
                    email: true,
                    required: false,
                },
                MobileNumber: {
                    digits: true,
                    minlength: 10,
                    maxlength: 15,
                    required: true,
                },
                AltMobileNumber: {
                    digits: true,
                    minlength: 10,
                    maxlength: 15,
                    required: false,
                },
                Password: {
                    required: true,
                },
                Address: {
                    required: true,},

            }
        });

         var form = $("#formcustomer");
        form.validate();

        $(document).ready(function () {
            BindTableData();
            $('#btnupdate').hide();
            $("#btnadd").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.CustomerName = $('[name="CustomerName"]').val();
                    myobj.EmailID = $('[name="EmailID"]').val();
                    myobj.MobileNumber = $('[name="MobileNumber"]').val();
                    myobj.Address = $('[name="Address"]').val();
                    myobj.AltMobileNumber = $('[name="AltMobileNumber"]').val();
                    myobj.Password = $('[name="Password"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    setTimeout(function () {
                        $.post("@Url.Action("AddCustomer", "Customer")", { ObjCustomer: JSON.stringify(myobj) }, function (data) {
                            var Res = JSON.parse(data);
                            if (Res.StatusCode == 200) {
                                BindTableData();
                                SuccessAlert("@ViewBag.Title", "Added Successfully.");
                                ClearFields();
                            }
                            else
                                WarningAlert("@ViewBag.Title", Res.Message);
                        })
                    },000);
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            });

            $("#btnupdate").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.CustomerId = $('[name="HDID"]').val();
                    myobj.CustomerName = $('[name="CustomerName"]').val();
                    myobj.EmailID = $('[name="EmailID"]').val();
                    myobj.MobileNumber = $('[name="MobileNumber"]').val();
                    myobj.AltMobileNumber = $('[name="AltMobileNumber"]').val();
                    myobj.Address = $('[name="Address"]').val();
                    myobj.Password = $('[name="Password"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    setTimeout(function () {
                        $.post("@Url.Action("UpdateCustomer", "Customer")", { ObjCustomer: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {
                            SuccessAlert("@ViewBag.Title", "Updated Successfully.");
                            BindTableData();
                            ClearFields();
                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message );
                    })
                    }, 000);
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            })
        });

        function GetData(CustomerID) {
         
            $.get("@Url.Action("GetCustomer", "Customer")", { CustomerID: CustomerID }, function (data) {
                ClearFields();
                var myobj = JSON.parse(data);
                if (myobj.ObjectResult != null) {
                    $('[name="HDID"]').val(myobj.ObjectResult.CustomerID);
                    $('[name="CustomerName"]').val(myobj.ObjectResult.CustomerName);
                    $('[name="MobileNumber"]').val(myobj.ObjectResult.MobileNumber);
                    $('[name="AltMobileNumber"]').val(myobj.ObjectResult.AltMobileNumber);
                     $('[name="Address"]').val(myobj.ObjectResult.Address);
                    $('[name="EmailID"]').val(myobj.ObjectResult.EmailID);
                    $('[name="Password"]').val(myobj.ObjectResult.Password);
                    if (myobj.ObjectResult.IsActive)
                        $('[name="IsActive"]').val('true');
                    else
                        $('[name="IsActive"]').val('false');
                    OpenCard();
                    $('#btnupdate').show();
                    $('#btnadd').hide();

                }
                else {
                    DangerAlert(" ", "Failed to get data.");
                }
            });
        }

        function DeleteData(CustomerID) {
            var alert = confirm("Are you sure want to Delete");
            if (alert) {
                $.post("@Url.Action("DeleteCustomer", "Customer")", { CustomerID: CustomerID }, function (data) {
                    var myobj = JSON.parse(data);
                    if (myobj.StatusCode == 200) {
                        SuccessAlert("@ViewBag.Title", "Deleted Successfully.");
                        BindTableData();
                    }
                    else
                        WarningAlert("@ViewBag.Title", myobj.Message);
                });
            }
        }
        function ClearFields() {
            $('[name="HDID"]').val(null);
            $('[name="CustomerName"]').val(null);
            $('[name="EmailID"]').val(null);
            $('[name="MobileNo"]').val(null);
            $('[name="MobileNumber"]').val(null);
            $('[name="AltMobileNumber"]').val(null);
            $('[name="Address"]').val(null);
            $('[name="Password"]').val(null);
            $('.error').html("");
            $('[name="IsActive"]').val('true');
            $('#btnupdate').hide();
            $('#btnadd').show();
        }

        function BindTableData() {

            $.get("@Url.Action("GetCustomerList", "Customer")", function (data) {
                var myObject = JSON.parse(data);
                var TableDate = [];
                for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(myObject[i].CustomerName);
                row.push("<a href=mailto:" + myObject[i].EmailID + ">" + myObject[i].EmailID + "</a>");
                row.push("<a href=tel:" + myObject[i].MobileNumber + ">" + myObject[i].MobileNumber + "</a>");
                    row.push("<a href=tel:" + myObject[i].AltMobileNumber + ">" + myObject[i].AltMobileNumber + "</a>");
                    row.push(myObject[i].CustomerRewardPoints);
                    row.push(myObject[i].Total_Cust_Orders);
                    row.push(myObject[i].Closed_Cust_Orders);
                    row.push(myObject[i].Open_Cust_Orders);
                //if (myObject[i].IsActive)
                   // row.push("<span class='badge bg-success float-right'>Active</span>");
               // else
                  //  row.push("<span class='badge bg-danger float-right'>InActive</span>");
                    if (isAddEnabled)
                        row.push('<button type="button" class="btn btn-info btn-sm edit" onclick="GetData(' + myObject[i].CustomerID + ')">Edit</button>');
                    else
                        row.push('');
                //row.push('<button type="button" class="btn btn-danger btn-sm delete" onclick="DeleteData(' + myObject[i].CustomerID + ')">Delete</button>');
                TableDate.push(row);
                }
                $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                responsive: true,
                columns: [
                    { title: "Customer Name" },
                    { title: "EmailID" },
                    { title: "Mobile Number" },
                    { title: "Alt MobileNumber" },
                    { title: "Customer Reward Points" },
                    { title: "Total Orders" },
                    { title: "Closed Orders" },
                    { title: "Open Orders" },
                   // { title: "IsActive " },
                    //{ title: " " },
                    { title: " " }
                 
                    
                ]
                });
                hideshowbuttons();
                var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
         });
        }

    </script>

</section>