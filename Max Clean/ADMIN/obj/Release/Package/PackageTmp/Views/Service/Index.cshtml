
@{
    ViewBag.Title = "Service";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark">@ViewBag.Title</h1>
            </div><!-- /.col -->
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Dashboard/Welcome">Home</a></li>
                    <li class="breadcrumb-item active">@ViewBag.Title</li>
                </ol>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<section class="content">
    <div class="container-fluid">
        <form id="formservice">
            <div class="card card-info" id="carddiv">
                <div class="card-header" data-widget="collapse" style="cursor:pointer">
                    <h3 class="card-title">ADD @ViewBag.Title</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool"><i class="fa"></i></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Service Name<span style="color:red">*</span></label>
                                <input class="form-control" type="text" name="ServiceName" maxlength="100" onkeypress="return NotanHTML(event)">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="CategoryIcon">Service Image<span style="color:red">(< 2MB)</span></label>
                                <input class="form-control" type="file" accept="image/*" name="Image">
                            </div>
                        </div>
                        @*<div class="col-md-3">
                                <div class="form-group">
                                    <label for="CategoryBanner">Category Banner <span style="color:red">(< 2MB)</span></label>
                                    <input class="form-control" type="file" name="CategoryBanner">
                                </div>
                            </div>*@
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Display Order</label>
                                <input class="form-control" type="text" name="DisplayOrder" maxlength="3" onkeypress="return IsNumeric(event)">
                            </div>
                        </div>


                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Description</label>
                                <textarea class="form-control" type="text" name="Description" onkeypress="return NotanHTML(event)"></textarea>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Status<span style="color:red">*</span></label>
                                <select class="form-control" name="IsActive">
                                    <option value="true">Active</option>
                                    <option value="false">InActive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="button" class="btn btn-success" id="btnadd">Add @ViewBag.Title</button>
                    <button type="button" class="btn btn-warning" id="btnupdate">Update @ViewBag.Title</button>
                    <button type="button" class="btn btn-danger" id="btnreset" onclick="ClearFields()">Cancel</button>
                    <input type="hidden" name="HDID" />
                </div>
            </div>
        </form>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@ViewBag.Title List</h3>
        </div>
        <!-- /.card-header -->
        <div class="card-body">
            <div id="buttons"></div>
            <table id="tbl" class="table table-bordered table-striped " style="width:100%"></table>
        </div>
        <!-- /.card-body -->
    </div>
    <script src="~/CustomFiles/plugins/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.16.0/jquery.validate.js"></script>
    <script src="https://cdn.jsdelivr.net/jquery.validation/1.16.0/additional-methods.min.js"></script>
    <script src="~/CustomFiles/js/Common_js.js"></script>
    <script>

           var tableId = "tbl";

        $('#formservice').validate({
            rules: {
                ServiceName: {
                    required: true,
                },
                Image: {
                    extension: "jpg,jpeg,png",
                    filesize: 2097152,
                    required: false,
                },
                //CategoryBanner: {
                //    extension: "jpg,jpeg,png",
                //    filesize: 2097152,
                //    required: false,
                //},
                DisplayOrder: {
                    required: false,
                },
                Description: {
                    required: false,
                },

            }
        });

        var form = $("#formservice");
        form.validate();

        $(document).ready(function () {
            BindTableData();
            $('#btnupdate').hide();
            $("#btnadd").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.ServiceName = $('[name="ServiceName"]').val();
                    if ($('[name="Image"]').val() != "") {
                        readFile($('[name="Image"]')[0].files[0], function (e) {
                            myobj.Image = e.target.result.replace("data:image/png;base64,", "");
                         });
                    }
                    //if ($('[name="CategoryBanner"]').val() != "") {
                    //     readFile($('[name="CategoryBanner"]')[0].files[0], function (e) {
                    //         myobj.CategoryBanner = e.target.result.replace("data:image/png;base64,", "");
                    //     });
                    //}
                    myobj.DisplayOrder = $('[name="DisplayOrder"]').val();
                    myobj.Description = $('[name="Description"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();

                    setTimeout(function () {
                        $.post("@Url.Action("AddService", "Service")", { ObjService: JSON.stringify(myobj) }, function (data) {
                            var Res = JSON.parse(data);
                            if (Res.StatusCode == 200) {
                                SuccessAlert("@ViewBag.Title", "Added Successfully.");
                                ClearFields();
                                BindTableData();
                            }
                            else
                                WarningAlert("@ViewBag.Title", Res.Message);
                        })
                    },2000);
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            });



            $("#btnupdate").click(function () {
                if (form.valid()) {
                    var myobj = new Object();
                    myobj.ServiceID = $('[name="HDID"]').val();
                    myobj.ServiceName = $('[name="ServiceName"]').val();
                    if ($('[name="Image"]').val() != "") {
                        readFile($('[name="Image"]')[0].files[0], function (e) {
                            myobj.Image = e.target.result.replace("data:image/png;base64,", "");
                        });
                    }
                    //if ($('[name="CategoryBanner"]').val() != "") {
                    //    readFile($('[name="CategoryBanner"]')[0].files[0], function (e) {
                    //        myobj.CategoryBanner = e.target.result.replace("data:image/png;base64,", "");
                    //    });
                    //}
                    myobj.DisplayOrder = $('[name="DisplayOrder"]').val();
                    myobj.Description = $('[name="Description"]').val();
                    myobj.IsActive = $('[name="IsActive"]').val();
                    setTimeout(function () {
                        $.post("@Url.Action("UpdateService", "Service")", { ObjService: JSON.stringify(myobj) }, function (data) {
                        var Res = JSON.parse(data);
                        if (Res.StatusCode == 200) {
                            SuccessAlert("@ViewBag.Title", "Updated Successfully.");
                            ClearFields();
                            BindTableData();
                        }
                        else
                            WarningAlert("@ViewBag.Title", Res.Message );
                    })
                    }, 2000);
                }
                else {
                    DangerAlert(" ", "Recheck the fields.");
                }
            })
        });

        function GetData(ServiceID) {
            $.get("@Url.Action("GetService", "Service")", { ServiceID: ServiceID }, function (data) {
                ClearFields();
                var myobj = JSON.parse(data);
                if (myobj.ObjectResult != null) {
                    $('[name="HDID"]').val(myobj.ObjectResult.ServiceID);
                    $('[name="ServiceName"]').val(myobj.ObjectResult.ServiceName);
                    $('[name="DisplayOrder"]').val(myobj.ObjectResult.DisplayOrder);
                    $('[name="Description"]').val(myobj.ObjectResult.Description);
                    if (myobj.ObjectResult.IsActive)
                        $('[name="IsActive"]').val('true');
                    else
                        $('[name="IsActive"]').val('false');
                    OpenCard();
                    $('#btnupdate').show();
                    $('#btnadd').hide();

                }
                else {
                    DangerAlert(" ", "Failed to get data.");
                }
            });
        }

        function DeleteData(ServiceID) {
            var alert = confirm("Are you sure want to Delete");
            if (alert) {
                $.post("@Url.Action("DeleteService", "Service")", { ServiceID: ServiceID }, function (data) {
                    var myobj = JSON.parse(data);
                    if (myobj.StatusCode == 200) {
                        SuccessAlert("@ViewBag.Title", "Deleted Successfully.");
                        BindTableData();
                    }
                    else
                        WarningAlert("@ViewBag.Title", myobj.Message);
                });
            }
        }
        function ClearFields() {
            $('[name="HDID"]').val(null);
            $('[name="ServiceName"]').val(null);
            $('[name="Image"]').val(null);
            //$('[name="CategoryBanner"]').val(null);
            $('[name="DisplayOrder"]').val(null);
            $('[name="Description"]').val(null);
            $('[name="IsActive"]').val('true');
            $('.error').html("");
            $('#btnupdate').hide();
            $('#btnadd').show();
        }

        function BindTableData() {
            $.get("@Url.Action("GetServiceList", "Service")", function (data) {
                var myObject = JSON.parse(data);
            var TableDate = [];
            for (var i = 0; i < myObject.length; i++) {
                var row = [];
                row.push(myObject[i].ServiceName);
                row.push("<img src='" + myObject[i].Image + "' style='height:100px;width:100px' alt='" + myObject[i].ServiceName + " Icon' />");
                //row.push("<img src='" + myObject[i].CategoryBanner + "' style='height:100px;width:100px' alt='" + myObject[i].CategoryName + " Banner' />");
                row.push(myObject[i].DisplayOrder);
               
                if (myObject[i].IsActive)
                    row.push("<span class='badge bg-success float-right'>Active</span>");
                else
                    row.push("<span class='badge bg-danger float-right'>InActive</span>");

                row.push('<button type="button" class="btn btn-info btn-sm edit" onclick="GetData(' + myObject[i].ServiceID + ')">Edit</button>');
                row.push('<button type="button" class="btn btn-danger btn-sm delete" onclick="DeleteData(' + myObject[i].ServiceID + ')">Delete</button>');
                TableDate.push(row);
            }
            $('#' + tableId).DataTable({
                destroy: true,
                data: TableDate,
                scrollX: true,
                columns: [
                    { title: "Service Name" },
                    { title: "Icon" },
                   
                    { title: "Display Order" },
                    { title: "Status " },
                    { title: " " },
                    { title: " " },
                ]
            });
            hideshowbuttons();
                var buttons = new $.fn.dataTable.Buttons($('#' + tableId).DataTable(), {
                buttons: [
                    'copyHtml5',
                    'excelHtml5',
                    'csvHtml5',
                    'pdfHtml5'

                ]
            }).container().appendTo($('#buttons'));
                $('.buttons-html5').addClass('btn btn-default btn-sm');
         });
        }

    </script>

</section>
