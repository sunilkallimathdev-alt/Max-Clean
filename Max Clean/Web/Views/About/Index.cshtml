
@{
    ViewBag.Title = "Index";
}

<section>
    <div class="gp ls-gp">
        <div class="fxd-bg" style="background: url(../images/parallax2.jpg);"></div>
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-sm-12 col-lg-12">
                    <div class="pg-tl txt-cntr">
                        <h1 itemprop="headline">About Us</h1>
                        <ul class="breadcrumbs">
                            <li><a href="#" title="" itemprop="url">Optimize</a></li>
                            <li class="active">About Us</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="gp">
        <div class="container">
            <div class="row">
                <div class="col-md-12 col-sm-12 col-lg-12">
                    <div class="shrt-stry txt-cntr">
                        <h2 itemprop="headline">Short Story About Our Company</h2>
                        <p itemprop="description">Company laundry is a premium laundry service company based in Bangalore. Backed by the team which has more than two decades of experience, Company has been serving the client for the past 20+years.
Our Two plants are fully equipped with the most modern machinery backed by a fully trained team of people who are committed to handle your laundry with utmost care. Our own plants are spread across 20,000 square feet equipped to handle 35,000 pieces of laundry every day.
The Expertise backed by the experience is what makes MaxClean an outstanding service provider in the industry.
With the experience of more than two decades, we can understand your needs and demand more than anyone in this field. So leave your worries to us along with your laundry and we will ensure your trust in us is never broken.
</p>
                    </div>
                    <div class="nd-gal">
                        <div class="row mrgd10">
                            <div class="col-md-4 col-sm-6 col-lg-4">
                                <img style="width:auto;" class="rd10" src="~/images/resource/MC-OPL.jpg" alt="" itemprop="image" />
                            </div>
                            <div class="col-md-4 col-sm-6 col-lg-4">
                                <img style="width:auto;" class="rd10" src="~/images/resource/MC-Retail.jpg" alt="" itemprop="image" />
                            </div>
                            <div class="col-md-4 col-sm-6 col-lg-4">
                                <img style="width:auto;" class="rd10" src="~/images/resource/Ironing-Plant.jpg" alt="" itemprop="image" />
                            </div>
                        </div>
                    </div>

                    <div class="rmv-ext2">

                        <h3 style="text-align:center;">FAQ</h3>
                        <br />

                        <div class="row">
                            <div class="col-md-6 col-sm-6 col-lg-4">
                                <div class="serv-bx">
                                    <i class="rd50"><img src="~/images/resource/serv-icn5.png" alt="" itemprop="image" /></i>
                                    <div class="serv-inf">
                                        <h4 itemprop="headline">1. What should I have ready for the first driver collection?</h4>
                                        <p itemprop="description">Just your clothes – your MaxClean Experts will bring a MaxClean bag to place your loose clothes in, keeping them all together.
For Dry Clean, Tumble Dry & Steam Press orders your MaxClean Expert will leave you with a reusable bag upon delivery – for all those future orders.
</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 col-lg-4">
                                <div class="serv-bx">
                                    <i class="rd50"><img src="~/images/resource/serv-icn5.png" alt="" itemprop="image" /></i>
                                    <div class="serv-inf">
                                        <h4 itemprop="headline">2. What regions and suburbs do you cover?</h4>
                                        <p itemprop="description">The quickest way to find out if we cover your area is, enter your postcode at www.maxcleanlaundry.in to get the latest information and pricing</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 col-lg-4">
                                <div class="serv-bx">
                                    <i class="rd50"><img src="~/images/resource/serv-icn5.png" alt="" itemprop="image" /></i>
                                    <div class="serv-inf">
                                        <h4 itemprop="headline">3. How long does the cleaning take?</h4>
                                        <p itemprop="description">We aim to collect, clean and deliver your laundry all within 72 hours for regular order and 48 hours for express order. However we can get busy so select an available delivery time that suits you and we will return your order to you then.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 col-lg-4">
                                <div class="serv-bx">
                                    <i class="rd50"><img src="~/images/resource/serv-icn5.png" alt="" itemprop="image" /></i>
                                    <div class="serv-inf">
                                        <h4 itemprop="headline">4. Can I add extra items to my order when you collect?</h4>
                                        <p itemprop="description">Yes you can – just give any extra items you have to your MaxClean Expert. Extra items will be input into our system right away.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 col-sm-6 col-lg-4">
                                <div class="serv-bx">
                                    <i class="rd50"><img src="~/images/resource/serv-icn5.png" alt="" itemprop="image" /></i>
                                    <div class="serv-inf">
                                        <h4 itemprop="headline">5. When can you collect my order?</h4>
                                        <p itemprop="description">Typically we are available all week from 8am to 10pm although collection and delivery times can vary subject to availability.</p>
                                    </div>
                                </div>
                            </div>
                            @*<div class="col-md-6 col-sm-6 col-lg-4">
                                <div class="serv-bx">
                                    <i class="rd50"><img src="~/images/resource/serv-icn5.png" alt="" itemprop="image" /></i>
                                    <div class="serv-inf">
                                        <h4 itemprop="headline"><a href="service-detail.html" title="" itemprop="url">Local Search Strategy</a></h4>
                                        <p itemprop="description">The complex of measures to promote the site and opportunity to be profitable over the years.</p>
                                    </div>
                                </div>
                            </div>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@*For loading component*@
<script src="~/CustomJS/OrderControles.js"></script>

@*Model1*@
<div class="container">
    <div class="modal fade" id="loadMe" tabindex="-1" role="dialog" aria-labelledby="loadMeLabel" style="padding-top:120px;">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-body text-center">
                    <div class="loader"></div>
                    <div clas="loader-txt">
                        <p id="SuccessFailure">Please wait while we check our service availability at your location. <br><br><small>Thanks for your patience.</small></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*Model2*@.
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.3/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.min.js"></script>

<div class="modal model1" id="loadMe1">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="container mt-3" style="padding:15px;">
                <br>
                <!-- Nav tabs -->
                <ul class="nav nav-tabs">
                    <li class="nav-item">
                        <a class="nav-link active" data-toggle="tab" href="#home">Express  Order</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="tab" href="#menu1">Standard Order</a>
                    </li>
                </ul>

                <!-- Tab panes -->
                <div class="tab-content">
                    <div id="home" class="container tab-pane active">
                        <br>
                        <p>
                            You could order for quick delivery within 3 Days.

                            However you need to Place an order before 10:00 PM for next day or before 3 days delivery.

                            50% will be charged from express Delivery.

                            Order confirmation decision will be with Management team.

                            You can make offlline orders

                            Pick  up and Drop facility availble
                        </p>

                        <button type="button" class="btn btn-info" onclick="TakeUserToOrderPage()" data-dismiss="modal">Continue to Order</button><br /><br />


                    </div>
                    <div id="menu1" class="container tab-pane fade">
                        <br>
                        <p>
                            You could order for Standard delivery which takes 3 Days from date of Order at standad Price

                            Order confirmation decision will be with Management team.

                            You can make offline orders

                            Pick  up and Drop facility availble
                        </p>

                        <button type="button" class="btn btn-info" onclick="TakeUserToOrderPage()" data-dismiss="modal">Continue to Order</button><br /><br />

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>





