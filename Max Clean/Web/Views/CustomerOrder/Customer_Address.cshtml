<script src="~/CustomJS/OrderControles.js" type="text/javascript"></script>

<script>
    var oldBalance;
    var grandTotalPrice;
    var isExpress;
    var expectedDelDate;
    var PickUpDate;
    var pickupAddress;
    var deliveryAddress;

    $(document).ready(function () {
    
        Getlatlon();
        $('#exampleInputMobile1').val("@(((Customer_Model)Session["CurrentUser"]).MobileNumber)");
        $('#exampleInputEmail1').val("@(((Customer_Model)Session["CurrentUser"]).CustomerName)");

      
      //AutoFill Dates    
        //Initial Values
        var today = new Date();
        document.getElementById('Pickupdate').value = today.getFullYear() + "-" + ("00" + (parseInt(today.getMonth())+ 1)).slice(-2) + "-" + ("00" + today.getDay()).slice(-2);

        today.setDate(today.getDate() + 4);
        document.getElementById('date').value = today.getFullYear() + "-" + ("00" + (parseInt(today.getMonth()) + 1)).slice(-2) + "-" + ("00" + today.getDate()).slice(-2);

        isExpress = false;
        $('#OrderType').html(" Order Type: Normal Delivery.");
        //Initial set ups end (wrt date)


        $('#TakeFromBillingAddress').change(function () {
            if ($(this).is(":checked")) {

                $('#exampleInputEmail2').val($('#exampleInputEmail1').val());
                $('#exampleInputMobile2').val($('#exampleInputMobile1').val());
                $('#exampleTextarea2').val($('#exampleTextarea1').val());

            }

        });

        //Restrict the entries to numbers
        $("#exampleInputMobile1").keydown(function (e) {
            // Allow: backspace, delete, tab, escape, enter and .
            if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
                // Allow: Ctrl+A, Command+A
                (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                // Allow: home, end, left, right, down, up
                (e.keyCode >= 35 && e.keyCode <= 40)) {
                // let it happen, don't do anything

                return;
            }
            // Ensure that it is a number and stop the keypress
            if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                e.preventDefault();
            }
        });

        $("#exampleInputMobile2").keydown(function (e) {
            // Allow: backspace, delete, tab, escape, enter and .
            if ($.inArray(e.keyCode, [46, 8, 9, 27, 13, 110]) !== -1 ||
                // Allow: Ctrl+A, Command+A
                (e.keyCode === 65 && (e.ctrlKey === true || e.metaKey === true)) ||
                // Allow: home, end, left, right, down, up
                (e.keyCode >= 35 && e.keyCode <= 40)) {
                // let it happen, don't do anything

                return;
            }
            // Ensure that it is a number and stop the keypress
            if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
                e.preventDefault();
            }
        });
    });

    function UDM() {
        alert("This functionality is under development.");
    }

    function CalculateTotal() {
        var customerRewards = 0;
       
                            oldBalance   = @(((Customer_Model)Session["CurrentUser"]).OldBalance);
                            if (oldBalance == null || oldBalance == undefined) {
                                oldBalance = 0;
                            }
                            grandTotalPrice = parseFloat(localStorage.getItem("CartTotal"));

                            if (isExpress == true){
                                ExpressCharges = grandTotalPrice / 2;
                                grandTotalPrice = grandTotalPrice + ExpressCharges;
                            } else {
                                ExpressCharges = 0;
                            }

                            grandTotalPrice = grandTotalPrice + oldBalance;
                             
                            return true;
    }

    function validate() {
        var flag = true;

        if (!$('#date').val()) {
            $("#Lbldate").show();
            flag = false;
        } else {
            $('#Lbldate').hide();
        }

        if (!$('#Pickupdate').val()) {
            $("#LblPickupdate").show();
            flag = false;
        } else {
            $('#LblPickupdate').hide();
        }

        //Time
        if (!$('#Deltime').val()) {
            $("#Lbldate").show();
            flag = false;
        } else {
            $('#Lbldate').hide();
        }
        if (!$('#Pickuptime').val()) {
            $("#LblPickupdate").show();
            flag = false;
        } else {
            $('#LblPickupdate').hide();
        }

        if (flag) {
            var date1 = document.querySelector('input[id="Pickupdate"]');
           
            var date = document.querySelector('input[id="date"]');

            expectedDelDate = new Date(date.value + "T" + $('#Deltime').val());
            PickUpDate = new Date(date1.value + "T" + $('#Pickuptime').val());
                     
        }
      

        var today = new Date();

        if (expectedDelDate <= today) {
            $("#Lbl2date").show();
            flag = false;
        } else {
            $('#Lbl2date').hide();
        }

        if (expectedDelDate < PickUpDate ) {
            $("#Lbl2Pickupdate").show();
            flag = false;
        } else {
            $('#Lbl2Pickupdate').hide();
        }

        if (PickUpDate < today) {
            $("#Lbl3Pickupdate").show();
            flag = false;
        } else {
            $('#Lbl3Pickupdate').hide();
        }

        if (!$('#exampleInputEmail1').val()) {
            $("#LblexampleInputEmail1").show();
            flag = false;
        } else {
            $('#LblexampleInputEmail1').hide();
        }



        if (!$('#exampleInputMobile1').val()) {
            $("#LblexampleInputMobile1").show();
            flag = false;
        } else {
            $('#LblexampleInputMobile1').hide();
        }

        if (!$('#exampleTextarea1').val()) {
            $("#LblexampleTextarea1").show();
            flag = false;
        } else {
            $('#LblexampleTextarea1').hide();
        }


        if (!$('#exampleInputEmail2').val()) {
            $("#LblexampleInputEmail2").show();
            flag = false;
        } else {
            $('#LblexampleInputEmail2').hide();
        }

        if (!$('#exampleInputMobile2').val()) {
            $("#LblexampleInputMobile2").show();
            flag = false;
        } else {
            $('#LblexampleInputMobile2').hide();
        }

        if (!$('#exampleTextarea2').val()) {
            $("#LblexampleTextarea2").show();
            flag = false;
        } else {
            $('#LblexampleTextarea2').hide();
        }

        if (flag == true) {
            pickupAddress = $('#exampleInputEmail1').val() + " , " + $('#exampleInputMobile1').val() + " , " + $('#exampleTextarea1').val();
            deliveryAddress = $('#exampleInputEmail2').val() + " , " + $('#exampleInputMobile2').val() + " , " + $('#exampleTextarea2').val();
        }
        return flag;
    }


    function OpenLoader() {
        $("#WaitforOP").modal({
            backdrop: "static", //remove ability to close modal with click
            keyboard: false, //remove option to close with keyboard
            show: true //Display loader!
        });

    }

    function CloseLoader() {
        $("#WaitforOP").modal("hide");
    }




    function CheckTypeOfOrder() {
        var date = document.querySelector('input[id="date"]');
        var Datechoosen = new Date(date.value);
        var today = new Date();
        today.setDate(today.getDate() + 3);
        if (today > Datechoosen) {
            isExpress = true;

            $('#OrderType').html(" Order Type: Express Delivery (Extra charges will be applied, currently around 50% of the total).");
        } else {
            isExpress = false;
            $('#OrderType').html(" Order Type: Normal Delivery.");
        }
    }

    function PlaceOrder() {
      
            if ("@Session["CurrentUser"]" != "") {
                if (validate()) {
                    var cart = JSON.parse(localStorage.getItem("Cart"));
                    if (cart != null) {
                        CalculateTotal();
                        if (NearbyLoc.length > 0) {
                            if (confirm("Your grand total will be around Rs. " + grandTotalPrice + ". Are you sure you want to place the order? ")) {
                                OpenLoader();
                                var itemList = [];
                                for (i = 0; i < cart.length; i++) {

                                    var itemsInCart = {
                                        "ServiceID": cart[i].Service_ID,
                                        "CategoryID": cart[i].CategoryID,
                                        "ProductID": cart[i].ProductId,
                                        "Price": cart[i].SubTotal,
                                        "UnitPrice": cart[i].Price,
                                        "Quantity": cart[i].Quantity
                                    }
                                    itemList[i] = itemsInCart;

                                }


                                var data = {
                                    "CustomerID": @(((Customer_Model)Session["CurrentUser"]).CustomerID),
                                    "StoreID": NearbyLoc[0].StoreID,
                                    "ExpectingDeliveryDate": expectedDelDate,
                                    "GrandTotal": grandTotalPrice,
                                    "PickupDate": PickUpDate,
                                    "PurchaseOrderDetail": itemList,
                                    "PickupAddress": pickupAddress,
                                    "DeliveryAddress": deliveryAddress,
                                    "CustomerName": "@(((Customer_Model)Session["CurrentUser"]).CustomerName)",
                                    "CustomerMobile": @(((Customer_Model)Session["CurrentUser"]).MobileNumber),
                                    "CustomerEmail": "@(((Customer_Model)Session["CurrentUser"]).EmailID)",
                                    "IsExpressDelivery": isExpress,
                                    "IsOutletOrder": false,
                                    "OldBalanceApplied": oldBalance,
                                    "ExpressChargeApplied": ExpressCharges,
                                    "ExtraPercent": 0,
                                    "ExtraPrice": 0,
                                    "ActualDeliveryDate": expectedDelDate,
                                    "RewardPointsApplied":0
                                };

                                var parameters = JSON.stringify(data);
                                $.ajax({
                                    type: "POST",
                                    url: '/CustomerOrder/PlaceOrder',
                                    data: parameters,
                                    contentType: "application/json; charset=utf-8",
                                    dataType: "json",
                                    success: function (response) {
                                        if (response.StatusCode == 200) {
                                            clearCart();
                                            window.location.pathname = "CustomerOrder/OrderStatusDisplay/" + response.Result;
                                            CloseLoader();
                                        } else {
                                            window.location.pathname = "CustomerOrder/OrderStatusDisplay/0";
                                            CloseLoader();
                                        }1
                                    },
                                    error: function (e) {
                                        console.log(JSON.stringify(e));
                                        $('#LoadMessage').html("There was an error requesting your process. Please wait and try again later.");
                                        setTimeout(function () {
                                            CloseLoader();
                                        }, 4000);

                                    }
                                });
                            }
                            } else {
                                alert("Sorry We are not serving at your location.");
                            }


                    } else {
                        alert("Your cart is empty. Please add items to cart and then proceed for placing order");
                    }
                }
            } else {
                alert("Your login session is expired. Please login before proceeding.");
            }

    }
</script>

