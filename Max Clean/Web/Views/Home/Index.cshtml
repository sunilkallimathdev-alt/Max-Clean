<section class="howit-work main-block center-block" id="howitworks">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h2>How it <span>works</span></h2>
                <h6>We’ve made all the hardwork for making it simple for you. Here’s how it works</h6>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="howit-wrap">
                    <span>
                        <img src="~/images/Order.png" style="max-width: 90px;max-height: 90px;"/>
                    </span>
                    <h4>You Order</h4>
                    <p>Click the book a cleaning button to make a booking on your preffered date and time</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="howit-wrap">
                    <span>
                        <img src="~/images/Collect.png" style="max-width: 90px;max-height: 90px;" />
                    </span>
                    <h4>We Collect</h4>
                    <p>Book your collection time online </p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="howit-wrap">
                    <span>
                        <img src="~/images/Clean.png" style="max-width: 90px;max-height: 90px;" />
                    </span>
                    <h4>We Clean</h4>
                    <p>Upon collection just have your clothes ready - we'll bring a bag</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="howit-wrap">
                    <span>
                        <img src="~/images/Deliver.png" style="max-width: 90px;max-height: 90px;" />
                    </span>
                    <h4>We Deliver</h4>
                    <p>Select your delivery time and we'll deliver to your door - too easy!</p>
                </div>
            </div>
        </div>
    </div>
</section>

