<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.3/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.min.js"></script>

<div class="modal model1" id="loadMe1">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="container mt-3" style="padding:15px;">
                <br>
                <!-- Nav tabs -->
                <ul class="nav nav-tabs">
                    <li class="nav-item">
                        <a class="nav-link active" data-toggle="tab" href="#home">Express  Order</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="tab" href="#menu1">Standard Order</a>
                    </li>
                </ul>

                <!-- Tab panes -->
                <div class="tab-content">
                    <div id="home" class="container tab-pane active">
                        <br>
                        <p>
                            You could order for quick delivery within 3 Days.

                            However you need to Place an order before 10:00 PM for next day or before 3 days delivery.

                            50% will be charged from express Delivery.

                            Order confirmation decision will be with Management team.

                            You can make offlline orders

                            Pick  up and Drop facility availble
                        </p>

                        <button type="button" class="btn btn-info" onclick="TakeUserToOrderPage()" data-dismiss="modal">Continue to Order</button><br /><br />


                    </div>
                    <div id="menu1" class="container tab-pane fade">
                        <br>
                        <p>
                            You could order for Standard delivery which takes 3 Days from date of Order at standad Price

                            Order confirmation decision will be with Management team.

                            You can make offline orders

                            Pick  up and Drop facility availble
                        </p>

                        <button type="button" class="btn btn-info" onclick="TakeUserToOrderPage()" data-dismiss="modal">Continue to Order</button><br /><br />

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

