@*Model1*@
<div class="container">
    <div class="modal fade" id="loadMe" tabindex="-1" role="dialog" aria-labelledby="loadMeLabel" style="padding-top:120px;">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <div class="modal-body text-center">    
                    <div class="loader"></div>
                    <div clas="loader-txt">
                        <p id="SuccessFailure">Please wait while we check our service availability at your location. <br><br><small>Thanks for your patience.</small></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

