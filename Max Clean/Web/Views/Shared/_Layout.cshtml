        function CartUpdate() {
            var cartTotalAmnt = localStorage.getItem("CartTotal") ;
            $('#CartItemCount').text("0");
            $('#TotalCartDD').text("0");
            var cart = JSON.parse(localStorage.getItem("Cart"));
            $('#TotalCartDD').html(cartTotalAmnt);
            //Update cart count
            var count = 0;
            if (cart == null || cart == undefined) {
                count = 0;
            } else {
                for (i = 0; i < cart.length; i++){
                    count = count + parseInt(cart[i].Quantity);
                }

            }


            //Update cart content
            $('#CartItemCount').text(count);
            $('#CartBodyDrpDwn').html("");
            if (cart != null && cart != undefined) {
                for (i = 0; i < cart.length; i++) {
                    var response = '';
                    response = ' <div class="crt-prd-itm"><div class="crt-prd-inf"><h5 itemprop="headline"><a href="#" title="" itemprop="url">' + cart[i].ProductName + '</a></h5>';
                    response = response + '<span class="price">Rs. ' + cart[i].SubTotal + '</span><i style="color:white;">QTY: ' + cart[i].Quantity + '</i><a class="prd-rmv" href="#" title="" itemprop="url"><i class="fa fa-times"></i></a></div></div>';
                    $('#CartBodyDrpDwn').append(response);
                }
            }


            //Cart on responsive header of homepage (Mobile view)
            $('#CartDrpDwnRespHome').html("");
            $('#CartItemCountRespHome').text(count);
            $('#TotalCartDDRespHome').html(cartTotalAmnt);

            if (cart != null && cart != undefined) {
                for (i = 0; i < cart.length; i++) {
                    var response = '';
                    response = ' <div class="crt-prd-itm"><div class="crt-prd-inf"><h5 itemprop="headline"><a href="#" title="" itemprop="url">' + cart[i].ProductName + '</a></h5>';
                    response = response + '<span class="price">Rs. ' + cart[i].SubTotal + '</span><i style="color:white;">QTY: ' + cart[i].Quantity + '</i><a class="prd-rmv" href="#" title="" itemprop="url"><i class="fa fa-times"></i></a></div></div>';
                    $('#CartDrpDwnRespHome').append(response);
                }
            }

        }

