<?xml version="1.0" encoding="utf-8"?>
<!--
This file is used by the publish/package process of your Web project. You can customize the behavior of this process
by editing this MSBuild file. In order to learn more about this please visit https://go.microsoft.com/fwlink/?LinkID=208121. 
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <MSDeployServiceURL>maxcleanweb.myprelaunch.in</MSDeployServiceURL>
    <DeployIisAppPath>maxcleanweb.myprelaunch.in</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <UserName>maxcleanweb</UserName>
    <_SavePWD>False</_SavePWD>
    <PublishDatabaseSettings>
      <Objects xmlns="">
        <ObjectGroup Name="maxcleanEntities" Order="1" Enabled="False">
          <Destination Path="" />
          <Object Type="DbDacFx">
            <PreSource Path="server=(localdb)\MSSQLLocalDB;user id=maxcleandb;password=MMT@2018;persistsecurityinfo=True;allowzerodatetime=True;convertzerodatetime=True;database=maxcleanlocal" includeData="False" />
            <Source Path="$(IntermediateOutputPath)AutoScripts\maxcleanEntities_IncrementalSchemaOnly.dacpac" dacpacAction="Deploy" />
          </Object>
          <UpdateFrom Type="Web.Config">
            <Source MatchValue="metadata=res://*/DataAccess.maxCleanModel.csdl|res://*/DataAccess.maxCleanModel.ssdl|res://*/DataAccess.maxCleanModel.msl;provider=MySql.Data.MySqlClient;provider connection string=&quot;server=(localdb)\MSSQLLocalDB;user id=maxcleandb;password=MMT@2018;persistsecurityinfo=True;allowzerodatetime=True;convertzerodatetime=True;database=maxcleanlocal&quot;" MatchAttributes="$(UpdateFromConnectionStringAttributes)" />
          </UpdateFrom>
        </ObjectGroup>
      </Objects>
    </PublishDatabaseSettings>
  </PropertyGroup>
</Project>